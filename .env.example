# Copy this file to .env (local dev) and/or set these as environment
# variables in the Cloudflare Pages dashboard (production). Nothing here
# should ever be committed with a real value — .env is gitignored.
#
# Every integration below degrades gracefully when its variable is unset:
# the site still builds and looks correct, it just shows a "not connected
# yet" placeholder instead of the live embed/script. Fill in a value and
# redeploy (no code changes needed) once the real account exists.

# Google Analytics 4 Measurement ID (e.g. G-ABC1234XYZ).
# Leave unset to keep GA4 out of the page entirely (no script tag at all).
PUBLIC_GA4_MEASUREMENT_ID=

# Formspree form IDs — create one form per endpoint at formspree.io.
PUBLIC_FORMSPREE_CONTACT_ID=
PUBLIC_FORMSPREE_PARTNER_ID=

# Real email address shown on /contact/ as a fallback while the Formspree
# form above is unconfigured, so the page never leaves a visitor with no
# way to reach a person. Leave unset to hide the fallback line entirely.
PUBLIC_CONTACT_EMAIL=

# Full Zeffy embed URL for the donation form (e.g.
# https://www.zeffy.com/embed/donation-form/xxxxxxxx).
PUBLIC_ZEFFY_EMBED_URL=
