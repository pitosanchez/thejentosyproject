---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getLangFromUrl, useTranslations, alternateUrls } from "../i18n/utils";
import { hasTranslation } from "../i18n/pages";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = `${title} — The Jentosy Project`;
const ga4Id = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const alternates = alternateUrls(Astro.url);
// Only advertise the Spanish alternate once its twin actually exists.
const hasEs = lang === "es" || hasTranslation(Astro.url.pathname);
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL;
const reportHref = contactEmail
  ? `mailto:${contactEmail}?subject=${encodeURIComponent("Spanish translation error — " + Astro.url.pathname)}`
  : lang === "es"
    ? "/es/contact/"
    : "/contact/";

// Social share card (link previews in iMessage, Slack, WhatsApp, LinkedIn, X…).
// A 1200×630 image derived from the home hero — one per locale.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(lang === "es" ? "/og-image-es.jpg" : "/og-image.jpg", Astro.site).href;
const ogImageAlt =
  lang === "es"
    ? "The Jentosy Project — equidad en salud para comunidades desatendidas, empezando por el Bronx."
    : "The Jentosy Project — health equity for underserved communities, starting in the Bronx.";
const ogLocale = lang === "es" ? "es_US" : "en_US";

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: "The Jentosy Project",
  alternateName: "The Jentosy Project, Inc.",
  url: "https://jentosy.org",
  logo: "https://jentosy.org/favicon.svg",
  description:
    "The Jentosy Project is a 501(c)(3) public charity advancing kidney health equity for underserved communities through education on FSGS and APOL1-mediated kidney disease, starting in the Bronx.",
  email: "info@jentosy.org",
  sameAs: [
    "https://www.cbsnews.com/newyork/news/kidney-transplant-kidney-chain-robert-sanchez-elizabeth-antosy/",
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={alternates.en} />
    {hasEs && <link rel="alternate" hreflang="es" href={alternates.es} />}
    <link rel="alternate" hreflang="x-default" href={alternates.en} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:site_name" content="The Jentosy Project" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />
    {hasEs && <meta property="og:locale:alternate" content={lang === "es" ? "en_US" : "es_US"} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,500&family=Work+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    {ga4Id && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script is:inline define:vars={{ ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag("js", new Date());
          gtag("config", ga4Id);
        </script>
      </>
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">{t("a11y.skip")}</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    {lang === "es" && (
      <div class="mt-review-note">
        <div class="container">
          <span>{t("mt.reviewNote")}</span>
          <a href={reportHref}>{t("mt.reviewReport")}</a>
        </div>
      </div>
    )}
    <Footer />

    <script>
      // Scroll-reveal: elements with .reveal fade/rise into view once,
      // staggered via an optional --reveal-delay custom property set inline.
      //
      // Safety net: reading content must never depend on a scroll event
      // firing correctly to become visible (fast navigation, programmatic
      // scroll, or an observer edge case can all leave it stuck at
      // opacity:0 — a real bug, not hypothetical: found via a full-page
      // screenshot where content below the fold never revealed). A short
      // timeout force-reveals everything regardless of scroll state, so
      // the animation is strictly a bonus, never a gate.
      const revealables = document.querySelectorAll(".reveal, .timeline-item, .bar-fill, .hbar-fill");
      const revealAll = () => revealables.forEach((el) => el.classList.add("is-visible"));

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: "200px 0px -10% 0px" }
        );
        revealables.forEach((el) => observer.observe(el));
        window.setTimeout(revealAll, 2500);
      } else {
        revealAll();
      }

      // Count-up for stat numbers: [data-count="8"]
      const counters = document.querySelectorAll<HTMLElement>("[data-count]");
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const countedEls = new Set<HTMLElement>();

      const animateCount = (el: HTMLElement) => {
        if (countedEls.has(el)) return;
        countedEls.add(el);
        const target = Number(el.dataset.count);
        if (prefersReducedMotion || Number.isNaN(target)) {
          el.textContent = String(target);
          return;
        }
        const duration = 900;
        const start = performance.now();
        const tick = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = String(Math.round(eased * target));
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };

      if ("IntersectionObserver" in window && counters.length) {
        const countObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                animateCount(entry.target as HTMLElement);
                countObserver.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.6 }
        );
        counters.forEach((el) => countObserver.observe(el));

        // Same defensive pattern as .reveal above: a counter whose
        // IntersectionObserver entry never fires (fast navigation, an
        // observer edge case) must still end up showing its real number,
        // not stuck at "0" forever.
        window.setTimeout(() => {
          counters.forEach((el) => {
            if (!countedEls.has(el)) {
              const target = Number(el.dataset.count);
              el.textContent = String(Number.isNaN(target) ? el.textContent : target);
              countedEls.add(el);
            }
          });
        }, 2500);
      } else {
        counters.forEach((el) => {
          const target = Number(el.dataset.count);
          el.textContent = String(Number.isNaN(target) ? el.textContent : target);
        });
      }
    </script>

    <style is:global>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--ink);
        color: var(--ink-fg);
        padding: 12px 18px;
        z-index: 100;
        border-radius: 0 0 var(--radius-sm) 0;
      }

      .skip-link:focus {
        left: 0;
      }

      :focus-visible {
        outline: 2px solid var(--steel);
        outline-offset: 2px;
      }

      /* Shown only on /es/ pages: the Spanish copy is machine-drafted and
         under review. Removed once a bilingual review pass is done. */
      .mt-review-note {
        background: var(--ink-soft, #1d2a1e);
        border-top: 1px solid var(--ink-line, #33413a);
        color: var(--ink-fg-muted, #c9d3cb);
        font-size: 12.5px;
      }

      .mt-review-note .container {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 14px;
        align-items: baseline;
        padding-block: 10px;
      }

      .mt-review-note a {
        color: var(--ink-fg, #f3f5f2);
        font-weight: 700;
      }
    </style>
  </body>
</html>
