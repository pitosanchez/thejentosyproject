---
import { getLangFromUrl } from "../i18n/utils";

interface Props {
  items: { label: string; href: string }[];
}
const { items } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const labels = {
  en: { aria: "Jump to a section on this page", jump: "Jump to" },
  es: { aria: "Saltar a una sección de esta página", jump: "Saltar a" },
}[lang];
---

<nav class="quick-nav" aria-label={labels.aria}>
  <span class="quick-nav-label">{labels.jump}</span>
  <ul>
    {items.map((item) => (
      <li><a href={item.href}>{item.label}</a></li>
    ))}
  </ul>
</nav>

<style>
  .quick-nav {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-3);
    padding-block: var(--space-4);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  /* Centered once there's room for the full row to fit without
     overflowing — below this it stays left-aligned and scrollable, since
     centering a row that overflows its container hides its start behind
     a scroll position instead of showing it. */
  @media (min-width: 700px) {
    .quick-nav {
      justify-content: center;
    }
  }

  .quick-nav-label {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .quick-nav ul {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .quick-nav li {
    flex-shrink: 0;
  }

  .quick-nav a {
    display: inline-block;
    white-space: nowrap;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--steel);
    text-decoration: none;
    padding: 6px 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--card);
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }

  .quick-nav a:hover,
  .quick-nav a:focus-visible {
    background: var(--steel);
    color: var(--steel-ink);
    border-color: var(--steel);
  }

  /* The section currently in view — same gold as the nav's current item. */
  .quick-nav a[aria-current="true"] {
    background: var(--gold);
    color: var(--gold-ink);
    border-color: var(--gold);
  }
</style>

<script>
  // Scrollspy: mark the Jump-to link whose section is currently in view,
  // and keep it scrolled into view inside the bar on narrow screens.
  document.querySelectorAll<HTMLElement>(".quick-nav").forEach((nav) => {
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
    const targets = links
      .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      .filter((el): el is HTMLElement => !!el);
    if (!targets.length) return;

    const setActive = (id: string | null) => {
      links.forEach((a) => {
        const on = a.hash.slice(1) === id;
        if (on) {
          a.setAttribute("aria-current", "true");
          a.scrollIntoView({ block: "nearest", inline: "nearest" });
        } else {
          a.removeAttribute("aria-current");
        }
      });
    };

    const update = () => {
      // The active section is the last one whose top has passed under the
      // sticky nav + Jump-to bar.
      const line = 170;
      let current: string | null = null;
      for (const el of targets) {
        if (el.getBoundingClientRect().top - line <= 0) current = el.id;
      }
      setActive(current);
    };

    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      },
      { passive: true }
    );
    update();
  });
</script>
