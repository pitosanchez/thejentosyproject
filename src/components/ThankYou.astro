---
/**
 * Shared thank-you page body (contact, donate, partner — EN + ES).
 * Standard PageHero (the heading's last word set as the gold accent) plus
 * a "Where to next" block, so a confirmation is a doorway, not a dead end.
 */
import PageHero from "./PageHero.astro";
import NextSteps from "./ui/NextSteps.astro";
import { getLangFromUrl } from "../i18n/utils";

interface Props {
  title: string;
  heading: string;
  body: string;
}
const { heading, body } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const eyebrow = lang === "es" ? "Gracias" : "Thank you";
const words = heading.trim().split(/\s+/);
const accent = words.pop();
const head = words.join(" ");
---

<script is:inline>
  // Conversions fire on thank-you-page load, not via cross-iframe events.
  // No-ops until PUBLIC_GA4_MEASUREMENT_ID is set (see BaseLayout), since
  // gtag is only defined when GA4's script tag is actually injected.
  if (typeof gtag === "function") {
    gtag("event", "conversion");
  }
</script>

<PageHero eyebrow={eyebrow} heading={head} accent={accent} lede={body} />
<NextSteps />
