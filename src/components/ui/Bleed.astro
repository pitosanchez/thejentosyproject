---
/**
 * A full-bleed image "beat" between sections, with an optional serif
 * caption set over a soft dark fade. Gives long pages a breath.
 */
interface Props {
  src: string;
  alt: string;
  caption?: string;
  height?: string;
  position?: string;
}
const { src, alt, caption, height = "clamp(220px, 32vw, 440px)", position = "center" } = Astro.props;
---

<figure class="bleed reveal" style={`--bleed-h:${height}`}>
  <img src={src} alt={alt} loading="lazy" style={`object-position:${position}`} />
  {caption && (
    <figcaption>
      <span class="container bleed-cap">{caption}</span>
    </figcaption>
  )}
</figure>

<style>
  .bleed {
    position: relative;
    margin: 0;
    height: var(--bleed-h);
    overflow: hidden;
  }

  .bleed img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bleed figcaption {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--space-8) 0 var(--space-5);
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
  }

  .bleed-cap {
    display: block;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(24px, 3vw, 40px);
    color: #fff;
  }
</style>
