---
const navLinks = [
  { href: "/about/", label: "About" },
  { href: "/the-need/", label: "The Need" },
  { href: "/what-we-do/", label: "What We Do" },
];
const currentPath = Astro.url.pathname;
---

<header class="site-nav on-dark">
  <div class="container nav-row">
    <a href="/" class="wordmark">The Jentosy Project</a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="nav-menu" id="nav-toggle">
      <span class="visually-hidden">Toggle menu</span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>

    <nav id="nav-menu" class="nav-menu">
      <ul class="nav-links">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav-link"
              aria-current={currentPath.startsWith(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="nav-cta">
        <a href="/partner-with-us/" class="btn btn-steel-outline">Partner With Us</a>
        <a href="/donate/" class="btn btn-rust">Donate</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-4);
    gap: var(--space-5);
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 17px;
    text-decoration: none;
    color: var(--ink-fg);
    letter-spacing: -0.01em;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav-links {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--space-5);
  }

  .nav-link[aria-current="page"] {
    color: var(--ink-fg);
  }

  .nav-link[aria-current="page"]::after {
    width: 100%;
  }

  .nav-cta {
    display: flex;
    gap: var(--space-3);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 34px;
    height: 34px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .nav-toggle-bar {
    height: 2px;
    background: var(--ink-fg);
    border-radius: 2px;
    transition: transform var(--dur-fast) var(--ease), opacity var(--dur-fast) var(--ease);
  }

  @media (max-width: 780px) {
    .nav-toggle {
      display: flex;
    }

    .nav-menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--ink);
      border-top: 1px solid var(--ink-line);
      flex-direction: column;
      align-items: flex-start;
      padding: var(--space-5) clamp(20px, 5vw, 56px) var(--space-6);
      gap: var(--space-5);
      display: none;
    }

    .nav-menu.is-open {
      display: flex;
    }

    .nav-links {
      flex-direction: column;
      gap: var(--space-4);
    }

    .nav-cta {
      width: 100%;
    }

    .nav-cta .btn {
      flex: 1;
      justify-content: center;
    }
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-menu");
  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });
</script>
