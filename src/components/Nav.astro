---
const navLinks = [
  { href: "/", label: "Home" },
  {
    href: "/about/",
    label: "About",
    hubLabel: "About",
    children: [
      { href: "/about/team/", label: "Meet The Team" },
      { href: "/about/what-we-do/", label: "What We Do" },
      { href: "/press/", label: "Press & Credibility" },
    ],
  },
  {
    href: "/the-need/",
    label: "Kidney Disease",
    hubLabel: "Kidney Disease",
    children: [
      { href: "/the-need/fsgs/", label: "FSGS" },
      { href: "/the-need/apol1/", label: "APOL1-Mediated Kidney Disease" },
      { href: "/the-need/data/", label: "Bronx Data You Should Know" },
    ],
  },
  { href: "/storytelling/", label: "Storytelling" },
  { href: "/partner-with-us/", label: "Partner With Us" },
  { href: "/contact/", label: "Contact" },
];
const currentPath = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? currentPath === "/" : currentPath.startsWith(href));
---

<header class="site-nav on-dark">
  <div class="container nav-row">
    <a href="/" class="wordmark">The Jentosy Project</a>

    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        {navLinks.map((link) => (
          <li class={link.children ? "desktop-nav-parent" : undefined}>
            <a href={link.href} class="nav-link" aria-current={isActive(link.href) ? "page" : undefined}>
              {link.label}
              {link.children && <span class="desktop-nav-caret" aria-hidden="true"></span>}
            </a>
            {link.children && (
              <ul class="desktop-nav-dropdown">
                <li>
                  <a
                    href={link.href}
                    class="desktop-nav-dropdown-hub"
                    aria-current={currentPath === link.href ? "page" : undefined}
                  >
                    {link.hubLabel}
                  </a>
                </li>
                {link.children.map((child) => (
                  <li>
                    <a href={child.href} aria-current={isActive(child.href) ? "page" : undefined}>
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <button
      class="menu-trigger"
      id="menu-trigger"
      aria-expanded="false"
      aria-controls="site-menu"
    >
      <span class="menu-trigger-label">Menu</span>
    </button>

    <a href="/donate/" class="btn btn-rust nav-donate">Donate</a>
  </div>

  <div class="site-menu" id="site-menu" aria-hidden="true">
    <nav class="container site-menu-links" aria-label="Primary">
      <ul>
        {navLinks.map((link) => {
          const slug = link.href.replace(/\//g, "");
          return (
            <li>
              {link.children ? (
                <>
                  <button
                    class="site-menu-link site-menu-accordion-trigger"
                    aria-expanded="false"
                    aria-controls={`submenu-${slug}`}
                  >
                    {link.label}
                    <span class="site-menu-caret" aria-hidden="true"></span>
                  </button>
                  <ul class="site-menu-sublinks" id={`submenu-${slug}`}>
                    <li>
                      <a href={link.href} class="site-menu-sublink site-menu-sublink-all">
                        {link.hubLabel}
                      </a>
                    </li>
                    {link.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class="site-menu-sublink"
                          aria-current={isActive(child.href) ? "page" : undefined}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  href={link.href}
                  class="site-menu-link"
                  aria-current={isActive(link.href) ? "page" : undefined}
                >
                  {link.label}
                </a>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="container site-menu-footer">
      <p class="site-menu-tagline">Health equity for underserved communities, starting in the Bronx.</p>
      <div class="cluster gap-3">
        <a href="/partner-with-us/" class="btn btn-steel-outline">Partner With Us</a>
        <a href="/donate/" class="btn btn-rust">Donate</a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 70;
  }

  .nav-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: var(--space-5);
    padding-block: var(--space-4);
    padding-inline: clamp(16px, 4vw, 40px);
  }

  @media (min-width: 1000px) {
    .nav-row {
      grid-template-columns: auto 1fr auto;
    }
  }

  .wordmark {
    justify-self: start;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-fg);
    white-space: nowrap;
    /* A grid item's own 1fr track won't shrink below its content's
       natural size by default (min-width:auto) — on a narrow-enough
       phone this pushed the Donate button in the next 1fr track past
       the viewport edge instead of ever letting the wordmark itself
       shrink. min-width:0 lets the track actually shrink; overflow +
       ellipsis is the fallback if it still doesn't fit. */
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav-donate {
    justify-self: end;
    padding: 12px 24px;
  }

  /* ---------- Desktop nav (visible top-level links) ---------- */

  .desktop-nav {
    display: none;
  }

  @media (min-width: 1000px) {
    .desktop-nav {
      display: block;
      justify-self: center;
    }
  }

  .desktop-nav > ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    /* Nav labels never wrap mid-phrase (see .nav-link white-space:nowrap) —
       if a longer label like "Kidney Disease" tips the row past the
       available 1fr track width at a given viewport, the whole set of
       links wraps onto a second centered line instead of breaking a
       single item apart or overlapping the wordmark/Donate button. */
    row-gap: var(--space-3);
    column-gap: clamp(16px, 2vw, 28px);
  }

  .desktop-nav > ul > li {
    position: relative;
  }

  .desktop-nav-caret {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-left: 5px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    opacity: 0.7;
  }

  .desktop-nav-dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translate(-50%, 4px);
    margin: 0;
    padding: var(--space-2);
    min-width: 220px;
    list-style: none;
    background: var(--ink);
    border: 1px solid var(--ink-line);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.28);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease), visibility var(--dur-fast);
  }

  .desktop-nav-parent:hover .desktop-nav-dropdown,
  .desktop-nav-parent:focus-within .desktop-nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .desktop-nav-dropdown a {
    display: block;
    padding: 9px 12px;
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: none;
    text-decoration: none;
    color: var(--ink-fg-muted);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
  }

  .desktop-nav-dropdown a:hover,
  .desktop-nav-dropdown a[aria-current="page"] {
    color: var(--ink-fg);
    background: var(--ink-soft);
  }

  .desktop-nav-dropdown a.desktop-nav-dropdown-hub {
    font-weight: 800;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--eyebrow-accent);
    border-bottom: 1px solid var(--ink-line);
    margin-bottom: var(--space-1);
    padding-bottom: 11px;
  }

  .menu-trigger {
    justify-self: center;
    background: none;
    border: none;
    padding: 4px 10px;
    /* The single most important nav control on mobile was only 24px
       tall — right at WCAG's bare minimum tap-target size with no
       margin for error. min-height + centered content guarantees a
       comfortable target regardless of the label's own font metrics. */
    min-height: 44px;
    display: flex;
    align-items: center;
    color: var(--ink-fg);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease);
  }

  @media (min-width: 1000px) {
    .menu-trigger {
      display: none;
    }
  }

  .menu-trigger:hover {
    color: var(--eyebrow-accent);
  }

  .menu-trigger-label {
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .site-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(var(--space-6), 6vw, var(--space-8));
    background: var(--ink);
    padding-block: calc(var(--space-8) + 56px) var(--space-7);
    overflow-y: auto;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-16px);
    transition: opacity var(--dur-med) var(--ease), transform var(--dur-med) var(--ease), visibility var(--dur-med);
  }

  .site-menu.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .site-menu-links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .site-menu-link {
    display: inline-block;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(32px, 6vw, 64px);
    line-height: 1.1;
    text-decoration: none;
    color: var(--ink-fg-muted);
    transition: color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }

  .site-menu-link:hover,
  .site-menu-link[aria-current="page"] {
    color: var(--rust-on-dark);
    transform: translateX(10px);
  }

  .site-menu-accordion-trigger {
    display: inline-flex;
    align-items: baseline;
    gap: 16px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .site-menu-caret {
    width: 12px;
    height: 12px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    opacity: 0.7;
    transform: rotate(45deg);
    transition: transform var(--dur-fast) var(--ease);
  }

  .site-menu-accordion-trigger[aria-expanded="true"] .site-menu-caret {
    transform: rotate(-135deg);
  }

  .site-menu-sublinks {
    list-style: none;
    margin: 0;
    padding-left: clamp(20px, 3vw, 36px);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height var(--dur-med) var(--ease), opacity var(--dur-fast) var(--ease), margin-top var(--dur-med) var(--ease);
  }

  .site-menu-sublinks.is-open {
    max-height: 240px;
    opacity: 1;
    margin-top: var(--space-2);
  }

  .site-menu-sublink-all {
    font-weight: 800;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--eyebrow-accent);
  }

  .site-menu-sublink {
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--ink-fg-muted);
    transition: color var(--dur-fast) var(--ease);
  }

  .site-menu-sublink:hover,
  .site-menu-sublink[aria-current="page"] {
    color: var(--rust-on-dark);
  }

  .site-menu-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--ink-line);
  }

  .site-menu-tagline {
    font-size: 13px;
    color: var(--ink-fg-muted);
    max-width: 32ch;
    margin: 0;
  }

  @media (max-width: 480px) {
    .wordmark {
      font-size: 12.5px;
      letter-spacing: 0.05em;
    }

    .nav-donate {
      padding: 9px 16px;
      font-size: 10.5px;
    }

    .menu-trigger-label {
      font-size: 14px;
    }
  }
</style>

<script>
  const trigger = document.getElementById("menu-trigger");
  const triggerLabel = trigger?.querySelector(".menu-trigger-label");
  const menu = document.getElementById("site-menu");

  function closeOnEscape(e: KeyboardEvent) {
    if (e.key === "Escape") closeMenu();
  }

  function openMenu() {
    menu?.classList.add("is-open");
    menu?.setAttribute("aria-hidden", "false");
    trigger?.setAttribute("aria-expanded", "true");
    if (triggerLabel) triggerLabel.textContent = "Close";
    document.body.style.overflow = "hidden";
    document.addEventListener("keydown", closeOnEscape);
  }

  function closeMenu() {
    menu?.classList.remove("is-open");
    menu?.setAttribute("aria-hidden", "true");
    trigger?.setAttribute("aria-expanded", "false");
    if (triggerLabel) triggerLabel.textContent = "Menu";
    document.body.style.overflow = "";
    document.removeEventListener("keydown", closeOnEscape);
  }

  trigger?.addEventListener("click", () => {
    const isOpen = trigger.getAttribute("aria-expanded") === "true";
    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeMenu));

  menu?.querySelectorAll<HTMLButtonElement>(".site-menu-accordion-trigger").forEach((btn) => {
    const targetId = btn.getAttribute("aria-controls");
    const target = targetId ? document.getElementById(targetId) : null;
    btn.addEventListener("click", () => {
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!isOpen));
      target?.classList.toggle("is-open", !isOpen);
    });
  });
</script>
