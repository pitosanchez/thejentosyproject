---
const year = new Date().getFullYear();
---

<footer class="site-footer on-dark">
  <div class="container footer-grid">
    <div class="footer-brand">
      <p class="wordmark">The Jentosy Project</p>
      <p class="tagline">Health equity for underserved communities, starting in the Bronx.</p>
    </div>

    <nav class="footer-col" aria-label="Site">
      <p class="footer-heading">Site</p>
      <a href="/about/">About</a>
      <a href="/about/team/">Meet The Team</a>
      <a href="/about/what-we-do/">What We Do</a>
      <a href="/the-need/">The Need</a>
      <a href="/storytelling/">Storytelling</a>
    </nav>

    <nav class="footer-col" aria-label="Take action">
      <p class="footer-heading">Take Action</p>
      <a href="/partner-with-us/">Partner With Us</a>
      <a href="/donate/">Donate</a>
      <a href="/contact/">Contact</a>
    </nav>

    <nav class="footer-col" aria-label="Legal">
      <p class="footer-heading">Legal</p>
      <a href="/privacy-terms/">Privacy &amp; Terms</a>
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} The Jentosy Project, Inc. — a 501(c)(3) public charity.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-6) var(--space-4);
    border-top: 1px solid var(--ink-line);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: var(--space-5);
    padding-bottom: var(--space-5);
  }

  @media (max-width: 720px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .footer-brand .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 var(--space-3);
  }

  .footer-brand .tagline {
    font-size: 13.5px;
    color: var(--ink-fg-muted);
    max-width: 30ch;
    margin: 0;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-heading {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-fg-muted);
    margin: 0 0 var(--space-1);
  }

  .footer-col a {
    font-size: 13.5px;
    text-decoration: none;
    color: var(--ink-fg-muted);
    transition: color var(--dur-fast) var(--ease);
  }

  .footer-col a:hover {
    color: var(--ink-fg);
  }

  .footer-bottom {
    border-top: 1px solid var(--ink-line);
    padding-top: var(--space-4);
  }

  .footer-bottom p {
    font-size: 12px;
    color: var(--ink-fg-muted);
    margin: 0;
  }
</style>
