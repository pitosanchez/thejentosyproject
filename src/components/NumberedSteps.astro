---
interface Step {
  title: string;
  body: string;
  tag?: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<ol class="numbered-steps">
  {steps.map((s, i) => (
    <li class="step reveal" style={`--reveal-delay:${i * 0.07}s`}>
      <span class="step-num">{String(i + 1).padStart(2, "0")}</span>
      <div class="step-body">
        <div class="step-head">
          <h4 class="step-title">{s.title}</h4>
          {s.tag && <span class="step-tag">{s.tag}</span>}
        </div>
        <p>{s.body}</p>
      </div>
    </li>
  ))}
</ol>
