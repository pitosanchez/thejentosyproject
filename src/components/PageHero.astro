---
/**
 * The one hero every inner page uses (site-wide consistency pass,
 * 2026-11-24). Black band, split layout:
 *   left  — eyebrow, serif title (optional `accent` phrase in gold italic), lede
 *   right — `image` in a gold offset frame, or the brand rings motif
 * Breadcrumbs or extra content go in the default slot (rendered above the
 * eyebrow). `motif` is kept for backwards compatibility; the rings motif is
 * now shown whenever there's no image.
 */
import Rings from "./ui/Rings.astro";

interface Props {
  eyebrow: string;
  heading: string;
  /** Phrase appended to the heading in gold italic serif. */
  accent?: string;
  lede?: string;
  image?: { src: string; alt: string; position?: string; fit?: "cover" | "contain" };
  /** @deprecated rings motif is automatic when there's no image */
  motif?: boolean;
}
const { eyebrow, heading, accent, lede, image } = Astro.props;
const hasSlot = Astro.slots.has("default");
---

<section class="on-dark page-hero">
  <div class="container page-hero-grid">
    <div class="page-hero-text">
      {hasSlot && <div class="page-hero-pre"><slot /></div>}
      <p class="eyebrow reveal">{eyebrow}</p>
      <h1 class="page-hero-title reveal" style="--reveal-delay:0.06s">
        {heading}{accent && " "}{accent && <em class="page-hero-accent">{accent}</em>}
      </h1>
      {lede && (
        <p class="page-hero-lede reveal" style="--reveal-delay:0.12s">
          {lede}
        </p>
      )}
    </div>

    <div class="page-hero-art reveal" style="--reveal-delay:0.1s">
      {image ? (
        <div class={`page-hero-frame${image.fit === "contain" ? " page-hero-frame-contain" : ""}`}>
          <img
            src={image.src}
            alt={image.alt}
            style={image.position ? `object-position:${image.position}` : undefined}
          />
        </div>
      ) : (
        <Rings class="page-hero-rings" />
      )}
    </div>
  </div>
</section>

<style>
  .page-hero {
    overflow: clip;
  }

  .page-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    padding-block: clamp(var(--space-7), 6.5vw, 104px);
  }

  .page-hero-pre {
    margin-bottom: var(--space-5);
  }

  .page-hero-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(40px, 5.2vw, 80px);
    line-height: 1.02;
    letter-spacing: 0;
    margin: 0;
    text-wrap: balance;
  }

  .page-hero-accent {
    font-style: italic;
    color: var(--gold);
  }

  .page-hero-lede {
    margin: var(--space-5) 0 0;
    font-size: clamp(17px, 1.5vw, 19px);
    line-height: 1.7;
    color: var(--ink-fg-muted);
    max-width: 52ch;
  }

  .page-hero-art {
    justify-self: end;
    width: 100%;
  }

  .page-hero-frame {
    position: relative;
  }

  .page-hero-frame::before {
    content: "";
    position: absolute;
    inset: 0;
    transform: translate(16px, 16px);
    border: 2px solid var(--gold);
    border-radius: var(--radius-md);
  }

  .page-hero-frame img {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  /* Transparent illustrations: no frame, no crop. */
  .page-hero-frame-contain::before {
    display: none;
  }

  .page-hero-frame-contain img {
    aspect-ratio: auto;
    object-fit: contain;
    filter: drop-shadow(0 24px 30px rgba(0, 0, 0, 0.4));
  }

  :global(.page-hero-rings) {
    width: min(100%, 360px);
    margin-left: auto;
  }

  @media (max-width: 860px) {
    .page-hero-grid {
      grid-template-columns: 1fr;
    }

    .page-hero-art {
      justify-self: start;
      max-width: 460px;
    }

    :global(.page-hero-rings) {
      display: none;
    }
  }
</style>
