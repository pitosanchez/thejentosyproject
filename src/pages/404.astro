---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import NextSteps from "../components/ui/NextSteps.astro";
---

<BaseLayout title="Page Not Found" description="This page could not be found.">
  <PageHero
    eyebrow="404"
    heading="We couldn't find"
    accent="that page."
    lede="The page you're looking for may have moved. Here are a few places worth trying instead."
  />
  <NextSteps
    items={[
    { term: "Back to the start", note: "The Jentosy Project at a glance.", href: "/" },
    { term: "Kidney disease basics", note: "What it is, how it's found, how it's treated.", href: "/the-need/" },
    { term: "About us", note: "Who we are and why we exist.", href: "/about/" },
    { term: "Contact", note: "Tell us what you were looking for.", href: "/contact/" },
  ]}
  />
</BaseLayout>
