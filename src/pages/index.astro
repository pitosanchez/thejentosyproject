---
import BaseLayout from "../layouts/BaseLayout.astro";

const audiences = [
  {
    name: "Patients & Families",
    pitch: "Real knowledge and community to advocate for your own care — and catch kidney disease before it takes hold.",
    href: "/the-need/",
    linkLabel: "Start with the need",
  },
  {
    name: "Funders & Foundations",
    pitch: "Back an organization led by lived experience, closing the kidney-care gap for good.",
    href: "/partner-with-us/?audience=funder#funder",
    linkLabel: "Partner with us",
  },
  {
    name: "Researchers & Institutions",
    pitch: "Partner with us on education and community engagement around FSGS and APOL1.",
    href: "/partner-with-us/?audience=researcher#researcher",
    linkLabel: "Partner with us",
  },
  {
    name: "Healthcare Organizations",
    pitch: "Help us reach underserved patients earlier — before FSGS reaches dialysis or transplant.",
    href: "/partner-with-us/?audience=healthcare#healthcare",
    linkLabel: "Partner with us",
  },
  {
    name: "Policymakers",
    pitch: "Tackle the upstream drivers of kidney disease — from healthcare access to housing and education.",
    href: "/partner-with-us/?audience=policymaker#policymaker",
    linkLabel: "Partner with us",
  },
];

const howItWorks = [
  {
    step: "1",
    name: "Educate",
    body: "Plain-language education on FSGS and APOL1-mediated kidney disease — reaching people before they reach the transplant list.",
    href: "/the-need/",
    linkLabel: "See the need",
  },
  {
    step: "2",
    name: "Partner",
    body: "Connecting researchers, healthcare organizations, and policymakers around the shared goal of closing the kidney-care gap.",
    href: "/partner-with-us/",
    linkLabel: "Partner with us",
  },
  {
    step: "3",
    name: "Fund the Work",
    body: "Donations directly fund education and outreach that reaches underserved communities — starting in the Bronx.",
    href: "/donate/",
    linkLabel: "Donate",
  },
];
---

<BaseLayout
  title="Home"
  description="The Jentosy Project advances health equity for underserved communities by educating people about FSGS and APOL1-mediated kidney disease — starting in the Bronx."
>
  <!-- HERO — full-bleed photo, elegant serif overlay. Same photo, same
       palette, same copy — just not frozen: a slow, continuous Ken Burns
       zoom on the bg photo (see .hero-bg) and a slightly lighter scrim
       (see .hero-scrim) so it reads less flat, without changing the
       actual look of the section. -->
  <section class="on-dark hero-photo">
    <img class="hero-bg" src="/images/archival/third-ave-el-cross-bronx-expwy-1973-cropped.jpg" alt="" aria-hidden="true" />
    <div class="hero-scrim"></div>
    <div class="container hero-inner">
      <p class="eyebrow reveal">Health Equity &middot; Rare Kidney Disease</p>
      <h1 class="h1 reveal" style="--reveal-delay:0.08s">The Jentosy Project, Inc.</h1>
      <p class="lede reveal" style="--reveal-delay:0.16s">
        Kidney disease disparities don't exist in isolation. We educate underserved communities
        about FSGS and APOL1-mediated kidney disease — building the partnerships needed to close
        the gap in kidney care, starting in the Bronx.
      </p>
      <div class="cluster gap-3 reveal" style="--reveal-delay:0.24s">
        <a href="/partner-with-us/" class="btn btn-steel-outline">Partner With Us</a>
        <a href="/donate/" class="btn btn-rust">Donate</a>
      </div>
    </div>
  </section>

  <!-- THE NEED, BY THE NUMBERS — replaces the old founder-story stat
       tiles with sourced Bronx/national disparity figures. Numbers
       animate on scroll via the existing [data-count] count-up in
       BaseLayout — no new script needed here. -->
  <section class="on-dark bronx-stats">
    <div class="container">
      <p class="eyebrow reveal">Kidney Disease, By The Numbers</p>
      <h2 class="h2 reveal" style="--reveal-delay:0.06s; font-size:clamp(22px,2.6vw,28px);">
        Kidney disease doesn't fall on every community equally.
      </h2>
      <p class="lede reveal" style="--reveal-delay:0.12s; max-width:58ch;">
        Black and Brown communities carry a disproportionate share of kidney failure and
        dialysis dependence — a gap this organization exists to close, starting in the Bronx.
      </p>

      <div class="stats-row">
        <div class="stat reveal">
          <div class="stat-num-row">
            <span class="stat-num" data-count="4">0</span><span class="stat-suffix">&times;</span>
          </div>
          <p class="stat-label">Higher rate of kidney failure for Black Americans vs. White Americans</p>
          <p class="stat-source">CDC Chronic Kidney Disease Fact Sheet, 2026 &middot; USRDS 2023</p>
        </div>
        <div class="stat reveal" style="--reveal-delay:0.1s">
          <div class="stat-num-row">
            <span class="stat-num" data-count="35">0</span><span class="stat-suffix">%</span>
          </div>
          <p class="stat-label">of U.S. dialysis patients are Black, despite being just 13.5% of the population</p>
          <p class="stat-source">National Kidney Foundation</p>
        </div>
        <div class="stat reveal" style="--reveal-delay:0.2s">
          <div class="stat-num-row">
            <span class="stat-num" data-count="1">0</span><span class="stat-suffix">YR+</span>
          </div>
          <p class="stat-label">Longer average wait for a kidney transplant if you're Black vs. White</p>
          <p class="stat-source">National Kidney Foundation</p>
        </div>
        <div class="stat reveal" style="--reveal-delay:0.3s">
          <div class="stat-num-row">
            <span class="stat-num" data-count="336">0</span><span class="stat-suffix">/10K</span>
          </div>
          <p class="stat-label">Diabetes hospitalizations per 10,000 Black Bronx residents each year — the leading driver of kidney failure</p>
          <p class="stat-source">NY State Dept. of Health, Bronx County Health Indicators</p>
        </div>
      </div>

      <a href="/the-need/" class="btn btn-steel-outline" style="margin-top:var(--space-6);">See the full picture &rarr;</a>
    </div>
  </section>

  <!-- WHO THIS IS FOR -->
  <section class="on-light section-tight">
    <div class="container">
      <p class="eyebrow">Who This Is For</p>
      <h2 class="h2" style="font-size:clamp(22px,2.6vw,28px);">Five audiences, one shared goal.</h2>
      <div class="grid audience-grid">
        {audiences.map((a, i) => (
          <a
            href={a.href}
            class="audience-card reveal"
            style={`--reveal-delay:${i * 0.06}s; --card-accent: var(${i % 2 === 0 ? "--steel" : "--rust"})`}
          >
            <span class="audience-card-index">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="audience-card-title">{a.name}</h3>
            <p class="audience-card-pitch">{a.pitch}</p>
            <span class="linkline audience-card-link">{a.linkLabel} &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- STORY BRIDGE — the founder narrative used to live on this page before
       Founder's Story merged into About; without it, "Who This Is For" fell
       straight into a stats-only "The Need" section with nothing human in
       between. This restores the storytelling thread at the exact seam
       where it was cut, and gives "Patients & Families" above somewhere to
       land emotionally before the disease facts start. -->
  <section class="on-dark story-bridge">
    <div class="container story-bridge-inner">
      <img
        class="story-bridge-photo"
        src="/images/founder-portrait.webp"
        alt="Robert Sanchez, founder of The Jentosy Project"
      />
      <div class="story-bridge-text reveal">
        <p class="eyebrow">Why This Exists</p>
        <p class="story-bridge-quote">
          &ldquo;Our goal is to give everyone navigating kidney disease the social capital to
          make informed decisions, ask the right questions, and advocate for themselves —
          because where you live should never determine what you know, the care you get, or
          your chance to survive.&rdquo;
        </p>
        <div class="story-bridge-footer">
          <p class="story-bridge-byline">Robert Sanchez, Founder</p>
          <a href="/about/team/" class="linkline story-bridge-link">Read his full story &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- THE NEED — light, informative. A plain two-column grid: this used to
       be a GSAP ScrollTrigger pin/crossfade built for three stacked disease
       cards, but with only FSGS and APOL1 remaining, a static grid
       communicates the same thing without a scroll-hijack or an animation
       library for this section. -->
  <section class="on-light need-stack">
    <div class="container need-stack-inner">
      <div class="need-stack-text">
        <p class="eyebrow">Kidney Disease</p>
        <h2 class="h2">Rare kidney disease, plainly explained.</h2>
        <p class="lede" style="max-width:52ch;">
          Kidney disease disparities are downstream of poverty, unequal access to education,
          incarceration, broken homes, and the chronic stress those conditions produce. The
          Jentosy Project treats health equity as inseparable from these upstream social
          conditions.
        </p>
      </div>

      <div class="disease-grid">
        <a href="/the-need/fsgs/" class="card card-steel disease-card">
          <h3 class="h3">FSGS</h3>
          <p>Focal segmental glomerulosclerosis — how it presents, and why early awareness matters.</p>
        </a>
        <a href="/the-need/apol1/" class="card card-steel disease-card">
          <h3 class="h3">APOL1-Mediated Kidney Disease</h3>
          <p>A genetic risk factor concentrated in Black and Brown communities.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="on-light section-tight teaser-band">
    <div class="container">
      <p class="eyebrow">How It Works</p>
      <h2 class="h2" style="font-size:clamp(22px,2.6vw,28px);">
        Education and outreach in the Bronx — expanding over time.
      </h2>
      <p class="lede" style="max-width:56ch;">
        Our current focus is education and health equity: reaching people before they reach the
        transplant list. Transplantation equity remains part of our long-term mission.
      </p>

      <div class="grid how-it-works-grid">
        {howItWorks.map((item, i) => (
          <div class="how-it-works-item reveal" style={`--reveal-delay:${i * 0.08}s`}>
            <span class="how-it-works-step">{item.step}</span>
            <h3 class="h3">{item.name}</h3>
            <p>{item.body}</p>
            <a href={item.href} class="linkline how-it-works-link">{item.linkLabel} &rarr;</a>
          </div>
        ))}
      </div>

      <a href="/about/what-we-do/" class="btn btn-steel" style="margin-top:var(--space-6);">Learn what we do</a>
    </div>
  </section>

  <!-- CLOSING CTA — dark band -->
  <section class="on-dark section-tight cta-band">
    <div class="container cta-inner">
      <div class="reveal">
        <h2 class="h2">Fund it. Partner with it. Be part of it.</h2>
        <p class="lede">
          A funder, researcher, or healthcare partner should be able to understand why this work
          matters in minutes — and a supporter should be able to act in seconds.
        </p>
      </div>
      <div class="cluster gap-3 reveal" style="--reveal-delay:0.1s">
        <a href="/partner-with-us/" class="btn btn-steel-outline">Partner With Us</a>
        <a href="/donate/" class="btn btn-rust">Donate</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-photo {
    position: relative;
    min-height: 72vh;
    display: flex;
    align-items: center;
    overflow: clip;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    filter: brightness(1.22) contrast(1.04);
    animation: hero-ken-burns 26s ease-in-out infinite alternate;
  }

  @keyframes hero-ken-burns {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.09);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg {
      animation: none;
    }
  }

  /* The photo itself now runs brighter (see .hero-bg's filter), so the
     scrim was rebalanced rather than just lightened across the board —
     it used to be *weakest* right in the vertical middle (0.36), which
     is exactly where the centered text sits. Deepened there specifically
     so brightening the photo doesn't cost any text contrast. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20,29,21,0.56) 0%, rgba(20,29,21,0.58) 45%, rgba(20,29,21,0.78) 100%);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
    max-width: 760px;
  }

  /* Belt-and-suspenders on top of the scrim: a soft shadow keeps the
     text readable against the brighter photo even over its lightest
     patches (the sky, sunlit brick). */
  .hero-inner .h1,
  .hero-inner .lede,
  .hero-inner .eyebrow {
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.45);
  }

  .bronx-stats {
    padding-block: clamp(var(--space-7), 7vw, var(--space-8));
  }

  .stats-row {
    display: flex;
    flex-wrap: wrap;
    margin-top: var(--space-6);
  }

  .stat {
    flex: 1 1 220px;
    padding: var(--space-6) var(--space-4) 0 0;
    border-top: 1px solid var(--ink-line);
  }

  .stat-num-row {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-bottom: var(--space-3);
  }

  .stat-num {
    display: block;
  }

  .stat-suffix {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(18px, 2vw, 22px);
    color: var(--eyebrow-accent);
  }

  .stat-label {
    font-size: 13.5px;
    color: var(--ink-fg-muted);
    line-height: 1.4;
    max-width: 26ch;
  }

  .stat-source {
    margin-top: var(--space-3);
    font-size: 11px;
    color: var(--ink-fg-muted);
    opacity: 0.75;
  }

  .need-stack {
    overflow: clip;
    padding-block: clamp(var(--space-7), 7vw, var(--space-9));
  }

  .need-stack-inner {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .need-stack-text {
    max-width: 46ch;
  }

  .disease-grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (max-width: 900px) {
    .need-stack-inner {
      grid-template-columns: 1fr;
    }
  }

  .disease-card {
    text-decoration: none;
    color: inherit;
    transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
  }

  .disease-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 22px rgba(20, 33, 59, 0.12);
  }

  .audience-grid {
    grid-template-columns: repeat(3, 1fr);
    margin-top: var(--space-6);
  }

  @media (min-width: 1100px) {
    .audience-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  @media (max-width: 700px) {
    .audience-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .audience-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Floating cards, not the flat left-border editorial card used
     elsewhere on the site: a raised, shadowed face so this row reads as
     five distinct objects sitting above the page rather than a bordered
     list. Fixed min-height (not content-driven) is what keeps all five
     the same size regardless of copy length — the copy itself was also
     tightened to roughly one line's worth of difference between the
     shortest and longest pitch. */
  .audience-card {
    display: flex;
    flex-direction: column;
    min-height: 264px;
    padding: var(--space-6) var(--space-5);
    background: var(--card);
    border-radius: 16px;
    box-shadow: 0 1px 2px rgba(29, 42, 30, 0.05), 0 20px 32px -16px rgba(29, 42, 30, 0.22);
    text-decoration: none;
    color: inherit;
    transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
  }

  .audience-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 4px 10px rgba(29, 42, 30, 0.08), 0 30px 44px -16px rgba(29, 42, 30, 0.28);
  }

  .audience-card-index {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: 26px;
    line-height: 1;
    color: var(--card-accent, var(--steel));
    margin-bottom: var(--space-3);
  }

  /* The title is the thing each audience should recognize themselves in
     at a glance — sized and weighted to lead the card, not share billing
     with the body copy the way the site's default .h3 does. */
  .audience-card-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(19px, 1.7vw, 22px);
    line-height: 1.15;
    letter-spacing: 0.01em;
    margin: 0 0 var(--space-3);
  }

  .audience-card-pitch {
    font-size: 14px;
    line-height: 1.5;
    color: var(--fg-muted);
    margin: 0;
    flex-grow: 1;
  }

  .audience-card-link {
    margin-top: var(--space-4);
    font-weight: 700;
    color: var(--card-accent, var(--steel));
  }

  .story-bridge {
    padding-block: clamp(var(--space-7), 7vw, var(--space-8));
    border-top: 1px solid var(--ink-line);
  }

  .story-bridge-inner {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
  }

  @media (max-width: 640px) {
    .story-bridge-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .story-bridge-photo {
      margin: 0 auto;
    }

    .story-bridge-footer {
      justify-content: center;
    }
  }

  .story-bridge-photo {
    width: clamp(96px, 12vw, 148px);
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 50%;
    filter: grayscale(1) contrast(1.08) brightness(0.96);
  }

  .story-bridge-quote {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(17px, 1.9vw, 23px);
    line-height: 1.45;
    color: var(--ink-fg);
    margin: var(--space-2) 0 var(--space-4);
    max-width: 62ch;
  }

  .story-bridge-footer {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .story-bridge-byline {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-fg-muted);
  }

  .story-bridge-link {
    color: var(--eyebrow-accent);
  }

  .teaser-band {
    border-top: 1px solid var(--line);
  }

  .how-it-works-grid {
    grid-template-columns: repeat(3, 1fr);
    margin-top: var(--space-6);
  }

  @media (max-width: 780px) {
    .how-it-works-grid {
      grid-template-columns: 1fr;
    }
  }

  .how-it-works-item {
    border-top: 3px solid var(--steel);
    padding-top: var(--space-4);
  }

  .how-it-works-step {
    font-family: var(--font-display);
    font-weight: 600;
    font-style: italic;
    font-size: 34px;
    /* --steel, not --eyebrow-accent: this sits on the light --paper
       background (the "How It Works" section is on-light) —
       eyebrow-accent is only verified for dark-background use. */
    color: var(--steel);
    line-height: 1;
    display: block;
    margin-bottom: var(--space-2);
  }

  .how-it-works-link {
    display: inline-block;
    margin-top: var(--space-2);
    font-weight: 700;
    color: var(--steel);
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .cta-inner .lede {
    max-width: 52ch;
  }
</style>
