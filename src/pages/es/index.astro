---
import HomeSections from "../../components/HomeSections.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localeHref } from "../../i18n/utils";

const L = (path: string) => localeHref(path, "es");


---

<BaseLayout
  title="Inicio"
  description="The Jentosy Project promueve la equidad en salud para comunidades desatendidas educando a las personas sobre la GEFS y la enfermedad renal mediada por APOL1 — empezando por el Bronx."
>
  <section class="on-dark hero-photo">
    <img class="hero-bg" src="/images/archival/third-ave-el-cross-bronx-expwy-1973-cropped.jpg" alt="" aria-hidden="true" />
    <div class="hero-scrim"></div>
    <div class="container hero-inner">
      <p class="eyebrow reveal">Equidad en salud &middot; Enfermedad renal poco frecuente</p>
      <h1 class="h1 reveal" style="--reveal-delay:0.08s">The Jentosy Project, Inc.</h1>
      <p class="lede reveal" style="--reveal-delay:0.16s">
        Las desigualdades en la enfermedad renal no existen de forma aislada. Educamos a las
        comunidades desatendidas sobre la GEFS y la enfermedad renal mediada por APOL1 —
        construyendo las alianzas necesarias para cerrar la brecha en la atención renal,
        empezando por el Bronx.
      </p>
    </div>
  </section>

  <section class="on-dark bronx-stats">
    <div class="container">
      <p class="eyebrow reveal">La enfermedad renal, en cifras</p>
      <h2 class="h2 reveal" style="--reveal-delay:0.06s;">
        La enfermedad renal no recae <span class="hl">por igual</span> sobre todas las comunidades.
      </h2>
      <p class="lede reveal" style="--reveal-delay:0.12s; max-width:58ch;">
        Las comunidades negras y latinas cargan con una parte desproporcionada de la insuficiencia
        renal y la dependencia de la diálisis — la brecha que existimos para cerrar.
      </p>

      <div class="stats-row">
        <div class="stat reveal">
          <div class="stat-num-row">
            <span class="stat-num" data-count="4">0</span><span class="stat-suffix">&times;</span>
          </div>
          <p class="stat-label">Mayor tasa de insuficiencia renal en personas negras que en personas blancas en EE. UU.</p>
          <p class="stat-source">Hoja informativa sobre la enfermedad renal crónica de los CDC, 2026 &middot; USRDS 2023</p>
        </div>
        <div class="stat reveal" style="--reveal-delay:0.1s">
          <div class="stat-num-row">
            <span class="stat-num" data-count="35">0</span><span class="stat-suffix">%</span>
          </div>
          <p class="stat-label">de los pacientes en diálisis en EE. UU. son personas negras, aun siendo solo el 13.5 % de la población</p>
          <p class="stat-source">National Kidney Foundation</p>
        </div>
        <div class="stat reveal" style="--reveal-delay:0.2s">
          <div class="stat-num-row">
            <span class="stat-num" data-count="1">0</span><span class="stat-suffix">AÑO+</span>
          </div>
          <p class="stat-label">Espera promedio más larga para un trasplante de riñón si eres una persona negra en vez de blanca</p>
          <p class="stat-source">National Kidney Foundation</p>
        </div>
        <div class="stat reveal" style="--reveal-delay:0.3s">
          <div class="stat-num-row">
            <span class="stat-num" data-count="336">0</span><span class="stat-suffix">/10K</span>
          </div>
          <p class="stat-label">Hospitalizaciones por diabetes al año por cada 10,000 residentes negros del Bronx — la principal causa de insuficiencia renal</p>
          <p class="stat-source">Depto. de Salud del Estado de Nueva York, Indicadores de Salud del Condado del Bronx</p>
        </div>
      </div>

      <a href={L("/the-need/data/")} class="btn btn-steel-outline" style="margin-top:var(--space-6);">Ver el panorama completo &rarr;</a>
    </div>
  </section>

  <HomeSections lang="es" />
</BaseLayout>

<style>
  .hero-photo {
    position: relative;
    min-height: 72vh;
    display: flex;
    align-items: center;
    overflow: clip;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    filter: brightness(1.22) contrast(1.04);
    animation: hero-ken-burns 26s ease-in-out infinite alternate;
  }

  @keyframes hero-ken-burns {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.09);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg {
      animation: none;
    }
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10,12,10,0.30) 0%, rgba(10,12,10,0.50) 45%, rgba(10,12,10,0.60) 100%);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    /* Scrim was lightened in the 2026-11-24 brighten pass; this soft shadow
       keeps the copy legible over the busier, brighter photo. */
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.7), 0 0 2px rgba(0, 0, 0, 0.5);
    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
    max-width: 760px;
  }

  .hero-inner .h1,
  .hero-inner .lede,
  .hero-inner .eyebrow {
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.45);
  }

  .bronx-stats {
    padding-block: clamp(var(--space-7), 7vw, var(--space-8));
  }

  .stats-row {
    display: flex;
    flex-wrap: wrap;
    margin-top: var(--space-6);
  }

  .stat {
    flex: 1 1 220px;
    padding: var(--space-6) var(--space-4) 0 0;
    border-top: 1px solid var(--ink-line);
  }

  .stat-num-row {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-bottom: var(--space-3);
  }

  .stat-num {
    display: block;
  }

  .stat-suffix {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: clamp(22px, 2.6vw, 30px);
    color: var(--eyebrow-accent);
  }

  .stat-label {
    font-size: 13.5px;
    color: var(--ink-fg-muted);
    line-height: 1.4;
    max-width: 26ch;
  }

  .stat-source {
    margin-top: var(--space-3);
    font-size: 11px;
    color: var(--ink-fg-muted);
    opacity: 0.75;
  }

  .need-stack {
    overflow: clip;
    padding-block: clamp(var(--space-7), 7vw, var(--space-9));
  }

  .need-stack-inner {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .need-stack-text {
    max-width: 46ch;
  }

  .disease-grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (max-width: 900px) {
    .need-stack-inner {
      grid-template-columns: 1fr;
    }
  }

  .disease-card {
    text-decoration: none;
    color: inherit;
    transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
  }

  .disease-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 22px rgba(20, 33, 59, 0.12);
  }

  .audience-grid {
    grid-template-columns: repeat(3, 1fr);
    margin-top: var(--space-6);
  }

  @media (min-width: 1100px) {
    .audience-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  @media (max-width: 700px) {
    .audience-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .audience-grid {
      grid-template-columns: 1fr;
    }
  }

  .audience-card {
    display: flex;
    flex-direction: column;
    min-height: 264px;
    padding: var(--space-6) var(--space-5);
    background: var(--card);
    border-radius: 16px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05), 0 20px 32px -16px rgba(0, 0, 0, 0.22);
    text-decoration: none;
    color: inherit;
    transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
  }

  .audience-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08), 0 30px 44px -16px rgba(0, 0, 0, 0.28);
  }

  .audience-card-index {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: 26px;
    line-height: 1;
    color: var(--card-accent, var(--steel));
    margin-bottom: var(--space-3);
  }

  .audience-card-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(19px, 1.7vw, 22px);
    line-height: 1.15;
    letter-spacing: 0.01em;
    margin: 0 0 var(--space-3);
  }

  .audience-card-pitch {
    font-size: 14px;
    line-height: 1.5;
    color: var(--fg-muted);
    margin: 0;
    flex-grow: 1;
  }

  .audience-card-link {
    margin-top: var(--space-4);
    font-weight: 700;
    color: var(--card-accent, var(--steel));
  }

  .story-bridge {
    padding-block: clamp(var(--space-7), 7vw, var(--space-8));
    border-top: 1px solid var(--ink-line);
  }

  .story-bridge-inner {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
  }

  @media (max-width: 640px) {
    .story-bridge-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .story-bridge-photo {
      margin: 0 auto;
    }

    .story-bridge-footer {
      justify-content: center;
    }
  }

  .story-bridge-photo {
    width: clamp(96px, 12vw, 148px);
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 50%;
    filter: grayscale(1) contrast(1.08) brightness(1.04);
  }

  .story-bridge-quote {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(17px, 1.9vw, 23px);
    line-height: 1.45;
    color: var(--ink-fg);
    margin: var(--space-2) 0 var(--space-4);
    max-width: 62ch;
  }

  .story-bridge-footer {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .story-bridge-byline {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-fg-muted);
  }

  .story-bridge-link {
    color: var(--eyebrow-accent);
  }

  .teaser-band {
    border-top: 1px solid var(--line);
  }

  .how-it-works-grid {
    grid-template-columns: repeat(3, 1fr);
    margin-top: var(--space-6);
  }

  @media (max-width: 780px) {
    .how-it-works-grid {
      grid-template-columns: 1fr;
    }
  }

  .how-it-works-item {
    border-top: 3px solid var(--steel);
    padding-top: var(--space-4);
  }

  .how-it-works-step {
    font-family: var(--font-display);
    font-weight: 600;
    font-style: italic;
    font-size: 34px;
    color: var(--steel);
    line-height: 1;
    display: block;
    margin-bottom: var(--space-2);
  }

  .how-it-works-link {
    display: inline-block;
    margin-top: var(--space-2);
    font-weight: 700;
    color: var(--steel);
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .cta-inner .lede {
    max-width: 52ch;
  }
</style>
