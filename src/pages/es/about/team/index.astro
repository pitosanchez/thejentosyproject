---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getBoard } from "../../../../lib/board";
import { localeHref } from "../../../../i18n/utils";

const L = (p: string) => localeHref(p, "es");
const board = getBoard("es");
---

<BaseLayout
  title="Nuestro equipo"
  description="Conoce a las personas detrás de The Jentosy Project: el fundador y director ejecutivo Robert Sanchez, y la junta directiva y el equipo que lo acompañan a medida que la organización crece."
>
  <section class="on-dark founder-hero">
    <span class="side-label" aria-hidden="true">Nuestro equipo</span>
    <div class="container founder-hero-inner">
      <div class="founder-hero-media reveal">
        <img
          class="founder-hero-photo"
          src="/images/founder-portrait.webp"
          alt="Robert Sanchez, fundador de The Jentosy Project"
        />
        <img
          class="founder-hero-photo-inset"
          src="/images/founder-podium.webp"
          alt="Robert Sanchez hablando en un podio sobre la enfermedad renal y la equidad en salud"
        />
      </div>

      <div class="founder-hero-text">
        <p class="eyebrow reveal">Nuestro equipo</p>

        <p class="reveal" style="--reveal-delay:0.14s">
          En 2009, Robert Sanchez recibió su primer trasplante de riñón — un riñón de donante
          vivo, de un amigo cercano. Pero la GEFS, la enfermedad poco frecuente que ya había
          destruido sus propios riñones, reapareció en el riñón trasplantado, y para 2014 estaba
          de nuevo en diálisis, tres veces por semana. En 2019, sin opciones, publicó en Facebook
          preguntando si alguien conocía a una persona dispuesta a donar un riñón. En cosa de una
          semana, la coordinadora de donaciones Chaya Lipschutz había encontrado una posible
          compatibilidad: Elizabeth Antosy. Entonces, la noche antes de la cirugía, su cirujano de
          trasplantes llamó con una noticia que lo cambió todo — Robert tenía cáncer de riñón, y
          el trasplante no podía seguir adelante.
        </p>

        <div class="founder-hero-statement reveal" style="--reveal-delay:0.2s">
          <p class="founder-hero-statement-text">
            Dos trasplantes. Dos mujeres que no se rindieron.
          </p>
        </div>

        <p class="reveal" style="--reveal-delay:0.26s">
          Elizabeth estaba desconsolada — pero en lugar de alejarse, se unió a una cadena de
          intercambio de riñones. A través de ella, Robert fue emparejado con una nueva donante,
          Jen Keller, y después de que superó el cáncer, ambos fueron trasplantados el 20 de
          octubre de 2021. La decisión de Elizabeth de permanecer en la cadena finalmente les dio
          a <strong>8 personas</strong> riñones nuevos — y le dio a la organización su nombre y el
          de Jen: <strong>The Jentosy Project</strong>.
        </p>

        <div class="founder-hero-footer reveal" style="--reveal-delay:0.32s">
          <div class="founder-hero-name">
            <p class="founder-hero-name-text">Robert Sanchez</p>
            <p class="founder-hero-name-title">Fundador y director ejecutivo</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="on-light section-tight board-divider" style="border-top:1px solid var(--line);">
    <div class="container">
      <h2 class="board-divider-title reveal">Junta directiva</h2>
      <p class="board-divider-note reveal" style="--reveal-delay:0.08s">
        Investigación clínica, entretenimiento y experiencia vivida con la enfermedad renal —
        reunidos en torno a la misma misión. Pasa el cursor o enfoca una tarjeta para leer la
        biografía completa de cada integrante.
      </p>
    </div>
  </section>

  <section class="on-light section" style="border-top:1px solid var(--line);">
    <div class="container">
      <div class="board-grid">
        {board.map((person) => (
          <div class="person-card" tabindex="0">
            <div class="person-card-inner">
              <div class="person-card-face person-card-front">
                <div class="person-card-header" aria-hidden="true">
                  <p class="person-card-name">{person.name}</p>
                  <p class="person-card-role">{person.role}</p>
                </div>
                <div class="person-card-photo-wrap">
                  {person.photoExists ? (
                    <img class="person-card-photo" src={person.photo} alt={`Retrato de ${person.name}`} />
                  ) : (
                    <div class="person-card-photo person-card-photo-placeholder" aria-hidden="true"></div>
                  )}
                  <span class="person-card-flip-hint" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 12a9 9 0 0 1 15-6.7L21 8" />
                      <path d="M21 3v5h-5" />
                      <path d="M21 12a9 9 0 0 1-15 6.7L3 16" />
                      <path d="M3 21v-5h5" />
                    </svg>
                  </span>
                </div>
              </div>

              <div class="person-card-face person-card-back">
                <span class="person-card-back-mark" aria-hidden="true">&ldquo;</span>
                <p class="person-card-back-name">{person.name}</p>
                <p class="person-card-back-role">{person.role}</p>
                <p class="person-card-back-bio">{person.bio}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="on-dark section-tight cta-band">
    <div class="container cta-inner reveal">
      <h2 class="h2">Ayuda a extender lo que Jen y Elizabeth empezaron.</h2>
      <div class="cluster gap-3" style="margin-top:var(--space-5);">
        <a href={L("/partner-with-us/")} class="btn btn-steel-outline">Colabora con nosotros</a>
        <a href={L("/donate/")} class="btn btn-rust">Donar</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 700px;
  }

  /* ---------- Founder hero ---------- */

  .founder-hero {
    position: relative;
    overflow: clip;
  }

  .side-label {
    position: absolute;
    left: 22px;
    top: 50%;
    transform: translateY(-50%) rotate(-90deg);
    transform-origin: left center;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-fg-muted);
    white-space: nowrap;
    display: none;
  }

  @media (min-width: 1100px) {
    .side-label {
      display: block;
    }
  }

  .founder-hero-inner {
    display: grid;
    grid-template-columns: minmax(260px, 38%) 1fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
    padding-block: clamp(var(--space-5), 5vw, var(--space-6));
  }

  @media (min-width: 1100px) {
    .founder-hero-inner {
      padding-left: var(--space-7);
    }
  }

  @media (max-width: 860px) {
    .founder-hero-inner {
      grid-template-columns: 1fr;
    }
  }

  .founder-hero-media {
    position: relative;
    margin-bottom: var(--space-7);
  }

  .founder-hero-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-sm);
    filter: grayscale(1) contrast(1.08) brightness(0.96);
    transition: filter 0.6s var(--ease);
  }

  .founder-hero-media:hover .founder-hero-photo {
    filter: grayscale(0) contrast(1) brightness(1);
  }

  .founder-hero-photo-inset {
    position: absolute;
    right: -8%;
    bottom: -10%;
    width: 46%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 4px solid var(--ink);
    box-shadow: 0 20px 44px rgba(0, 0, 0, 0.45);
    filter: grayscale(1) contrast(1.08);
  }

  .founder-hero-text p {
    color: var(--ink-fg-muted);
    font-size: 15px;
    line-height: 1.5;
    margin-bottom: var(--space-3);
  }

  .founder-hero-statement {
    margin: var(--space-4) 0;
    padding-left: var(--space-4);
    border-left: 1px solid var(--rust);
  }

  .founder-hero-statement-text {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(18px, 2.1vw, 24px);
    line-height: 1.3;
    color: var(--ink-fg);
    margin: 0;
  }

  .founder-hero-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--ink-line);
  }

  .founder-hero-name-text {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    color: var(--ink-fg);
    margin: 0;
  }

  .founder-hero-name-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-fg-muted);
    margin: var(--space-1) 0 0;
  }

  /* ---------- Board divider ---------- */

  .board-divider {
    text-align: center;
  }

  .board-divider-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(32px, 5vw, 56px);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0;
  }

  /* ---------- The Board ---------- */

  .board-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-6) var(--space-7);
  }

  @media (max-width: 560px) {
    .board-grid {
      max-width: 340px;
      margin-inline: auto;
    }
  }

  .person-card {
    position: relative;
    flex: 0 1 calc((100% - 2 * var(--space-7)) / 3);
    height: 530px;
    perspective: 1800px;
    outline: none;
  }

  @media (max-width: 860px) {
    .person-card {
      flex-basis: calc((100% - var(--space-7)) / 2);
    }
  }

  @media (max-width: 560px) {
    .person-card {
      flex-basis: 100%;
    }
  }

  .person-card::after {
    content: "";
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: -16px;
    height: 24px;
    background: radial-gradient(ellipse at center, rgba(29, 42, 30, 0.4), rgba(29, 42, 30, 0) 72%);
    filter: blur(5px);
    z-index: -1;
    transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
  }

  .person-card:hover::after,
  .person-card:focus-within::after,
  .person-card:focus::after {
    opacity: 0.75;
    transform: translateY(8px) scale(1.08);
  }

  .person-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.7s var(--ease), box-shadow 0.7s var(--ease);
    border-radius: var(--radius-md);
    box-shadow: 0 14px 26px rgba(0, 0, 0, 0.2);
  }

  .person-card:hover .person-card-inner,
  .person-card:focus-within .person-card-inner,
  .person-card:focus .person-card-inner {
    transform: translateY(-10px) rotateY(180deg);
    box-shadow: 0 26px 46px rgba(0, 0, 0, 0.3);
  }

  .person-card-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: var(--radius-md);
    border: 2px solid var(--rust);
    overflow: hidden;
  }

  .person-card-front {
    display: flex;
    flex-direction: column;
    background: var(--card);
  }

  .person-card-header {
    flex: 0 0 auto;
    padding: var(--space-3) var(--space-4) var(--space-2);
    background: var(--ink);
    border-bottom: 2px solid var(--rust);
  }

  .person-card-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    color: var(--ink-fg);
    margin: 0;
  }

  .person-card-role {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--eyebrow-accent);
    margin: var(--space-1) 0 0;
  }

  .person-card-photo-wrap {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
  }

  .person-card-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    display: block;
    filter: grayscale(0.25) contrast(1.04);
    transition: filter 0.7s var(--ease);
  }

  .person-card:hover .person-card-photo,
  .person-card:focus-within .person-card-photo,
  .person-card:focus .person-card-photo {
    filter: grayscale(0) contrast(1);
  }

  .person-card-photo-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(160deg, var(--card), var(--line));
  }

  .person-card-flip-hint {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ink);
    color: var(--eyebrow-accent);
    border: 1.5px solid var(--rust);
    border-radius: var(--radius-pill);
    opacity: 0.85;
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
  }

  .person-card:hover .person-card-flip-hint,
  .person-card:focus-within .person-card-flip-hint,
  .person-card:focus .person-card-flip-hint {
    opacity: 1;
    transform: rotate(180deg);
  }

  .person-card-back {
    transform: rotateY(180deg);
    background: var(--ink);
    color: var(--ink-fg);
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .person-card-back-mark {
    position: absolute;
    top: -6px;
    right: var(--space-4);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: 64px;
    line-height: 1;
    color: var(--ink-line-strong);
    opacity: 0.5;
    pointer-events: none;
  }

  .person-card-back-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-fg);
    margin: 0;
    max-width: 80%;
  }

  .person-card-back-role {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--eyebrow-accent);
    margin: var(--space-1) 0 var(--space-2);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--ink-line);
  }

  .person-card-back-bio {
    position: relative;
    font-size: 11px;
    line-height: 1.55;
    color: var(--ink-fg-muted);
    margin: 0;
  }

  .cta-inner {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }
</style>
