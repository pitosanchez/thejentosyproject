---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PhotoSlot from "../../../../components/PhotoSlot.astro";
import { localeHref } from "../../../../i18n/utils";

const L = (p: string) => localeHref(p, "es");
const exists = (p: string) => fs.existsSync(path.join(process.cwd(), "public", p));
const heroExists = exists("images/community-education.png");

const inputs = [
  "Educación sobre la salud renal",
  "Datos",
  "Geografía",
  "Investigación",
  "Alianzas",
  "Historias de los pacientes",
];

const work = [
  {
    title: "Educación y recursos sobre la salud renal",
    body:
      "Explicaciones en lenguaje claro sobre la GEFS, la enfermedad renal mediada por APOL1 y la enfermedad renal crónica — creadas para llegar a personas que no encontrarán esta información en ningún otro lugar, antes de que un diagnóstico se convierta en una emergencia.",
    href: L("/the-need/"),
    linkLabel: "Ver la educación",
  },
  {
    title: "Alianzas comunitarias",
    body:
      "Conectar a investigadores, organizaciones de salud y responsables de políticas públicas en torno a una meta común: cerrar la brecha en la atención renal en las comunidades desatendidas.",
    href: L("/partner-with-us/"),
    linkLabel: "Colabora con nosotros",
  },
  {
    title: "Historias de pacientes",
    body:
      "La experiencia vivida tratada como una forma de evidencia. Las historias dan contexto a los datos — y le dan a los pacientes un lenguaje, y la certeza de que no están solos.",
    href: L("/storytelling/"),
    linkLabel: "Por qué las historias",
  },
  {
    title: "Where We Live",
    body:
      "Una iniciativa que examina la relación entre la enfermedad renal, el lugar y las condiciones que moldean la salud — empezando por los datos del Bronx que ya hemos reunido.",
    href: L("/where-we-live/"),
    linkLabel: "Explora la iniciativa",
  },
];
---

<BaseLayout
  title="Qué hacemos"
  description="Empezando por el Bronx, The Jentosy Project desarrolla educación sobre la salud renal, recursos sobre enfermedades renales poco frecuentes, alianzas comunitarias, historias de pacientes e iniciativas como Where We Live."
>
  <section class="on-dark wwd-hero">
    {heroExists ? (
      <img class="wwd-hero-bg" src="/images/community-education.png" alt="" aria-hidden="true" />
    ) : (
      <div class="wwd-hero-fallback" aria-hidden="true"></div>
    )}
    <div class="wwd-hero-scrim"></div>
    <div class="container wwd-hero-inner">
      <p class="eyebrow reveal">Quiénes somos · Qué hacemos</p>
      <h1 class="wwd-hero-heading reveal" style="--reveal-delay:0.08s">
        El trabajo, empezando por el Bronx.
      </h1>
      <p class="lede reveal wwd-hero-lede" style="--reveal-delay:0.16s">
        Empezando por el Bronx, The Jentosy Project desarrolla educación sobre la salud renal,
        recursos sobre enfermedades renales poco frecuentes, alianzas comunitarias, historias de
        pacientes e iniciativas como Where We Live que examinan la relación entre la enfermedad
        renal, el lugar y las condiciones que moldean la salud.
      </p>
    </div>
  </section>

  <section class="on-light section how-we-work">
    <div class="container">
      <p class="eyebrow reveal">Cómo trabajamos</p>
      <p class="hww-lead reveal" style="--reveal-delay:0.05s">
        Reunimos seis tipos de conocimiento — y los leemos unos frente a otros.
      </p>
      <div class="hww-grid">
        <ul class="hww-inputs">
          {inputs.map((label, i) => (
            <li class="hww-input reveal" style={`--reveal-delay:${i * 0.05}s`}>{label}</li>
          ))}
        </ul>
        <div class="hww-arrow" aria-hidden="true">
          <svg viewBox="0 0 40 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 12h34" />
            <path d="M28 4l8 8-8 8" />
          </svg>
        </div>
        <p class="hww-outcome reveal">
          Una imagen más clara de <strong>dónde existen las desigualdades</strong> — y de{" "}
          <strong>qué necesitan de verdad las comunidades</strong>.
        </p>
      </div>
    </div>
  </section>

  <section class="on-light section-tight the-work" style="border-top:1px solid var(--line);">
    <div class="container">
      <p class="eyebrow reveal">El trabajo</p>
      <ol class="work-list">
        {work.map((w, i) => (
          <li class="work-item reveal" style={`--reveal-delay:${i * 0.06}s`}>
            <span class="work-num">{String(i + 1).padStart(2, "0")}</span>
            <div class="work-body">
              <h2 class="h3 work-title">{w.title}</h2>
              <p>{w.body}</p>
              <a href={w.href} class="linkline work-link">{w.linkLabel} &rarr;</a>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="on-dark section future-work">
    <div class="container future-work-inner">
      <figure class="future-work-figure reveal">
        <PhotoSlot src="/images/healingheart.webp" alt="Una ilustración de un corazón sostenido entre manos ahuecadas" ratio="1 / 1" />
      </figure>
      <div class="future-work-text">
        <p class="eyebrow reveal">A dónde vuelve esto</p>
        <h2 class="h2 reveal" style="font-size:clamp(22px,2.6vw,30px);">Equidad en el trasplante.</h2>
        <p class="lede reveal" style="--reveal-delay:0.06s">
          La equidad en el trasplante es donde comenzó esta organización — en la propia
          experiencia de nuestro fundador. A medida que The Jentosy Project crezca, nuestra
          intención es volver a ese trabajo de forma directa. Por ahora, nuestros recursos se
          concentran más arriba en el proceso: en la educación y la detección temprana, llegando a
          las personas antes de que lleguen a la lista de trasplante.
        </p>
      </div>
    </div>
  </section>

  <section class="on-dark section-tight cta-band" style="border-top:1px solid var(--ink-line);">
    <div class="container reveal" style="text-align:center;">
      <h2 class="h2">Ayúdanos a llegar a más comunidades.</h2>
      <div class="cluster gap-3" style="justify-content:center; margin-top:var(--space-5);">
        <a href={L("/partner-with-us/")} class="btn btn-steel-outline">Colabora con nosotros</a>
        <a href={L("/donate/")} class="btn btn-rust">Donar</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .wwd-hero {
    position: relative;
    min-height: 52vh;
    display: flex;
    align-items: flex-end;
    overflow: clip;
  }

  .wwd-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 28% 22%;
    filter: brightness(0.82) contrast(1.04) saturate(0.95);
  }

  .wwd-hero-fallback {
    position: absolute;
    inset: 0;
    background: linear-gradient(150deg, var(--ink), var(--ink-soft));
  }

  .wwd-hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(20, 29, 21, 0.35) 0%, rgba(20, 29, 21, 0.55) 55%, rgba(20, 29, 21, 0.92) 100%),
      linear-gradient(90deg, rgba(20, 29, 21, 0.75) 0%, rgba(20, 29, 21, 0.3) 60%, rgba(20, 29, 21, 0.15) 100%);
  }

  .wwd-hero-inner {
    position: relative;
    z-index: 2;
    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
    max-width: 780px;
  }

  .wwd-hero-heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(32px, 5.2vw, 58px);
    line-height: 1.08;
    color: var(--ink-fg);
    margin: 0;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.4);
  }

  .wwd-hero-lede {
    margin-top: var(--space-5);
    max-width: 62ch;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.35);
  }

  .hww-lead {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(19px, 2.3vw, 26px);
    line-height: 1.4;
    color: var(--fg);
    max-width: 32ch;
    margin: 0;
  }

  .hww-grid {
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    margin-top: var(--space-6);
  }

  @media (max-width: 820px) {
    .hww-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }

  .hww-inputs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .hww-input {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(17px, 1.9vw, 21px);
    color: var(--fg);
    padding-left: var(--space-4);
    border-left: 2px solid var(--steel);
  }

  .hww-arrow {
    color: var(--rust);
    width: clamp(40px, 6vw, 64px);
  }

  .hww-arrow svg {
    width: 100%;
    height: auto;
  }

  @media (max-width: 820px) {
    .hww-arrow {
      transform: rotate(90deg);
      justify-self: center;
    }
  }

  .hww-outcome {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(20px, 2.6vw, 28px);
    line-height: 1.4;
    color: var(--fg);
    margin: 0;
    max-width: 28ch;
  }

  .hww-outcome strong {
    font-weight: 600;
    color: var(--rust);
  }

  .work-list {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
  }

  .work-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(16px, 3vw, 40px);
    padding: clamp(var(--space-5), 4vw, var(--space-7)) 0;
    border-top: 1px solid var(--line);
  }

  .work-item:last-child {
    border-bottom: 1px solid var(--line);
  }

  .work-num {
    font-family: var(--font-display);
    font-weight: 600;
    font-style: italic;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1;
    color: var(--line-strong);
  }

  .work-title {
    margin-bottom: var(--space-3);
  }

  .work-body p {
    color: var(--fg-soft);
    max-width: 58ch;
  }

  .work-link {
    display: inline-block;
    margin-top: var(--space-3);
    font-weight: 700;
    color: var(--steel);
  }

  .future-work-inner {
    display: grid;
    grid-template-columns: minmax(160px, 240px) 1fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }

  @media (max-width: 720px) {
    .future-work-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .future-work-figure {
      max-width: 220px;
      margin-inline: auto;
    }
  }

  .future-work-figure {
    margin: 0;
  }

  .future-work-figure :global(.photo-slot),
  .future-work-figure :global(.photo-slot-placeholder) {
    border-radius: 50%;
  }

  .future-work-text .lede {
    max-width: 58ch;
  }

  @media (max-width: 720px) {
    .future-work-text .lede {
      margin-inline: auto;
    }
  }

  .cta-inner {
    text-align: center;
  }
</style>
