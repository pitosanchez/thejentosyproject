---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PhotoSlot from "../../../components/PhotoSlot.astro";
import VideoSlot from "../../../components/VideoSlot.astro";
import { localeHref } from "../../../i18n/utils";

const L = (p: string) => localeHref(p, "es");
const exists = (p: string) => fs.existsSync(path.join(process.cwd(), "public", p));
const heroExists = exists("images/safe.webp");

const method = [
  { term: "Educación sobre la salud renal", note: "Explicaciones en lenguaje claro de lo que de verdad ocurre en el cuerpo." },
  { term: "Datos", note: "Vigilancia a nivel poblacional — y sus vacíos." },
  { term: "Geografía", note: "Dónde se concentran la carga de enfermedad, las derivaciones y los recursos." },
  { term: "Investigación", note: "Lo que la literatura revisada por pares establece y lo que no." },
  { term: "Alianzas", note: "Investigadores, sistemas de salud y responsables de políticas en torno a una meta." },
  { term: "Historias de los pacientes", note: "La experiencia vivida como una forma de evidencia." },
];
---

<BaseLayout
  title="Quiénes somos"
  description="The Jentosy Project es una organización sin fines de lucro 501(c)(3) que promueve la equidad en la salud renal para comunidades desatendidas, empezando por el Bronx — fundada por un receptor de dos trasplantes de riñón."
>
  <section class="on-dark about-hero" data-parallax-section>
    {heroExists ? (
      <img class="about-hero-bg" src="/images/safe.webp" alt="" aria-hidden="true" data-parallax-bg />
    ) : (
      <div class="about-hero-placeholder">
        <p class="about-hero-placeholder-note">
          Marcador de imagen principal — coloca <code>safe.webp</code> en <code>public/images/</code>{" "}
          y aparecerá aquí automáticamente.
        </p>
      </div>
    )}
    <div class="about-hero-tint"></div>
  </section>

  <section class="on-light founders-note">
    <div class="container">
      <h1 class="about-title reveal">Quiénes somos</h1>
      <div class="founders-note-inner">
        <span class="founders-note-mark" aria-hidden="true">&ldquo;</span>
        <p class="eyebrow reveal">Por qué existimos</p>
        <p class="founders-note-lead reveal">
          Creé The Jentosy Project porque sé lo que se siente tener enfermedad renal y no entender
          del todo lo que te está pasando.
        </p>
        <p class="founders-note-body reveal" style="--reveal-delay:0.06s">
          Demasiadas personas reciben la información que necesitan solo cuando ya enfrentan una
          enfermedad grave. Creo que las comunidades merecen información comprensible antes — y que
          el lugar donde vive la gente, aquello a lo que está expuesta y los recursos a los que
          puede acceder deben ser parte de cómo entendemos la salud renal.
        </p>
        <div class="founders-note-sign reveal" style="--reveal-delay:0.12s">
          <img
            class="founders-note-portrait"
            src="/images/founder-portrait.webp"
            alt="Robert Sanchez, fundador de The Jentosy Project"
          />
          <div>
            <p class="founders-note-name">Robert Sanchez</p>
            <p class="founders-note-role">Fundador y director ejecutivo · Receptor de dos trasplantes de riñón</p>
          </div>
        </div>
        <p class="founders-note-press reveal" style="--reveal-delay:0.16s">
          <a href="https://www.cbsnews.com/newyork/news/kidney-transplant-kidney-chain-robert-sanchez-elizabeth-antosy/">
            Su historia fue reportada de forma independiente por CBS News New York &rarr;
          </a>
        </p>
      </div>
    </div>
  </section>

  <figure class="bleed-figure reveal">
    <PhotoSlot src="/images/movement.webp" alt="Una ilustración de personas que avanzan juntas hacia un horizonte compartido" ratio="3.4 / 1" />
    <figcaption>Un movimiento, no un momento.</figcaption>
  </figure>

  <section class="on-dark method-band">
    <div class="container">
      <p class="eyebrow reveal">Cómo trabajamos</p>
      <p class="method-lead reveal">
        Reunimos educación sobre la salud renal, datos, geografía, investigación, alianzas y las
        historias de los pacientes — para entender mejor dónde existen las desigualdades y qué
        necesitan las comunidades.
      </p>
      <ol class="method-list">
        {method.map((m, i) => (
          <li class="method-item reveal" style={`--reveal-delay:${i * 0.05}s`}>
            <span class="method-num">{String(i + 1).padStart(2, "0")}</span>
            <p class="method-term">{m.term}</p>
            <p class="method-note">{m.note}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="on-light section name-section">
    <div class="container narrow">
      <p class="eyebrow reveal">El nombre</p>
      <p class="reveal" style="--reveal-delay:0.06s">
        The Jentosy Project lleva el nombre de <strong>Jen Keller</strong> y{" "}
        <strong>Elizabeth Antosy</strong> — dos mujeres cuya decisión de permanecer en una cadena
        de intercambio de riñones le dio al fundador Robert Sanchez un segundo trasplante, y le
        dio a ocho desconocidos riñones nuevos.
      </p>

      <figure class="story-video-figure reveal" style="--reveal-delay:0.12s">
        <VideoSlot
          src="/videos/where-the-name-comes-from.mp4"
          youtubeId="nsQ35ZgiWOk"
          ratio="16 / 9"
          title="Un hombre del Bronx por fin recibirá un trasplante de riñón tras años de espera — CBS News New York"
        />
        <figcaption>
          Cobertura independiente de{" "}
          <a href="https://www.cbsnews.com/newyork/news/kidney-transplant-kidney-chain-robert-sanchez-elizabeth-antosy/">CBS News New York</a>.
        </figcaption>
      </figure>

      <p class="linkline reveal" style="--reveal-delay:0.18s">
        Lee la historia completa en <a href={L("/about/team/")}>Nuestro equipo</a> · Lee la
        filosofía detrás en <a href={L("/storytelling/")}>El poder de las historias</a>
      </p>
    </div>
  </section>

  <section class="on-dark section-tight mv-band">
    <div class="container">
      <div class="mv-grid">
        <div class="mv-col reveal">
          <p class="mv-label">Misión</p>
          <p class="mv-statement">
            Promover la equidad en salud para las comunidades desatendidas educando a las personas
            sobre las enfermedades renales poco frecuentes — incluidas la GEFS y la enfermedad
            renal mediada por APOL1 — y construyendo las alianzas necesarias para cerrar la brecha
            en la atención renal.
          </p>
        </div>
        <div class="mv-col mv-col-divided reveal" style="--reveal-delay:0.08s">
          <p class="mv-label">Visión</p>
          <p class="mv-statement">
            Un futuro en el que el código postal de nadie determine su acceso a la educación sobre
            la salud renal, la detección temprana o la atención que salva vidas.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="on-light section closer-section">
    <div class="container closer-inner">
      <figure class="closer-figure reveal">
        <PhotoSlot src="/images/treeoflife.webp" alt="Unas manos ahuecadas que sostienen un árbol que crece a partir de un par de riñones" ratio="5 / 4" />
      </figure>
      <div class="closer-text">
        <p class="pull reveal closer-line">El lugar donde vives nunca debería decidir lo que sabes.</p>
        <p class="linkline reveal" style="--reveal-delay:0.06s">
          Más sobre <a href={L("/about/what-we-do/")}>lo que hacemos día a día</a> y{" "}
          <a href={L("/about/team/")}>quiénes están detrás de esto</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="on-dark section-tight cta-band">
    <div class="container cta-inner reveal">
      <h2 class="h2">Ayuda a promover la equidad en la atención renal.</h2>
      <div class="cluster gap-3" style="margin-top:var(--space-5);">
        <a href={L("/partner-with-us/")} class="btn btn-steel-outline">Colabora con nosotros</a>
        <a href={L("/donate/")} class="btn btn-rust">Donar</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 640px;
    margin-inline: auto;
  }

  .about-hero {
    position: relative;
    min-height: 46vh;
    overflow: clip;
  }

  .about-hero-bg {
    position: absolute;
    inset: -16% 0;
    width: 100%;
    height: 132%;
    object-fit: cover;
    object-position: center 30%;
    will-change: transform;
  }

  .about-hero-tint {
    position: absolute;
    inset: 0;
    background: rgba(29, 42, 30, 0.22);
  }

  .about-hero-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
  }

  .about-hero-placeholder-note {
    max-width: 46ch;
    text-align: center;
    font-size: 13px;
    color: var(--ink-fg-muted);
  }

  .about-hero-placeholder-note code {
    font-family: var(--font-mono);
    font-size: 11.5px;
    background: rgba(255, 255, 255, 0.08);
    padding: 1px 5px;
    border-radius: 2px;
  }

  /* ---------- Por qué existimos: la nota del fundador ---------- */

  .founders-note {
    padding-top: 0;
    padding-bottom: clamp(var(--space-7), 7vw, var(--space-9));
  }

  .about-title {
    position: relative;
    top: -2.5rem;
    margin: 0 0 clamp(var(--space-4), 4vw, var(--space-7));
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(40px, 7vw, 92px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--ink);
    -webkit-text-stroke: 2px var(--paper);
    paint-order: stroke fill;
  }

  @media (max-width: 640px) {
    .about-title {
      top: -1.5rem;
    }
  }

  .founders-note-inner {
    position: relative;
    max-width: 780px;
  }

  .founders-note-mark {
    position: absolute;
    left: -0.12em;
    top: -0.62em;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(90px, 12vw, 150px);
    line-height: 1;
    color: var(--rust);
    opacity: 0.16;
    pointer-events: none;
  }

  .founders-note .eyebrow {
    margin-bottom: var(--space-4);
  }

  .founders-note-lead {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(24px, 3.1vw, 38px);
    line-height: 1.3;
    color: var(--fg);
    margin: 0 0 var(--space-5);
    max-width: 20ch;
  }

  @media (min-width: 620px) {
    .founders-note-lead {
      max-width: 34ch;
    }
  }

  .founders-note-body {
    font-size: clamp(16px, 1.55vw, 18.5px);
    line-height: 1.7;
    color: var(--fg-soft);
    max-width: 60ch;
    margin: 0;
  }

  .founders-note-sign {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .founders-note-portrait {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 20%;
    flex-shrink: 0;
    filter: grayscale(1) contrast(1.06);
  }

  .founders-note-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    color: var(--fg);
    margin: 0;
  }

  .founders-note-role {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: var(--space-1) 0 0;
  }

  .founders-note-press {
    margin: var(--space-4) 0 0;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .founders-note-press a {
    color: var(--steel);
  }

  /* ---------- Franja de imagen a sangre ---------- */

  .bleed-figure {
    margin: 0;
  }

  .bleed-figure :global(.photo-slot),
  .bleed-figure :global(.photo-slot-placeholder) {
    display: block;
    border-radius: 0;
  }

  .bleed-figure figcaption {
    text-align: center;
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 15px;
    color: var(--fg-muted);
  }

  /* ---------- Cómo trabajamos: el método ---------- */

  .method-band {
    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
  }

  .method-lead {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(19px, 2.3vw, 26px);
    line-height: 1.5;
    color: var(--ink-fg);
    max-width: 44ch;
    margin: 0 0 var(--space-7);
  }

  .method-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6) var(--space-6);
  }

  @media (max-width: 860px) {
    .method-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .method-list {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }

  .method-item {
    border-top: 1px solid var(--ink-line-strong);
    padding-top: var(--space-3);
  }

  .method-num {
    font-family: var(--font-display);
    font-weight: 600;
    font-style: italic;
    font-size: 22px;
    line-height: 1;
    color: var(--eyebrow-accent);
  }

  .method-term {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(18px, 1.9vw, 21px);
    color: var(--ink-fg);
    margin: var(--space-2) 0 var(--space-1);
  }

  .method-note {
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-fg-muted);
    margin: 0;
  }

  /* ---------- El nombre ---------- */

  .name-section .eyebrow,
  .name-section p {
    text-align: center;
  }

  .story-video-figure {
    margin: var(--space-5) 0;
  }

  .story-video-figure figcaption {
    margin-top: var(--space-2);
    font-size: 12.5px;
    color: var(--fg-muted);
    text-align: center;
  }

  /* ---------- Misión / Visión ---------- */

  .mv-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
  }

  @media (max-width: 700px) {
    .mv-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .mv-col-divided {
    border-left: 1px solid var(--ink-line);
    padding-left: clamp(32px, 6vw, 80px);
  }

  @media (max-width: 700px) {
    .mv-col-divided {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--ink-line);
      padding-top: var(--space-6);
    }
  }

  .mv-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--eyebrow-accent);
    margin: 0 0 var(--space-3);
  }

  .mv-statement {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(19px, 2vw, 23px);
    line-height: 1.4;
    color: var(--ink-fg);
    max-width: 40ch;
    margin: 0;
  }

  /* ---------- Cierre ---------- */

  .closer-inner {
    display: grid;
    grid-template-columns: minmax(220px, 320px) 1fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }

  @media (max-width: 720px) {
    .closer-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .closer-figure {
      max-width: 300px;
      margin-inline: auto;
    }
  }

  .closer-figure {
    margin: 0;
  }

  .closer-line {
    font-size: clamp(23px, 3vw, 32px);
    margin: 0 0 var(--space-3);
  }

  @media (max-width: 720px) {
    .closer-line {
      border-left: none;
      padding-left: 0;
    }
  }

  .cta-inner {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const section = document.querySelector<HTMLElement>("[data-parallax-section]");
  const bg = document.querySelector<HTMLElement>("[data-parallax-bg]");

  if (section && bg && !prefersReducedMotion) {
    gsap.to(bg, {
      yPercent: 12,
      ease: "none",
      scrollTrigger: {
        trigger: section,
        start: "top top",
        end: "bottom top",
        scrub: true,
      },
    });
  }
</script>
