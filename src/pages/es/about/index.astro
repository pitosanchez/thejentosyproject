---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PhotoSlot from "../../../components/PhotoSlot.astro";
import VideoSlot from "../../../components/VideoSlot.astro";
import { localeHref } from "../../../i18n/utils";
import fs from "node:fs";
import path from "node:path";

const L = (p: string) => localeHref(p, "es");
const exists = (p: string) => fs.existsSync(path.join(process.cwd(), "public", p));
const heroExists = exists("images/safe.webp");

const answers = [
  {
    q: "Por qué",
    a: "La geografía no debería decidir quién entiende su propio riesgo de salud. La educación es lo único que funciona antes de que un diagnóstico se convierta en una emergencia.",
  },
  {
    q: "Qué",
    a: "Enseñamos a las comunidades desatendidas sobre la GEFS y la enfermedad renal mediada por APOL1 — en lenguaje claro, antes de que sea demasiado tarde para actuar.",
  },
  {
    q: "Dónde",
    a: "El Bronx primero — uno de los ejemplos más marcados de esta desigualdad en el país. Diseñado para expandirse a todo el país desde aquí.",
  },
  {
    q: "Cómo",
    a: "La educación primero, las historias como método. La experiencia vivida cambia mentes que las estadísticas por sí solas no alcanzan.",
  },
];
---

<BaseLayout
  title="Quiénes somos"
  description="The Jentosy Project es una organización sin fines de lucro 501(c)(3) que promueve la equidad en la salud renal para comunidades desatendidas, empezando por el Bronx."
>
  <section class="on-dark about-hero" data-parallax-section>
    {heroExists ? (
      <img class="about-hero-bg" src="/images/safe.webp" alt="" aria-hidden="true" data-parallax-bg />
    ) : (
      <div class="about-hero-placeholder">
        <p class="about-hero-placeholder-note">
          Marcador de imagen principal — coloca <code>safe.webp</code> en <code>public/images/</code>{" "}
          y aparecerá aquí automáticamente.
        </p>
      </div>
    )}
    <div class="about-hero-tint"></div>
  </section>

  <section class="on-light about-top">
    <div class="container narrow">
      <h1 class="about-title reveal">Quiénes somos</h1>

      <p class="hook reveal" style="--reveal-delay:0.1s">
        La enfermedad renal suele ser invisible hasta que deja de serlo — y el lugar donde vives
        puede decidir si la ves venir. The Jentosy Project existe para cambiar eso.
      </p>

      <p class="press-mention reveal" style="--reveal-delay:0.16s">
        <a href="https://www.cbsnews.com/newyork/news/kidney-transplant-kidney-chain-robert-sanchez-elizabeth-antosy/">
          Cobertura independiente de CBS News New York &rarr;
        </a>
      </p>
    </div>
  </section>

  <section class="on-light answers-section">
    <div class="container">
      <div class="answers-grid">
        {answers.map((item, i) => (
          <div class="answer reveal" style={`--reveal-delay:${i * 0.06}s`}>
            <p class="answer-q">{item.q}</p>
            <p class="answer-a">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <figure class="wide-image wide-image-small subway-image reveal">
    <PhotoSlot src="/images/NtX0s.webp" alt="Un letrero del metro de Nueva York que dice Uptown & The Bronx Express, con los distintivos de las líneas 4 y 5" ratio="3 / 2" />
    <figcaption>Una comunidad, no un caso de estudio.</figcaption>
  </figure>

  <section class="on-light section name-section">
    <div class="container narrow">
      <p class="eyebrow reveal">El nombre</p>
      <p class="reveal" style="--reveal-delay:0.06s">
        The Jentosy Project lleva el nombre de <strong>Jen Keller</strong> y{" "}
        <strong>Elizabeth Antosy</strong> — dos mujeres cuya decisión de permanecer en una cadena
        de intercambio de riñones le dio al fundador Robert Sanchez un segundo trasplante, y le
        dio a ocho desconocidos riñones nuevos.
      </p>

      <figure class="story-video-figure reveal" style="--reveal-delay:0.12s">
        <VideoSlot
          src="/videos/where-the-name-comes-from.mp4"
          youtubeId="nsQ35ZgiWOk"
          ratio="16 / 9"
          title="Un hombre del Bronx por fin recibirá un trasplante de riñón tras años de espera — CBS News New York"
        />
        <figcaption>
          Cobertura independiente de{" "}
          <a href="https://www.cbsnews.com/newyork/news/kidney-transplant-kidney-chain-robert-sanchez-elizabeth-antosy/">CBS News New York</a>.
        </figcaption>
      </figure>

      <p class="linkline reveal" style="--reveal-delay:0.18s">
        Lee la historia completa en <a href={L("/about/team/")}>Nuestro equipo</a> · Lee la
        filosofía detrás en <a href={L("/storytelling/")}>El poder de las historias</a>
      </p>
    </div>
  </section>

  <section class="on-dark section-tight mv-band">
    <div class="container">
      <div class="mv-grid">
        <div class="mv-col reveal">
          <p class="mv-label">Misión</p>
          <p class="mv-statement">
            Promover la equidad en salud para las comunidades desatendidas educando a las personas
            sobre las enfermedades renales poco frecuentes — incluidas la GEFS y la enfermedad
            renal mediada por APOL1 — y construyendo las alianzas necesarias para cerrar la brecha
            en la atención renal.
          </p>
        </div>
        <div class="mv-col mv-col-divided reveal" style="--reveal-delay:0.08s">
          <p class="mv-label">Visión</p>
          <p class="mv-statement">
            Un futuro en el que el código postal de nadie determine su acceso a la educación sobre
            la salud renal, la detección temprana o la atención que salva vidas.
          </p>
        </div>
      </div>
    </div>
  </section>

  <figure class="wide-image wide-image-light wide-image-small reveal">
    <PhotoSlot src="/images/treeoflife.webp" alt="Unas manos ahuecadas que sostienen un árbol que crece a partir de un par de riñones" ratio="5 / 4" />
    <figcaption>Con raíces en el cuidado, creciendo hacia la equidad.</figcaption>
  </figure>

  <section class="on-light section-tight closer-section">
    <div class="container narrow">
      <p class="pull reveal closer">El lugar donde vives nunca debería decidir lo que sabes.</p>
      <p class="linkline reveal" style="--reveal-delay:0.06s">
        Más sobre <a href={L("/about/team/")}>quiénes están detrás de esto</a> y{" "}
        <a href={L("/about/what-we-do/")}>lo que hacemos día a día</a>.
      </p>
    </div>
  </section>

  <section class="on-dark section-tight cta-band">
    <div class="container cta-inner reveal">
      <h2 class="h2">Ayuda a promover la equidad en la atención renal.</h2>
      <div class="cluster gap-3" style="margin-top:var(--space-5);">
        <a href={L("/partner-with-us/")} class="btn btn-steel-outline">Colabora con nosotros</a>
        <a href={L("/donate/")} class="btn btn-rust">Donar</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 620px;
    margin-inline: auto;
    text-align: center;
  }

  /* ---------- Hero (photo only) ---------- */

  .about-hero {
    position: relative;
    min-height: 58vh;
    overflow: clip;
  }

  .about-hero-bg {
    position: absolute;
    inset: -16% 0;
    width: 100%;
    height: 132%;
    object-fit: cover;
    object-position: center 30%;
    will-change: transform;
  }

  .about-hero-tint {
    position: absolute;
    inset: 0;
    background: rgba(29, 42, 30, 0.22);
  }

  .about-hero-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
  }

  .about-hero-placeholder-note {
    max-width: 46ch;
    text-align: center;
    font-size: 13px;
    color: var(--ink-fg-muted);
  }

  .about-hero-placeholder-note code {
    font-family: var(--font-mono);
    font-size: 11.5px;
    background: rgba(255, 255, 255, 0.08);
    padding: 1px 5px;
    border-radius: 2px;
  }

  /* ---------- Top: ABOUT + one-line hook ---------- */

  .about-top {
    padding-top: 0;
    padding-bottom: clamp(var(--space-6), 5vw, var(--space-7));
  }

  .about-title {
    position: relative;
    top: -2.5rem;
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-weight: 700;
    /* "QUIÉNES SOMOS" is two long words — capped so both fit the reading
       column and centre cleanly (English "ABOUT" runs bigger on its own
       page). It still wraps to two centred lines on narrow viewports. */
    font-size: clamp(44px, 8vw, 104px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--ink);
    -webkit-text-stroke: 2px #fff;
    paint-order: stroke fill;
  }

  @media (max-width: 640px) {
    .about-title {
      top: -1.5rem;
    }
  }

  .hook {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(20px, 2.6vw, 26px);
    line-height: 1.4;
    color: var(--fg);
    max-width: 34ch;
    margin-inline: auto;
  }

  .press-mention {
    margin-top: var(--space-4);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--fg-muted);
  }

  .press-mention a {
    color: var(--steel);
  }

  /* ---------- Why / What / Where / How ---------- */

  .answers-section {
    padding-block: 0 clamp(var(--space-7), 6vw, var(--space-8));
  }

  .answers-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(28px, 4vw, 48px) clamp(32px, 5vw, 64px);
  }

  @media (max-width: 700px) {
    .answers-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .answer {
    border-top: 2px solid var(--ink);
    padding-top: var(--space-3);
    text-align: center;
  }

  .answer-q {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rust);
    margin: 0 0 var(--space-2);
  }

  .answer-a {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(18px, 2vw, 21px);
    line-height: 1.4;
    color: var(--fg);
    max-width: 32ch;
    margin-inline: auto;
  }

  /* ---------- Wide images ---------- */

  .wide-image {
    margin: 0 auto clamp(var(--space-7), 6vw, var(--space-8));
  }

  .wide-image :global(.photo-slot),
  .wide-image :global(.photo-slot-placeholder) {
    display: block;
  }

  .wide-image figcaption {
    margin-top: var(--space-3);
    padding-inline: clamp(20px, 5vw, 56px);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 15px;
    color: var(--fg-muted);
    text-align: center;
  }

  .wide-image-light {
    margin-top: clamp(var(--space-7), 6vw, var(--space-8));
    margin-bottom: 0;
  }

  .wide-image-small {
    max-width: 420px;
    padding-inline: 0;
  }

  .wide-image-small figcaption {
    padding-inline: 0;
  }

  .subway-image {
    max-width: 520px;
    /* Pulled tight to "El nombre" below — the big default wide-image gap
       left this photo stranded in whitespace. */
    margin-bottom: var(--space-4);
  }

  /* ---------- The Name ---------- */

  .name-section {
    margin-top: 0;
    padding-top: var(--space-5);
  }

  .story-video-figure {
    margin: var(--space-5) 0;
  }

  .story-video-figure figcaption {
    margin-top: var(--space-2);
    font-size: 12.5px;
    color: var(--fg-muted);
  }

  /* ---------- Mission / Vision ---------- */

  .mv-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
  }

  @media (max-width: 700px) {
    .mv-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .mv-col {
    text-align: center;
  }

  .mv-col-divided {
    border-left: 1px solid var(--ink-line);
    padding-left: clamp(32px, 6vw, 80px);
  }

  @media (max-width: 700px) {
    .mv-col-divided {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--ink-line);
      padding-top: var(--space-6);
    }
  }

  .mv-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--eyebrow-accent);
    margin: 0 0 var(--space-3);
  }

  .mv-statement {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(19px, 2vw, 23px);
    line-height: 1.4;
    color: var(--ink-fg);
    max-width: 36ch;
    margin-inline: auto;
  }

  /* ---------- Closer ---------- */

  .closer-section {
    text-align: center;
  }

  .closer {
    display: inline-block;
    border-left: none;
    padding-left: 0;
    font-size: clamp(24px, 3vw, 32px);
  }

  .closer-section .linkline {
    margin-top: var(--space-3);
  }

  .cta-inner {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const section = document.querySelector<HTMLElement>("[data-parallax-section]");
  const bg = document.querySelector<HTMLElement>("[data-parallax-bg]");

  if (section && bg && !prefersReducedMotion) {
    gsap.to(bg, {
      yPercent: 12,
      ease: "none",
      scrollTrigger: {
        trigger: section,
        start: "top top",
        end: "bottom top",
        scrub: true,
      },
    });
  }
</script>
