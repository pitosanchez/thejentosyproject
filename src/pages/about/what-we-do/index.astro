---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import PhotoSlot from "../../../components/PhotoSlot.astro";
---

<BaseLayout
  title="What We Do"
  description="The Jentosy Project's current work: education and outreach in the Bronx, expanding over time. Transplantation equity remains part of our long-term mission."
>
  <PageHero
    eyebrow="About · What We Do"
    heading="Education and outreach in the Bronx — expanding over time."
  />

  <section class="on-light section">
    <div class="container narrow">
      <p>
        Our current focus is education and health equity: reaching people before they reach the
        transplant list. We work to raise awareness of FSGS and APOL1-mediated kidney disease in
        communities where these diseases are under-discussed and under-diagnosed — starting in
        the Bronx.
      </p>
    </div>

    <div class="container">
      <div class="grid focus-grid">
        <div class="card card-steel reveal">
          <h3 class="h3">Community education</h3>
          <p>
            Plain-language resources on FSGS and APOL1-mediated kidney disease — built to reach
            people who won't find this information anywhere else.
          </p>
        </div>
        <div class="card card-steel reveal" style="--reveal-delay:0.1s">
          <h3 class="h3">Partnership building</h3>
          <p>
            Connecting researchers, healthcare organizations, and policymakers around the shared
            goal of closing the kidney-care gap in underserved communities.
          </p>
        </div>
        <a href="/where-we-live/" class="card card-rust reveal" style="--reveal-delay:0.2s">
          <h3 class="h3">Where We Live</h3>
          <p>
            One initiative under The Jentosy Project focused on place-based health data. It's part
            of our broader work, not the whole of it.
          </p>
          <span class="linkline" style="margin-top:var(--space-3); display:inline-block;">Learn more &rarr;</span>
        </a>
      </div>
    </div>

    <div class="container outreach-photo-row">
      <PhotoSlot src="/images/community-education.png" alt="A Jentosy Project community education session on kidney health" />
      <p class="linkline">A community education session on kidney health.</p>
    </div>
  </section>

  <section class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container narrow">
      <h2 class="h2" style="font-size:clamp(20px,2.4vw,26px);">Future work: transplantation equity</h2>
      <p>
        Transplantation equity remains part of our long-term mission — it's where this
        organization began, in our founder's own experience. As The Jentosy Project grows, we
        intend to build back toward that work directly. For now, our resources are focused
        upstream, on education and early awareness.
      </p>
    </div>
  </section>

  <section class="on-dark section-tight cta-band">
    <div class="container reveal" style="text-align:center;">
      <h2 class="h2">Help us reach more communities.</h2>
      <div class="cluster gap-3" style="justify-content:center; margin-top:var(--space-5);">
        <a href="/partner-with-us/" class="btn btn-steel-outline">Partner With Us</a>
        <a href="/donate/" class="btn btn-rust">Donate</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 700px;
  }

  .focus-grid {
    grid-template-columns: repeat(3, 1fr);
    margin-top: var(--space-6);
  }

  @media (max-width: 780px) {
    .focus-grid {
      grid-template-columns: 1fr;
    }
  }

  .outreach-photo-row {
    max-width: 460px;
    margin-top: var(--space-7);
  }

  .outreach-photo-row .linkline {
    margin-top: var(--space-3);
  }

  .focus-grid a.card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
  }

  .focus-grid a.card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 22px rgba(20, 33, 59, 0.12);
  }
</style>
