---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import NumberedSteps from "../../components/NumberedSteps.astro";

const steps = [
  {
    title: "Why education, not just transplantation.",
    body: "The Jentosy Project's work began with transplantation — but the deeper problem is upstream: too many people from underserved communities are diagnosed too late, or never learn they're at risk, for diseases like FSGS and APOL1-mediated kidney disease. That's why our current focus is education and health equity — reaching people before they reach the transplant list. Transplantation equity remains part of our long-term mission, and it's where we're headed next.",
  },
  {
    title: "Kidney disease doesn't happen in isolation.",
    body: "Kidney disease disparities are downstream of poverty, unequal access to education, incarceration, broken homes, and the chronic stress those conditions produce — all of which take a measurable toll on the body, including the kidneys. We start in the Bronx, where these conditions are concentrated, and we intend to expand as the organization grows.",
  },
];

const teasers = [
  {
    name: "Meet The Team",
    blurb: "Founder and CEO Robert Sanchez, and the board and staff joining him as the organization grows.",
    href: "/about/team/",
  },
  {
    name: "What We Do",
    blurb: "Education and outreach in the Bronx today — and the transplantation-equity work we're building back toward.",
    href: "/about/what-we-do/",
  },
];
---

<BaseLayout
  title="About"
  description="The Jentosy Project is a 501(c)(3) nonprofit advancing kidney health equity for underserved communities, starting in the Bronx."
>
  <PageHero
    eyebrow="About"
    heading="Advancing kidney health equity, starting in the Bronx."
    lede="The Jentosy Project is a 501(c)(3) public charity educating underserved communities about rare kidney disease and building the partnerships needed to close the gap in kidney care."
  />

  <section class="on-light section-tight">
    <div class="container narrow">
      <h2 class="h2 reveal">What The Jentosy Project is.</h2>
      <p class="reveal" style="--reveal-delay:0.06s">
        The Jentosy Project, Inc. is a 501(c)(3) public charity advancing health equity for
        underserved communities through kidney disease education and partnership. We focus on
        FSGS and APOL1-mediated kidney disease — two conditions that disproportionately affect
        Black and Brown communities and are too often diagnosed late, if at all.
      </p>
      <p class="reveal" style="--reveal-delay:0.12s">
        Our work starts in the Bronx, where the social conditions driving these disparities are
        concentrated, and is built to expand to underserved communities nationwide as the
        organization grows.
      </p>
    </div>
  </section>

  <section class="on-light section">
    <div class="container">
      <div class="mission-vision-grid">
        <div class="mv-col reveal">
          <p class="mv-label">Mission</p>
          <p class="mv-statement">
            The Jentosy Project advances health equity for underserved communities by educating
            people about rare kidney diseases — including FSGS and APOL1-mediated kidney disease
            — and building the partnerships needed to close the gap in kidney care.
          </p>
        </div>
        <div class="mv-col mv-col-divided reveal" style="--reveal-delay:0.08s">
          <p class="mv-label">Vision</p>
          <p class="mv-statement">
            A future where no one's zip code determines their access to kidney health
            education, early detection, or life-saving care — starting in the Bronx and
            expanding to underserved communities nationwide.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container narrow">
      <NumberedSteps steps={steps} />
    </div>
  </section>

  <!-- MORE ABOUT THE ORGANIZATION — teasers into the pages that used to be
       folded into this one: who's behind it, and what it does day to day. -->
  <section class="on-light section" style="border-top:1px solid var(--line);">
    <div class="container">
      <div class="grid teaser-grid">
        {teasers.map((t, i) => (
          <a href={t.href} class="card card-steel reveal teaser-card" style={`--reveal-delay:${i * 0.1}s`}>
            <h3 class="h3">{t.name}</h3>
            <p>{t.blurb}</p>
            <span class="read-more">Read more &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="on-dark section-tight cta-band">
    <div class="container cta-inner reveal">
      <h2 class="h2">Help advance health equity in kidney care.</h2>
      <div class="cluster gap-3" style="margin-top:var(--space-5);">
        <a href="/partner-with-us/" class="btn btn-steel-outline">Partner With Us</a>
        <a href="/donate/" class="btn btn-rust">Donate</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 700px;
  }

  /* ---------- Mission / Vision ---------- */

  .mission-vision-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
  }

  @media (max-width: 780px) {
    .mission-vision-grid {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
  }

  .mv-col-divided {
    border-left: 1px solid var(--line);
    padding-left: clamp(32px, 6vw, 80px);
  }

  @media (max-width: 780px) {
    .mv-col-divided {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--line);
      padding-top: var(--space-7);
    }
  }

  .mv-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rust);
    margin: 0 0 var(--space-4);
  }

  .mv-statement {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(18px, 1.8vw, 22px);
    line-height: 1.5;
    color: var(--fg);
    max-width: 34ch;
    margin: 0;
  }

  /* ---------- Teasers ---------- */

  .teaser-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (max-width: 640px) {
    .teaser-grid {
      grid-template-columns: 1fr;
    }
  }

  .teaser-card {
    text-decoration: none;
    color: inherit;
    transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
  }

  .teaser-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 22px rgba(16, 22, 28, 0.08);
  }

  .read-more {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: 13px;
    font-weight: 700;
    color: var(--steel);
  }

  .cta-inner {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }
</style>
