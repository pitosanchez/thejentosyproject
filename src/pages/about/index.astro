---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NumberedSteps from "../../components/NumberedSteps.astro";
import VideoSlot from "../../components/VideoSlot.astro";

const timeline = [
  { year: "2009", label: "First transplant, from a friend" },
  { year: "2014", label: "FSGS recurs; dialysis begins" },
  { year: "2019", label: "Matched, then cancer cancels surgery" },
  { year: "2021", label: "Transplanted via the donor chain" },
];

const steps = [
  {
    title: "Why education, not just transplantation.",
    body: "The Jentosy Project's work began with transplantation — but the deeper problem is upstream: too many people from underserved communities are diagnosed too late, or never learn they're at risk, for diseases like FSGS and APOL1-mediated kidney disease. That's why our current focus is education and health equity — reaching people before they reach the transplant list. Transplantation equity remains part of our long-term mission, and it's where we're headed next.",
  },
  {
    title: "Kidney disease doesn't happen in isolation.",
    body: "Kidney disease disparities are downstream of poverty, unequal access to education, incarceration, broken homes, and the chronic stress those conditions produce — all of which take a measurable toll on the body, including the kidneys. We start in the Bronx, where these conditions are concentrated and where our founder's own story began, and we intend to expand as the organization grows.",
  },
];
---

<BaseLayout
  title="About"
  description="The Jentosy Project's mission, vision, and the founder's story behind why our focus shifted from transplantation toward kidney disease education and health equity."
>
  <!-- FOUNDER + MISSION, IN ONE OPENING — the founder's story isn't a
       card bolted onto the About page, it's the reason the page exists.
       Grayscale photography, a bold statement line, and a hairline
       name/title bar (references: SpaceX leadership profile, b&w
       "leadership requires a worldview" portrait spread). -->
  <section class="on-dark founder-hero">
    <span class="side-label" aria-hidden="true">The Founder's Story</span>
    <div class="container founder-hero-inner">
      <div class="founder-hero-media reveal">
        <img
          class="founder-hero-photo"
          src="/images/founder-portrait.webp"
          alt="Robert Sanchez, founder of The Jentosy Project"
        />
        <img
          class="founder-hero-photo-inset"
          src="/images/founder-podium.webp"
          alt="Robert Sanchez speaking at a podium about kidney disease and health equity"
        />
      </div>

      <div class="founder-hero-text">
        <p class="eyebrow reveal">About The Jentosy Project</p>
        <h1 class="founder-hero-heading reveal" style="--reveal-delay:0.06s">
          One founder's story became an organization's mission.
        </h1>

        <p class="reveal" style="--reveal-delay:0.14s">
          In 2009, Robert Sanchez received his first kidney transplant — a living-donor kidney
          from a close friend. But FSGS, the rare disease that had already destroyed his own
          kidneys, recurred in the transplanted one, and by 2014 he was back on dialysis, three
          times a week. In 2019, out of options, he posted on Facebook asking if anyone knew
          someone willing to donate a kidney. Within about a week, organ matchmaker Chaya
          Lipschutz had found a potential match: Elizabeth Antosy. Then, the night before
          surgery, his transplant surgeon called with news that changed everything — Robert had
          kidney cancer, and the transplant could not go forward.
        </p>

        <div class="founder-hero-statement reveal" style="--reveal-delay:0.2s">
          <p class="founder-hero-statement-text">
            Two transplants. Two women who wouldn't give up.
          </p>
        </div>

        <p class="reveal" style="--reveal-delay:0.26s">
          Elizabeth was heartbroken — but instead of walking away, she joined a kidney exchange
          chain. Through it, Robert was matched with a new donor, Jen Keller, and after he
          cleared cancer, the two were transplanted on October 20, 2021. Elizabeth's decision to
          stay in the chain ultimately gave <strong>8 people</strong> new kidneys — and gave the
          organization her name and Jen's: <strong>The Jentosy Project</strong>.
        </p>

        <div class="founder-hero-footer reveal" style="--reveal-delay:0.32s">
          <div class="founder-hero-name">
            <p class="founder-hero-name-text">Robert Sanchez</p>
            <p class="founder-hero-name-title">Founder &amp; CEO</p>
          </div>
          <a href="#extended-story" class="linkline founder-hero-link">Read the extended story &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <section class="on-dark section-tight divider-dark" id="extended-story">
    <div class="container">
      <div class="timeline">
        {timeline.map((item, i) => (
          <div class="timeline-item" style={`--reveal-delay:${i * 0.1}s`}>
            <div class="timeline-year">{item.year}</div>
            <div class="timeline-label">{item.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container narrow">
      <h2 class="h2 reveal">Where the name comes from.</h2>

      <figure class="story-video-figure reveal" style="--reveal-delay:0.06s">
        <VideoSlot
          src="/videos/where-the-name-comes-from.mp4"
          youtubeId="nsQ35ZgiWOk"
          ratio="16 / 9"
          title="Bronx man finally getting kidney transplant after years of waiting — CBS News New York"
        />
        <figcaption>Robert on Jen, Elizabeth, and the chain that connected them.</figcaption>
      </figure>

      <p class="reveal" style="--reveal-delay:0.1s">
        <strong>The Jentosy Project</strong> is named for the two women who made that second
        transplant possible: <strong>Jen</strong> Keller, Robert's donor, and Elizabeth
        An<strong>tosy</strong>, whose decision to join the exchange chain made the match happen
        at all. The organization exists to pay their gift forward.
      </p>
      <p class="reveal" style="--reveal-delay:0.16s">
        That debt is why Robert has committed the rest of his career to this work — building the
        education, resources, and community he wishes had existed when he needed them most.
        Paying it forward isn't a slogan here; it's the reason The Jentosy Project exists at all.
      </p>
      <p class="linkline reveal" style="--reveal-delay:0.22s">
        Independently covered by
        <a href="https://www.cbsnews.com/newyork/news/kidney-transplant-kidney-chain-robert-sanchez-elizabeth-antosy/">CBS News New York</a>.
      </p>
    </div>
  </section>

  <!-- STORYTELLING — why this is the method, not just the origin. The
       podium photo backs this up: Robert telling this story in person
       is the method, not just an origin anecdote. -->
  <section class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container narrow">
      <h2 class="h2 reveal">A story is how this started. It's also the method.</h2>
      <p class="reveal" style="--reveal-delay:0.08s">
        Robert didn't set out to build a nonprofit. In 2019 he was out of options, and he did the
        only thing he could think to do: he told people, publicly and plainly, exactly what he
        needed. That single, honest post is what put him in front of Elizabeth — and eventually
        Jen. It worked because a real story, told without jargon, moves people in a way a
        statistic rarely does.
      </p>

      <figure class="podium-figure reveal" style="--reveal-delay:0.14s">
        <img
          class="podium-photo"
          src="/images/founder-podium.webp"
          alt="Robert Sanchez speaking at a podium about kidney disease and health equity"
        />
        <figcaption>Robert speaking publicly about kidney disease and health equity.</figcaption>
      </figure>

      <p class="reveal" style="--reveal-delay:0.2s">
        That's the idea The Jentosy Project is built on: storytelling as education. Rare kidney
        diseases like FSGS and APOL1-mediated kidney disease are almost always described in
        clinical language, if they're described at all — which means the people most at risk
        often don't recognize the warning signs until they're already in crisis. Real stories,
        told in plain language, teach what a pamphlet full of medical terms can't. The Jentosy
        Project exists to close that gap: putting those stories in front of
        <a href="/the-need/">the communities, clinicians, and partners who can act on them</a>,
        before a diagnosis becomes an emergency.
      </p>
      <p class="pull reveal" style="--reveal-delay:0.28s">
        Robert's story is the proof of concept. It's also the first of many this organization
        intends to tell.
      </p>
    </div>
  </section>

  <section class="on-light section">
    <div class="container">
      <div class="mission-vision-grid">
        <div class="mv-col reveal">
          <p class="mv-label">Mission</p>
          <p class="mv-statement">
            The Jentosy Project advances health equity for underserved communities by educating
            people about rare kidney diseases — including FSGS and APOL1-mediated kidney disease
            — and building the partnerships needed to close the gap in kidney care.
          </p>
        </div>
        <div class="mv-col mv-col-divided reveal" style="--reveal-delay:0.08s">
          <p class="mv-label">Vision</p>
          <p class="mv-statement">
            A future where no one's zip code determines their access to kidney health
            education, early detection, or life-saving care — starting in the Bronx and
            expanding to underserved communities nationwide.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container narrow">
      <NumberedSteps steps={steps} />
    </div>
  </section>

  <section class="on-dark section-tight cta-band">
    <div class="container cta-inner reveal">
      <h2 class="h2">Help extend what Jen and Elizabeth started.</h2>
      <div class="cluster gap-3" style="margin-top:var(--space-5);">
        <a href="/partner-with-us/" class="btn btn-steel-outline">Partner With Us</a>
        <a href="/donate/" class="btn btn-rust">Donate</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 700px;
  }

  /* ---------- Founder hero ---------- */

  .founder-hero {
    position: relative;
    overflow: clip;
  }

  .side-label {
    position: absolute;
    left: 22px;
    top: 50%;
    transform: translateY(-50%) rotate(-90deg);
    transform-origin: left center;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-fg-muted);
    white-space: nowrap;
    display: none;
  }

  @media (min-width: 1100px) {
    .side-label {
      display: block;
    }
  }

  .founder-hero-inner {
    display: grid;
    grid-template-columns: minmax(280px, 42%) 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
    padding-block: clamp(var(--space-8), 9vw, var(--space-9));
  }

  @media (min-width: 1100px) {
    .founder-hero-inner {
      padding-left: var(--space-7);
    }
  }

  @media (max-width: 860px) {
    .founder-hero-inner {
      grid-template-columns: 1fr;
    }
  }

  .founder-hero-media {
    position: relative;
  }

  .founder-hero-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-sm);
    filter: grayscale(1) contrast(1.08) brightness(0.96);
    transition: filter 0.6s var(--ease);
  }

  .founder-hero-media:hover .founder-hero-photo {
    filter: grayscale(0) contrast(1) brightness(1);
  }

  .founder-hero-photo-inset {
    position: absolute;
    right: -8%;
    bottom: -10%;
    width: 46%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 4px solid var(--ink);
    box-shadow: 0 20px 44px rgba(0, 0, 0, 0.45);
    filter: grayscale(1) contrast(1.08);
  }

  .founder-hero-text p {
    color: var(--ink-fg-muted);
  }

  .founder-hero-heading {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--ink-fg);
    max-width: 15ch;
    margin: 0 0 var(--space-5);
  }

  .founder-hero-statement {
    margin: var(--space-5) 0;
    padding-left: var(--space-5);
    border-left: 1px solid var(--rust);
  }

  .founder-hero-statement-text {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.3;
    color: var(--ink-fg);
    margin: 0;
  }

  .founder-hero-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--ink-line);
  }

  .founder-hero-name-text {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    color: var(--ink-fg);
    margin: 0;
  }

  .founder-hero-name-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-fg-muted);
    margin: var(--space-1) 0 0;
  }

  .founder-hero-link {
    color: var(--eyebrow-accent);
    font-weight: 700;
  }

  /* ---------- Where the name comes from (video figure) ---------- */

  .story-video-figure {
    margin: var(--space-5) 0 var(--space-6);
  }

  .story-video-figure figcaption {
    margin-top: var(--space-2);
    font-size: 12.5px;
    color: var(--fg-muted);
  }

  /* ---------- Extended story (podium figure) ---------- */

  .podium-figure {
    margin: var(--space-6) 0;
  }

  .podium-photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center 25%;
    border-radius: var(--radius-sm);
  }

  .podium-figure figcaption {
    margin-top: var(--space-2);
    font-size: 12.5px;
    color: var(--fg-muted);
  }

  /* ---------- Mission / Vision ---------- */

  .mission-vision-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
  }

  @media (max-width: 780px) {
    .mission-vision-grid {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
  }

  .mv-col-divided {
    border-left: 1px solid var(--line);
    padding-left: clamp(32px, 6vw, 80px);
  }

  @media (max-width: 780px) {
    .mv-col-divided {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--line);
      padding-top: var(--space-7);
    }
  }

  .mv-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rust);
    margin: 0 0 var(--space-4);
  }

  .mv-statement {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(18px, 1.8vw, 22px);
    line-height: 1.5;
    color: var(--fg);
    max-width: 34ch;
    margin: 0;
  }

  .cta-inner {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }
</style>
