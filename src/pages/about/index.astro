---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PhotoSlot from "../../components/PhotoSlot.astro";
import VideoSlot from "../../components/VideoSlot.astro";

const exists = (p: string) => fs.existsSync(path.join(process.cwd(), "public", p));
const heroExists = exists("images/safe.webp");

const answers = [
  {
    q: "Why",
    a: "Geography shouldn't decide who understands their own health risk. Education is the one thing that works before a diagnosis becomes an emergency.",
  },
  {
    q: "What",
    a: "We teach underserved communities about FSGS and APOL1-mediated kidney disease — in plain language, before it's too late to act on it.",
  },
  {
    q: "Where",
    a: "The Bronx first — one of the country's starkest examples of this disparity. Built to expand nationwide from here.",
  },
  {
    q: "How",
    a: "Education first, storytelling as the method. Lived experience changes minds that statistics alone can't reach.",
  },
];
---

<BaseLayout
  title="About"
  description="The Jentosy Project is a 501(c)(3) nonprofit advancing kidney health equity for underserved communities, starting in the Bronx."
>
  <!-- HERO — image only, no text on the photo. A light, flat tint keeps
       it feeling of a piece with the site without washing the photo out. -->
  <section class="on-dark about-hero" data-parallax-section>
    {heroExists ? (
      <img class="about-hero-bg" src="/images/safe.webp" alt="" aria-hidden="true" data-parallax-bg />
    ) : (
      <div class="about-hero-placeholder">
        <p class="about-hero-placeholder-note">
          Hero photo placeholder — drop <code>safe.webp</code> into <code>public/images/</code>{" "}
          and it'll appear here automatically.
        </p>
      </div>
    )}
    <div class="about-hero-tint"></div>
  </section>

  <!-- A FUNDER OR PARTNER SHOULD BE ABLE TO GET WHAT THEY NEED FROM THIS
       PAGE IN UNDER A MINUTE. One short hook, four short answers, one
       short emotional anchor (the name), two short quotable statements
       (mission/vision), done. Anyone who wants the long version has
       Meet The Team, What We Do, and the Storytelling essay to go to. -->
  <section class="on-light about-top">
    <div class="container narrow">
      <h1 class="about-title reveal">About</h1>

      <p class="hook reveal" style="--reveal-delay:0.1s">
        Kidney disease is often invisible until it isn't — and where you live can decide whether
        you see it coming. The Jentosy Project exists to change that.
      </p>
    </div>
  </section>

  <section class="on-light answers-section">
    <div class="container">
      <div class="answers-grid">
        {answers.map((item, i) => (
          <div class="answer reveal" style={`--reveal-delay:${i * 0.06}s`}>
            <p class="answer-q">{item.q}</p>
            <p class="answer-a">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <figure class="wide-image wide-image-small subway-image reveal">
    <PhotoSlot src="/images/NtX0s.webp" alt="A New York City subway sign reading Uptown & The Bronx Express, with the 4 and 5 line bullets" ratio="3 / 2" />
    <figcaption>A community, not a case study.</figcaption>
  </figure>

  <!-- THE NAME — the one story worth slowing down for, kept short; video
       carries the emotional weight instead of more paragraphs. -->
  <section class="on-light section name-section">
    <div class="container narrow">
      <p class="eyebrow reveal">The Name</p>
      <p class="reveal" style="--reveal-delay:0.06s">
        The Jentosy Project is named for <strong>Jen Keller</strong> and{" "}
        <strong>Elizabeth Antosy</strong> — two women whose decision to stay in a kidney exchange
        chain gave founder Robert Sanchez a second transplant, and gave eight strangers new
        kidneys.
      </p>

      <figure class="story-video-figure reveal" style="--reveal-delay:0.12s">
        <VideoSlot
          src="/videos/where-the-name-comes-from.mp4"
          youtubeId="nsQ35ZgiWOk"
          ratio="16 / 9"
          title="Bronx man finally getting kidney transplant after years of waiting — CBS News New York"
        />
        <figcaption>
          Independently covered by{" "}
          <a href="https://www.cbsnews.com/newyork/news/kidney-transplant-kidney-chain-robert-sanchez-elizabeth-antosy/">CBS News New York</a>.
        </figcaption>
      </figure>

      <p class="linkline reveal" style="--reveal-delay:0.18s">
        Read the full story on <a href="/about/team/">Meet The Team</a> · Read the philosophy
        behind it in <a href="/storytelling/">Storytelling as Medicine</a>
      </p>
    </div>
  </section>

  <!-- MISSION + VISION — the two lines worth remembering. -->
  <section class="on-dark section-tight mv-band">
    <div class="container">
      <div class="mv-grid">
        <div class="mv-col reveal">
          <p class="mv-label">Mission</p>
          <p class="mv-statement">
            Advance health equity for underserved communities by educating people about rare
            kidney diseases — including FSGS and APOL1-mediated kidney disease — and building the
            partnerships needed to close the gap in kidney care.
          </p>
        </div>
        <div class="mv-col mv-col-divided reveal" style="--reveal-delay:0.08s">
          <p class="mv-label">Vision</p>
          <p class="mv-statement">
            A future where no one's zip code determines their access to kidney health education,
            early detection, or life-saving care.
          </p>
        </div>
      </div>
    </div>
  </section>

  <figure class="wide-image wide-image-light wide-image-small reveal">
    <PhotoSlot src="/images/treeoflife.webp" alt="Cupped hands cradling a tree that grows from a pair of kidneys" ratio="5 / 4" />
    <figcaption>Rooted in care, growing toward equity.</figcaption>
  </figure>

  <section class="on-light section-tight closer-section">
    <div class="container narrow">
      <p class="pull reveal closer">Where you live should never decide what you know.</p>
      <p class="linkline reveal" style="--reveal-delay:0.06s">
        More on <a href="/about/team/">who's behind this</a> and{" "}
        <a href="/about/what-we-do/">what we do day to day</a>.
      </p>
    </div>
  </section>

  <section class="on-dark section-tight cta-band">
    <div class="container cta-inner reveal">
      <h2 class="h2">Help advance health equity in kidney care.</h2>
      <div class="cluster gap-3" style="margin-top:var(--space-5);">
        <a href="/partner-with-us/" class="btn btn-steel-outline">Partner With Us</a>
        <a href="/donate/" class="btn btn-rust">Donate</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 620px;
    margin-inline: auto;
    text-align: center;
  }

  /* ---------- Hero (photo only) ---------- */

  .about-hero {
    position: relative;
    min-height: 58vh;
    overflow: clip;
  }

  .about-hero-bg {
    position: absolute;
    inset: -16% 0;
    width: 100%;
    height: 132%;
    object-fit: cover;
    object-position: center 30%;
    will-change: transform;
  }

  .about-hero-tint {
    position: absolute;
    inset: 0;
    background: rgba(29, 42, 30, 0.22);
  }

  .about-hero-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
  }

  .about-hero-placeholder-note {
    max-width: 46ch;
    text-align: center;
    font-size: 13px;
    color: var(--ink-fg-muted);
  }

  .about-hero-placeholder-note code {
    font-family: var(--font-mono);
    font-size: 11.5px;
    background: rgba(255, 255, 255, 0.08);
    padding: 1px 5px;
    border-radius: 2px;
  }

  /* ---------- Top: ABOUT + one-line hook ---------- */

  .about-top {
    padding-top: 0;
    padding-bottom: clamp(var(--space-6), 5vw, var(--space-7));
  }

  .about-title {
    position: relative;
    top: -4rem;
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(72px, 13vw, 180px);
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--ink);
    -webkit-text-stroke: 2px #fff;
    paint-order: stroke fill;
  }

  @media (max-width: 640px) {
    .about-title {
      top: -2rem;
    }
  }

  .hook {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(20px, 2.6vw, 26px);
    line-height: 1.4;
    color: var(--fg);
    max-width: 34ch;
    margin-inline: auto;
  }

  /* ---------- Why / What / Where / How ---------- */

  .answers-section {
    padding-block: 0 clamp(var(--space-7), 6vw, var(--space-8));
  }

  .answers-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(28px, 4vw, 48px) clamp(32px, 5vw, 64px);
  }

  @media (max-width: 700px) {
    .answers-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .answer {
    border-top: 2px solid var(--ink);
    padding-top: var(--space-3);
    text-align: center;
  }

  .answer-q {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rust);
    margin: 0 0 var(--space-2);
  }

  .answer-a {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(18px, 2vw, 21px);
    line-height: 1.4;
    color: var(--fg);
    max-width: 32ch;
    margin-inline: auto;
  }

  /* ---------- Wide images ---------- */

  .wide-image {
    margin: 0 auto clamp(var(--space-7), 6vw, var(--space-8));
  }

  .wide-image :global(.photo-slot),
  .wide-image :global(.photo-slot-placeholder) {
    display: block;
  }

  .wide-image figcaption {
    margin-top: var(--space-3);
    padding-inline: clamp(20px, 5vw, 56px);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 15px;
    color: var(--fg-muted);
    text-align: center;
  }

  .wide-image-light {
    margin-top: clamp(var(--space-7), 6vw, var(--space-8));
    margin-bottom: 0;
  }

  /* treeoflife.webp's source file is only 462x368 — stretched to a full
     21:9 banner it was being upscaled well past its real resolution,
     which is what read as pixelated. Capped near its native size
     instead, so the browser is barely scaling it at all. */
  .wide-image-small {
    max-width: 420px;
    padding-inline: 0;
  }

  .wide-image-small figcaption {
    padding-inline: 0;
  }

  .subway-image {
    max-width: 520px;
  }

  /* ---------- The Name ---------- */

  .name-section {
    margin-top: -7.5px;
  }

  .story-video-figure {
    margin: var(--space-5) 0;
  }

  .story-video-figure figcaption {
    margin-top: var(--space-2);
    font-size: 12.5px;
    color: var(--fg-muted);
  }

  /* ---------- Mission / Vision ---------- */

  .mv-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
  }

  @media (max-width: 700px) {
    .mv-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .mv-col {
    text-align: center;
  }

  .mv-col-divided {
    border-left: 1px solid var(--ink-line);
    padding-left: clamp(32px, 6vw, 80px);
  }

  @media (max-width: 700px) {
    .mv-col-divided {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--ink-line);
      padding-top: var(--space-6);
    }
  }

  .mv-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--eyebrow-accent);
    margin: 0 0 var(--space-3);
  }

  .mv-statement {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(19px, 2vw, 23px);
    line-height: 1.4;
    color: var(--ink-fg);
    max-width: 36ch;
    margin-inline: auto;
  }

  /* ---------- Closer ---------- */

  .closer-section {
    text-align: center;
  }

  .closer {
    display: inline-block;
    border-left: none;
    padding-left: 0;
    font-size: clamp(24px, 3vw, 32px);
  }

  .closer-section .linkline {
    margin-top: var(--space-3);
  }

  .cta-inner {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const section = document.querySelector<HTMLElement>("[data-parallax-section]");
  const bg = document.querySelector<HTMLElement>("[data-parallax-bg]");

  // Gentle big-story parallax on the hero photo only — the image is sized
  // larger than its box (see .about-hero-bg) so the drift never reveals
  // empty space at the edges.
  if (section && bg && !prefersReducedMotion) {
    gsap.to(bg, {
      yPercent: 12,
      ease: "none",
      scrollTrigger: {
        trigger: section,
        start: "top top",
        end: "bottom top",
        scrub: true,
      },
    });
  }
</script>
