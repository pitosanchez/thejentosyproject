---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NumberedSteps from "../../components/NumberedSteps.astro";
import PhotoSlot from "../../components/PhotoSlot.astro";
import VideoSlot from "../../components/VideoSlot.astro";

const heroExists = fs.existsSync(path.join(process.cwd(), "public", "images/safe.webp"));

const steps = [
  {
    title: "Why education, not just transplantation.",
    body: "This organization began with transplantation. But the deeper problem is upstream — too many people in underserved communities are diagnosed too late, or never learn they're at risk, for diseases like FSGS and APOL1-mediated kidney disease. Education comes first: reaching people before they reach the transplant list. Transplantation equity remains part of the long-term mission — it's where we're headed next.",
  },
  {
    title: "Kidney disease doesn't happen in isolation.",
    body: "Kidney disease disparities trace back to poverty, unequal access to education, incarceration, and the chronic stress those conditions produce. All of it takes a measurable toll on the body, including the kidneys. We start where these conditions are concentrated — the Bronx — and expand from there.",
  },
];

const teasers = [
  {
    name: "Meet The Team",
    blurb: "Founder and CEO Robert Sanchez, and the board and staff joining him as the organization grows.",
    href: "/about/team/",
  },
  {
    name: "What We Do",
    blurb: "Education and outreach in the Bronx today — and the transplantation-equity work we're building back toward.",
    href: "/about/what-we-do/",
  },
];
---

<BaseLayout
  title="About"
  description="The Jentosy Project is a 501(c)(3) nonprofit advancing kidney health equity for underserved communities, starting in the Bronx."
>
  <!-- BIG EDITORIAL HERO — a large-format opener in the spirit of a NYT
       feature: a full-bleed photo with a slow GSAP parallax drift (see
       script below), and "ABOUT" set huge along the left edge instead of
       a small eyebrow. Falls back to a plain dark hero with no broken
       image if safe.webp hasn't been dropped in yet. -->
  <section class="on-dark about-hero" data-parallax-section>
    {heroExists ? (
      <img class="about-hero-bg" src="/images/safe.webp" alt="" aria-hidden="true" data-parallax-bg />
    ) : null}
    <div class="about-hero-scrim"></div>
    <div class="container about-hero-inner">
      <p class="about-hero-kicker reveal" aria-hidden="true">About</p>
      <h1 class="h1 reveal" style="--reveal-delay:0.08s">
        Advancing kidney health equity — starting in the Bronx.
      </h1>
      <p class="lede reveal" style="--reveal-delay:0.16s">
        The Jentosy Project is a 501(c)(3) nonprofit closing the kidney-care gap for underserved
        communities through education and partnership.
      </p>
      {!heroExists && (
        <p class="about-hero-placeholder-note reveal" style="--reveal-delay:0.22s">
          Hero photo placeholder — drop <code>safe.webp</code> into <code>public/images/</code>{" "}
          and it'll appear here automatically.
        </p>
      )}
    </div>
  </section>

  <section class="on-light section-tight">
    <div class="container narrow">
      <h2 class="h2 reveal">What The Jentosy Project is.</h2>
      <p class="reveal" style="--reveal-delay:0.06s">
        The Jentosy Project focuses on two conditions that disproportionately affect Black and
        Brown communities and are too often diagnosed late, if at all: FSGS and APOL1-mediated
        kidney disease.
      </p>
      <p class="reveal" style="--reveal-delay:0.12s">
        The work starts in the Bronx, where the social conditions driving these disparities are
        concentrated — and is built to expand nationwide as the organization grows.
      </p>
    </div>
  </section>

  <!-- WHERE THE NAME COMES FROM -->
  <section class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container narrow">
      <h2 class="h2 reveal">Where the name comes from.</h2>

      <figure class="story-video-figure reveal" style="--reveal-delay:0.06s">
        <VideoSlot
          src="/videos/where-the-name-comes-from.mp4"
          youtubeId="nsQ35ZgiWOk"
          ratio="16 / 9"
          title="Bronx man finally getting kidney transplant after years of waiting — CBS News New York"
        />
        <figcaption>Robert on Jen, Elizabeth, and the chain that connected them.</figcaption>
      </figure>

      <p class="reveal" style="--reveal-delay:0.1s">
        <strong>Jen</strong> Keller and Elizabeth An<strong>tosy</strong> — two donors whose
        decision to stay in a kidney exchange chain gave the organization its name, along with a
        debt Robert has spent his career trying to repay.
      </p>
      <p class="linkline reveal" style="--reveal-delay:0.16s">
        Independently covered by
        <a href="https://www.cbsnews.com/newyork/news/kidney-transplant-kidney-chain-robert-sanchez-elizabeth-antosy/">CBS News New York</a>.
        Read the founder's full story on the
        <a href="/about/team/">Meet The Team</a> page.
      </p>
    </div>
  </section>

  <!-- IMAGE BREAK — a full-width editorial pause between the org's origin
       and its reasoning, the way a big magazine feature lets a photo
       breathe before the next section. -->
  <section class="on-light image-break">
    <div class="container">
      <div class="image-break-frame">
        <div class="image-break-photo">
          <PhotoSlot src="/images/treeoflife.webp" alt="Hands cradling a tree growing from a pair of kidneys, rooted in care" ratio="21 / 9" />
          <p class="image-break-caption">Rooted in care, growing toward equity.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="on-light section">
    <div class="container">
      <div class="mission-vision-grid">
        <div class="mv-col reveal">
          <p class="mv-label">Mission</p>
          <p class="mv-statement">
            The Jentosy Project advances health equity for underserved communities by educating
            people about rare kidney diseases — including FSGS and APOL1-mediated kidney disease
            — and building the partnerships needed to close the gap in kidney care.
          </p>
        </div>
        <div class="mv-col mv-col-divided reveal" style="--reveal-delay:0.08s">
          <p class="mv-label">Vision</p>
          <p class="mv-statement">
            A future where no one's zip code determines their access to kidney health
            education, early detection, or life-saving care — starting in the Bronx and
            expanding to underserved communities nationwide.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container narrow">
      <NumberedSteps steps={steps} />
    </div>
  </section>

  <!-- MORE ABOUT THE ORGANIZATION — teasers into the pages that used to be
       folded into this one: who's behind it, and what it does day to day. -->
  <section class="on-light section" style="border-top:1px solid var(--line);">
    <div class="container">
      <div class="grid teaser-grid">
        {teasers.map((t, i) => (
          <a href={t.href} class="card card-steel reveal teaser-card" style={`--reveal-delay:${i * 0.1}s`}>
            <h3 class="h3">{t.name}</h3>
            <p>{t.blurb}</p>
            <span class="read-more">Read more &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="on-dark section-tight cta-band">
    <div class="container cta-inner reveal">
      <h2 class="h2">Help advance health equity in kidney care.</h2>
      <div class="cluster gap-3" style="margin-top:var(--space-5);">
        <a href="/partner-with-us/" class="btn btn-steel-outline">Partner With Us</a>
        <a href="/donate/" class="btn btn-rust">Donate</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 700px;
  }

  /* ---------- Big editorial hero ---------- */

  .about-hero {
    position: relative;
    min-height: 76vh;
    display: flex;
    align-items: center;
    overflow: clip;
  }

  .about-hero-bg {
    position: absolute;
    inset: -16% 0;
    width: 100%;
    height: 132%;
    object-fit: cover;
    object-position: center 30%;
    will-change: transform;
  }

  .about-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(29,42,30,0.62) 0%, rgba(29,42,30,0.5) 45%, rgba(29,42,30,0.82) 100%);
  }

  /* The big "About" — sits between the hero photo and the headline
     line, not off to the side, so the read is: photo, then ABOUT, then
     the headline underneath it. Bigger than the headline itself so it
     reads as the section's title, the way a magazine feature names
     itself before its subhead. */
  .about-hero-kicker {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(52px, 9vw, 128px);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--ink-fg);
    margin: 0 0 var(--space-3);
  }

  .about-hero-inner {
    position: relative;
    z-index: 2;
    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
    max-width: 760px;
  }

  .about-hero-placeholder-note {
    margin-top: var(--space-4);
    font-size: 12.5px;
    color: var(--ink-fg-muted);
  }

  .about-hero-placeholder-note code {
    font-family: var(--font-mono);
    font-size: 11.5px;
    background: rgba(255, 255, 255, 0.08);
    padding: 1px 5px;
    border-radius: 2px;
  }

  /* ---------- Where the name comes from (video figure) ---------- */

  .story-video-figure {
    margin: var(--space-5) 0 var(--space-6);
  }

  .story-video-figure figcaption {
    margin-top: var(--space-2);
    font-size: 12.5px;
    color: var(--fg-muted);
  }

  /* ---------- Image break ---------- */

  .image-break {
    padding-block: clamp(var(--space-6), 5vw, var(--space-7));
  }

  /* A picture-frame treatment: a mat of --card around the photo, plus a
     hairline border and a soft shadow for a bit of lift off the page. */
  .image-break-frame {
    background: var(--card);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    padding: clamp(10px, 1.6vw, 20px);
    box-shadow: 0 12px 30px rgba(16, 22, 28, 0.1);
  }

  .image-break-photo {
    position: relative;
  }

  .image-break-photo :global(.photo-slot) {
    display: block;
  }

  .image-break-caption {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-4);
    max-width: 60%;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(17px, 2vw, 22px);
    line-height: 1.3;
    color: #fff;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.55), 0 1px 3px rgba(0, 0, 0, 0.5);
    margin: 0;
  }

  /* ---------- Mission / Vision ---------- */

  .mission-vision-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
  }

  @media (max-width: 780px) {
    .mission-vision-grid {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
  }

  .mv-col-divided {
    border-left: 1px solid var(--line);
    padding-left: clamp(32px, 6vw, 80px);
  }

  @media (max-width: 780px) {
    .mv-col-divided {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--line);
      padding-top: var(--space-7);
    }
  }

  .mv-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rust);
    margin: 0 0 var(--space-4);
  }

  .mv-statement {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(18px, 1.8vw, 22px);
    line-height: 1.5;
    color: var(--fg);
    max-width: 34ch;
    margin: 0;
  }

  /* ---------- Teasers ---------- */

  .teaser-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (max-width: 640px) {
    .teaser-grid {
      grid-template-columns: 1fr;
    }
  }

  .teaser-card {
    text-decoration: none;
    color: inherit;
    transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
  }

  .teaser-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 22px rgba(16, 22, 28, 0.08);
  }

  .read-more {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: 13px;
    font-weight: 700;
    color: var(--steel);
  }

  .cta-inner {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const section = document.querySelector<HTMLElement>("[data-parallax-section]");
  const bg = document.querySelector<HTMLElement>("[data-parallax-bg]");

  // Classic big-story parallax: the photo drifts slower than the page
  // scrolls past it. The image is sized/inset larger than its box (see
  // .about-hero-bg) so the drift never reveals empty space at the edges.
  if (section && bg && !prefersReducedMotion) {
    gsap.to(bg, {
      yPercent: 14,
      ease: "none",
      scrollTrigger: {
        trigger: section,
        start: "top top",
        end: "bottom top",
        scrub: true,
      },
    });
  }
</script>
