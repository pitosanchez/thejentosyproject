---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PhotoSlot from "../../components/PhotoSlot.astro";
import VideoSlot from "../../components/VideoSlot.astro";

const exists = (p: string) => fs.existsSync(path.join(process.cwd(), "public", p));
const heroExists = exists("images/safe.webp");

// "How We Work" — the six kinds of knowledge the org brings together.
const method = [
  { term: "Kidney-health education", note: "Plain-language explanations of what is actually happening in the body." },
  { term: "Data", note: "Population-level surveillance — and the gaps in it." },
  { term: "Geography", note: "Where disease burden, referrals, and resources cluster." },
  { term: "Research", note: "What the peer-reviewed literature does and doesn't establish." },
  { term: "Partnerships", note: "Researchers, health systems, and policymakers around one goal." },
  { term: "Patient storytelling", note: "Lived experience as a form of evidence." },
];
---

<BaseLayout
  title="About"
  description="The Jentosy Project is a 501(c)(3) nonprofit advancing kidney health equity for underserved communities, starting in the Bronx — founded by a two-time transplant recipient."
>
  <!-- HERO — image only, a light flat tint keeps it of a piece with the site. -->
  <section class="on-dark about-hero" data-parallax-section>
    {heroExists ? (
      <img class="about-hero-bg" src="/images/safe.webp" alt="" aria-hidden="true" data-parallax-bg />
    ) : (
      <div class="about-hero-placeholder">
        <p class="about-hero-placeholder-note">
          Hero photo placeholder — drop <code>safe.webp</code> into <code>public/images/</code>{" "}
          and it'll appear here automatically.
        </p>
      </div>
    )}
    <div class="about-hero-tint"></div>
  </section>

  <!-- ============ WHY WE EXIST — the founder's statement ============
       This is the page's centre of gravity: a signed, first-person note.
       Left-aligned and asymmetric on purpose — it should read as a person
       speaking, not as another centred marketing block. -->
  <section class="on-light founders-note">
    <div class="container">
      <h1 class="about-title reveal">About</h1>
      <div class="founders-note-inner">
        <span class="founders-note-mark" aria-hidden="true">&ldquo;</span>
        <p class="eyebrow reveal">Why We Exist</p>
        <p class="founders-note-lead reveal">
          I created The Jentosy Project because I know what it feels like to have kidney disease
          and not fully understand what is happening to you.
        </p>
        <p class="founders-note-body reveal" style="--reveal-delay:0.06s">
          Too many people receive the information they need only after they are already facing
          serious disease. I believe communities deserve understandable information earlier — and
          that where people live, what they are exposed to, and what resources they can access
          must be part of how we understand kidney health.
        </p>
        <div class="founders-note-sign reveal" style="--reveal-delay:0.12s">
          <img
            class="founders-note-portrait"
            src="/images/founder-portrait.webp"
            alt="Robert Sanchez, founder of The Jentosy Project"
          />
          <div>
            <p class="founders-note-name">Robert Sanchez</p>
            <p class="founders-note-role">Founder &amp; CEO · Two-time kidney transplant recipient</p>
          </div>
        </div>
        <p class="founders-note-press reveal" style="--reveal-delay:0.16s">
          <a href="https://www.cbsnews.com/newyork/news/kidney-transplant-kidney-chain-robert-sanchez-elizabeth-antosy/">
            His story was independently reported by CBS News New York &rarr;
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- Full-bleed image beat -->
  <figure class="bleed-figure reveal">
    <PhotoSlot src="/images/movement.webp" alt="An illustration of people moving together toward a shared horizon" ratio="3.4 / 1" />
    <figcaption>A movement, not a moment.</figcaption>
  </figure>

  <!-- ============ HOW WE WORK — the method ============ -->
  <section class="on-dark method-band">
    <div class="container">
      <p class="eyebrow reveal">How We Work</p>
      <p class="method-lead reveal">
        We bring together kidney-health education, data, geography, research, partnerships, and
        patient storytelling — to better understand where disparities exist and what communities
        need.
      </p>
      <ol class="method-list">
        {method.map((m, i) => (
          <li class="method-item reveal" style={`--reveal-delay:${i * 0.05}s`}>
            <span class="method-num">{String(i + 1).padStart(2, "0")}</span>
            <p class="method-term">{m.term}</p>
            <p class="method-note">{m.note}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ THE NAME ============ -->
  <section class="on-light section name-section">
    <div class="container narrow">
      <p class="eyebrow reveal">The Name</p>
      <p class="reveal" style="--reveal-delay:0.06s">
        The Jentosy Project is named for <strong>Jen Keller</strong> and{" "}
        <strong>Elizabeth Antosy</strong> — two women whose decision to stay in a kidney exchange
        chain gave founder Robert Sanchez a second transplant, and gave eight strangers new
        kidneys.
      </p>

      <figure class="story-video-figure reveal" style="--reveal-delay:0.12s">
        <VideoSlot
          src="/videos/where-the-name-comes-from.mp4"
          youtubeId="nsQ35ZgiWOk"
          ratio="16 / 9"
          title="Bronx man finally getting kidney transplant after years of waiting — CBS News New York"
        />
        <figcaption>
          Independently covered by{" "}
          <a href="https://www.cbsnews.com/newyork/news/kidney-transplant-kidney-chain-robert-sanchez-elizabeth-antosy/">CBS News New York</a>.
        </figcaption>
      </figure>

      <p class="linkline reveal" style="--reveal-delay:0.18s">
        Read the full story on <a href="/about/team/">Meet The Team</a> · Read the philosophy
        behind it in <a href="/storytelling/">Storytelling as Medicine</a>
      </p>
    </div>
  </section>

  <!-- ============ MISSION + VISION (locked copy — ticket 02) ============ -->
  <section class="on-dark section-tight mv-band">
    <div class="container">
      <div class="mv-grid">
        <div class="mv-col reveal">
          <p class="mv-label">Mission</p>
          <p class="mv-statement">
            Advance health equity for underserved communities by educating people about rare
            kidney diseases — including FSGS and APOL1-mediated kidney disease — and building the
            partnerships needed to close the gap in kidney care.
          </p>
        </div>
        <div class="mv-col mv-col-divided reveal" style="--reveal-delay:0.08s">
          <p class="mv-label">Vision</p>
          <p class="mv-statement">
            A future where no one's zip code determines their access to kidney health education,
            early detection, or life-saving care.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CLOSER ============ -->
  <section class="on-light section closer-section">
    <div class="container closer-inner">
      <figure class="closer-figure reveal">
        <PhotoSlot src="/images/treeoflife.webp" alt="Cupped hands cradling a tree that grows from a pair of kidneys" ratio="5 / 4" />
      </figure>
      <div class="closer-text">
        <p class="pull reveal closer-line">Where you live should never decide what you know.</p>
        <p class="linkline reveal" style="--reveal-delay:0.06s">
          More on <a href="/about/what-we-do/">what we do day to day</a> and{" "}
          <a href="/about/team/">who's behind this</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="on-dark section-tight cta-band">
    <div class="container cta-inner reveal">
      <h2 class="h2">Help advance health equity in kidney care.</h2>
      <div class="cluster gap-3" style="margin-top:var(--space-5);">
        <a href="/partner-with-us/" class="btn btn-steel-outline">Partner With Us</a>
        <a href="/donate/" class="btn btn-rust">Donate</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 640px;
    margin-inline: auto;
  }

  /* ---------- Hero (photo only) ---------- */

  .about-hero {
    position: relative;
    min-height: 46vh;
    overflow: clip;
  }

  .about-hero-bg {
    position: absolute;
    inset: -16% 0;
    width: 100%;
    height: 132%;
    object-fit: cover;
    object-position: center 30%;
    will-change: transform;
  }

  .about-hero-tint {
    position: absolute;
    inset: 0;
    background: rgba(29, 42, 30, 0.22);
  }

  .about-hero-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
  }

  .about-hero-placeholder-note {
    max-width: 46ch;
    text-align: center;
    font-size: 13px;
    color: var(--ink-fg-muted);
  }

  .about-hero-placeholder-note code {
    font-family: var(--font-mono);
    font-size: 11.5px;
    background: rgba(255, 255, 255, 0.08);
    padding: 1px 5px;
    border-radius: 2px;
  }

  /* ---------- Why We Exist: the founder's note ---------- */

  .founders-note {
    padding-top: 0;
    padding-bottom: clamp(var(--space-7), 7vw, var(--space-9));
  }

  .about-title {
    position: relative;
    top: -3rem;
    margin: 0 0 clamp(var(--space-4), 4vw, var(--space-7));
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(64px, 12vw, 168px);
    line-height: 1;
    letter-spacing: -0.01em;
    text-align: center;
    text-transform: uppercase;
    color: var(--ink);
    -webkit-text-stroke: 2px var(--paper);
    paint-order: stroke fill;
  }

  @media (max-width: 640px) {
    .about-title {
      top: -1.75rem;
    }
  }

  .founders-note-inner {
    position: relative;
    max-width: 780px;
  }

  .founders-note-mark {
    position: absolute;
    left: -0.12em;
    top: -0.62em;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(90px, 12vw, 150px);
    line-height: 1;
    color: var(--rust);
    opacity: 0.16;
    pointer-events: none;
  }

  .founders-note .eyebrow {
    margin-bottom: var(--space-4);
  }

  .founders-note-lead {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(25px, 3.3vw, 40px);
    line-height: 1.3;
    color: var(--fg);
    margin: 0 0 var(--space-5);
    max-width: 20ch;
  }

  @media (min-width: 620px) {
    .founders-note-lead {
      max-width: 34ch;
    }
  }

  .founders-note-body {
    font-size: clamp(16px, 1.55vw, 18.5px);
    line-height: 1.7;
    color: var(--fg-soft);
    max-width: 60ch;
    margin: 0;
  }

  .founders-note-sign {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .founders-note-portrait {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 20%;
    flex-shrink: 0;
    filter: grayscale(1) contrast(1.06);
  }

  .founders-note-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    color: var(--fg);
    margin: 0;
  }

  .founders-note-role {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: var(--space-1) 0 0;
  }

  .founders-note-press {
    margin: var(--space-4) 0 0;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .founders-note-press a {
    color: var(--steel);
  }

  /* ---------- Full-bleed image beat ---------- */

  .bleed-figure {
    margin: 0;
  }

  .bleed-figure :global(.photo-slot),
  .bleed-figure :global(.photo-slot-placeholder) {
    display: block;
    border-radius: 0;
  }

  .bleed-figure figcaption {
    text-align: center;
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 15px;
    color: var(--fg-muted);
  }

  /* ---------- How We Work: the method ---------- */

  .method-band {
    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
  }

  .method-lead {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(19px, 2.3vw, 26px);
    line-height: 1.5;
    color: var(--ink-fg);
    max-width: 40ch;
    margin: 0 0 var(--space-7);
  }

  .method-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6) var(--space-6);
  }

  @media (max-width: 860px) {
    .method-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .method-list {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }

  .method-item {
    border-top: 1px solid var(--ink-line-strong);
    padding-top: var(--space-3);
  }

  .method-num {
    font-family: var(--font-display);
    font-weight: 600;
    font-style: italic;
    font-size: 22px;
    line-height: 1;
    color: var(--eyebrow-accent);
  }

  .method-term {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(18px, 1.9vw, 21px);
    color: var(--ink-fg);
    margin: var(--space-2) 0 var(--space-1);
  }

  .method-note {
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-fg-muted);
    margin: 0;
  }

  /* ---------- The Name ---------- */

  .name-section .eyebrow,
  .name-section p {
    text-align: center;
  }

  .story-video-figure {
    margin: var(--space-5) 0;
  }

  .story-video-figure figcaption {
    margin-top: var(--space-2);
    font-size: 12.5px;
    color: var(--fg-muted);
    text-align: center;
  }

  /* ---------- Mission / Vision ---------- */

  .mv-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
  }

  @media (max-width: 700px) {
    .mv-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .mv-col-divided {
    border-left: 1px solid var(--ink-line);
    padding-left: clamp(32px, 6vw, 80px);
  }

  @media (max-width: 700px) {
    .mv-col-divided {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--ink-line);
      padding-top: var(--space-6);
    }
  }

  .mv-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--eyebrow-accent);
    margin: 0 0 var(--space-3);
  }

  .mv-statement {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(19px, 2vw, 23px);
    line-height: 1.4;
    color: var(--ink-fg);
    max-width: 38ch;
    margin: 0;
  }

  /* ---------- Closer ---------- */

  .closer-inner {
    display: grid;
    grid-template-columns: minmax(220px, 320px) 1fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }

  @media (max-width: 720px) {
    .closer-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .closer-figure {
      max-width: 300px;
      margin-inline: auto;
    }
  }

  .closer-figure {
    margin: 0;
  }

  .closer-line {
    font-size: clamp(24px, 3.2vw, 34px);
    margin: 0 0 var(--space-3);
  }

  @media (max-width: 720px) {
    .closer-line {
      border-left: none;
      padding-left: 0;
    }
  }

  .cta-inner {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const section = document.querySelector<HTMLElement>("[data-parallax-section]");
  const bg = document.querySelector<HTMLElement>("[data-parallax-bg]");

  if (section && bg && !prefersReducedMotion) {
    gsap.to(bg, {
      yPercent: 12,
      ease: "none",
      scrollTrigger: {
        trigger: section,
        start: "top top",
        end: "bottom top",
        scrub: true,
      },
    });
  }
</script>
