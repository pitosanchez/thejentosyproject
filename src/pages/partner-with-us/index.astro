---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";

const audiences = [
  {
    slug: "funder",
    name: "Funders & Foundations",
    pitch:
      "Support an organization led by lived experience, with a clear, credibility-first approach to closing the kidney-care gap in underserved communities.",
    option: "Funder / Foundation",
  },
  {
    slug: "researcher",
    name: "Researchers & Research Institutions",
    pitch:
      "Partner on education, awareness, and community engagement around FSGS and APOL1-mediated kidney disease.",
    option: "Researcher / Research Institution",
  },
  {
    slug: "healthcare",
    name: "Healthcare Organizations",
    pitch:
      "Collaborate on reaching underserved patients earlier — before diseases like FSGS progress to dialysis or transplant.",
    option: "Healthcare Organization",
  },
  {
    slug: "policymaker",
    name: "Policymakers",
    pitch:
      "Work with us on the systemic, upstream drivers of kidney disease disparities — from healthcare access to housing and education.",
    option: "Policymaker",
  },
];

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;
---

<BaseLayout
  title="Partner With Us"
  description="Partner with The Jentosy Project — funders, researchers, healthcare organizations, and policymakers working to close the kidney-care gap."
>
  <PageHero
    eyebrow="Partner With Us"
    heading="Institutional partnerships that close the kidney-care gap."
  />

  <section class="on-light section">
    <div class="container">
      <div class="grid audience-grid">
        {audiences.map((a, i) => (
          <div class="card card-steel reveal audience-card" id={a.slug} style={`--reveal-delay:${i * 0.08}s`}>
            <h3 class="h3">{a.name}</h3>
            <p>{a.pitch}</p>
            <a href="#start" class="linkline audience-card-cta" data-audience={a.slug}>
              Start the conversation &rarr;
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="start" class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container narrow">
      <h2 class="h2" style="font-size:clamp(20px,2.4vw,26px);">Start the conversation</h2>
      <p>Tell us a bit about your organization and how you'd like to partner.</p>

      {!accessKey && (
        <p class="form-unconfigured-note">
          This form isn't connected yet — set <code>PUBLIC_WEB3FORMS_ACCESS_KEY</code> to enable it.
        </p>
      )}

      <form
        class="inquiry-form"
        action="https://api.web3forms.com/submit"
        method="POST"
      >
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="subject" value="New partnership inquiry from jentosy.org" />
        <input type="hidden" name="form_type" value="Partnership Inquiry" />
        <input type="hidden" name="redirect" value="https://jentosy.org/partner-with-us/thank-you/" />
        <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <label>
          Name
          <input type="text" name="name" required />
        </label>
        <label>
          Email
          <input type="email" name="email" required />
        </label>
        <label>
          Organization
          <input type="text" name="organization" />
        </label>
        <label>
          I'm interested as a
          <select name="audience" id="audience-select">
            {audiences.map((a) => <option value={a.slug}>{a.option}</option>)}
            <option value="other">Other</option>
          </select>
        </label>
        <label>
          Message
          <textarea name="message" rows="4" required></textarea>
        </label>
        <button type="submit" class="btn btn-rust" disabled={!accessKey}>
          {accessKey ? "Send Inquiry" : "Form not yet connected"}
        </button>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  // Pre-select "I'm interested as a" from either a ?audience= query param
  // (linked from Home's audience cards) or from clicking one of this
  // page's own "Start the conversation" links, so a visitor never has to
  // re-state the audience they already told us they were.
  const select = document.getElementById("audience-select") as HTMLSelectElement | null;

  const applyAudience = (slug: string | null) => {
    if (!select || !slug) return;
    const match = Array.from(select.options).find((o) => o.value === slug);
    if (match) select.value = slug;
  };

  applyAudience(new URLSearchParams(window.location.search).get("audience"));

  document.querySelectorAll<HTMLAnchorElement>(".audience-card-cta").forEach((link) => {
    link.addEventListener("click", () => {
      applyAudience(link.dataset.audience ?? null);
    });
  });
</script>

<style>
  .audience-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (max-width: 640px) {
    .audience-grid {
      grid-template-columns: 1fr;
    }
  }

  .narrow {
    max-width: 560px;
  }

  .inquiry-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .inquiry-form label {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: 13px;
    font-weight: 700;
    color: var(--fg-soft);
  }

  .inquiry-form input,
  .inquiry-form select,
  .inquiry-form textarea {
    font: inherit;
    font-size: 14.5px;
    padding: 10px 12px;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--card);
    color: var(--fg);
    font-weight: 400;
  }

  .inquiry-form input:focus,
  .inquiry-form select:focus,
  .inquiry-form textarea:focus {
    outline: 2px solid var(--steel);
    outline-offset: 1px;
    border-color: var(--steel);
  }

  .inquiry-form button {
    align-self: flex-start;
    margin-top: var(--space-2);
  }

  .inquiry-form button:disabled {
    background: transparent;
    color: var(--fg-muted);
    border: 1.5px dashed var(--line-strong);
    cursor: not-allowed;
  }

  .inquiry-form button:disabled:hover {
    opacity: 1;
  }

  .audience-card {
    display: flex;
    flex-direction: column;
    scroll-margin-top: 88px;
  }

  .audience-card-cta {
    display: inline-block;
    margin-top: var(--space-3);
    font-weight: 700;
  }

  .form-unconfigured-note {
    font-size: 13px;
    color: var(--fg-muted);
    background: var(--card);
    border: 1.5px dashed var(--line-strong);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-5);
  }

  /* Web3Forms honeypot — invisible to people, catches bots that fill every
     field. Positioned off-screen rather than display:none, which some spam
     bots are smart enough to skip. */
  .botcheck {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
</style>
