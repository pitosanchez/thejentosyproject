---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";

const audiences = [
  {
    slug: "funder",
    name: "Funders & Foundations",
    pitch:
      "Support kidney-health education in underserved communities, led by lived experience.",
    option: "Funder / Foundation",
  },
  {
    slug: "researcher",
    name: "Researchers & Research Institutions",
    pitch:
      "Partner on education, awareness, and community engagement around FSGS and APOL1-mediated kidney disease.",
    option: "Researcher / Research Institution",
  },
  {
    slug: "healthcare",
    name: "Healthcare Organizations",
    pitch:
      "Collaborate on reaching underserved patients earlier — before diseases like FSGS progress to dialysis or transplant.",
    option: "Healthcare Organization",
  },
  {
    slug: "policymaker",
    name: "Policymakers",
    pitch:
      "Work with us on the upstream drivers of kidney disease disparities — from healthcare access to housing and education.",
    option: "Policymaker",
  },
];

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;
---

<BaseLayout
  title="Partner With Us"
  description="Partner with The Jentosy Project — funders, researchers, healthcare organizations, and policymakers working to close the kidney-care gap."
>
  <PageHero
    eyebrow="Partner With Us"
    heading="Institutional partnerships,"
    accent="one shared goal."
    lede="Funders, researchers, health systems, and policymakers each have a part in making kidney care that doesn't depend on zip code."
  />


  <section class="on-light partner-section">
    <div class="container partner-grid">
      <aside class="partner-aside">
        <p class="eyebrow reveal">Four ways to partner</p>
        <ol class="partner-list">
          {audiences.map((a, i) => (
            <li id={a.slug} class="reveal" style={`--reveal-delay:${i * 0.06}s`}>
              <span class="partner-n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h2 class="partner-name">{a.name}</h2>
                <p class="partner-pitch">{a.pitch}</p>
                <a href="#start" class="partner-cta audience-card-cta" data-audience={a.slug}>Start the conversation &rarr;</a>
              </div>
            </li>
          ))}
        </ol>
      </aside>
      <div id="start" class="partner-form">
      <h2 class="h2">Start <span class="hl">the conversation</span></h2>
      <p>Tell us a bit about your organization and how you'd like to partner.</p>

      {!accessKey && (
        <p class="form-unconfigured-note">
          This form isn't connected yet — set <code>PUBLIC_WEB3FORMS_ACCESS_KEY</code> to enable it.
        </p>
      )}

      <form
        class="inquiry-form"
        action="https://api.web3forms.com/submit"
        method="POST"
      >
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="subject" value="New partnership inquiry from jentosy.org" />
        <input type="hidden" name="form_type" value="Partnership Inquiry" />
        <input type="hidden" name="redirect" value="https://jentosy.org/partner-with-us/thank-you/" />
        <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <label>
          Name
          <input type="text" name="name" required />
        </label>
        <label>
          Email
          <input type="email" name="email" required />
        </label>
        <label>
          Organization
          <input type="text" name="organization" />
        </label>
        <label>
          I'm interested as a
          <select name="audience" id="audience-select">
            {audiences.map((a) => <option value={a.slug}>{a.option}</option>)}
            <option value="other">Other</option>
          </select>
        </label>
        <label>
          Message
          <textarea name="message" rows="4" required></textarea>
        </label>
        <button type="submit" class="btn btn-rust" disabled={!accessKey}>
          {accessKey ? "Send Inquiry" : "Form not yet connected"}
        </button>
      </form>

      <NewsletterSignup
        formId="partner-newsletter-form"
        heading="Not ready to start a conversation yet? Stay in the loop instead."
      />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Pre-select "I'm interested as a" from either a ?audience= query param
  // (linked from Home's audience cards) or from clicking one of this
  // page's own "Start the conversation" links, so a visitor never has to
  // re-state the audience they already told us they were.
  const select = document.getElementById("audience-select") as HTMLSelectElement | null;

  const applyAudience = (slug: string | null) => {
    if (!select || !slug) return;
    const match = Array.from(select.options).find((o) => o.value === slug);
    if (match) select.value = slug;
  };

  applyAudience(new URLSearchParams(window.location.search).get("audience"));

  document.querySelectorAll<HTMLAnchorElement>(".audience-card-cta").forEach((link) => {
    link.addEventListener("click", () => {
      applyAudience(link.dataset.audience ?? null);
    });
  });
</script>

<style>
  .audience-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (max-width: 640px) {
    .audience-grid {
      grid-template-columns: 1fr;
    }
  }

  .narrow {
    max-width: 560px;
  }

  .inquiry-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .inquiry-form label {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: 13px;
    font-weight: 700;
    color: var(--fg-soft);
  }

  .inquiry-form input,
  .inquiry-form select,
  .inquiry-form textarea {
    font: inherit;
    /* 16px, not smaller — iOS Safari auto-zooms the whole page on focus
       for any input under 16px, a real mobile annoyance, not a style
       preference. */
    font-size: 16px;
    padding: 10px 12px;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--card);
    color: var(--fg);
    font-weight: 400;
  }

  .inquiry-form input:focus,
  .inquiry-form select:focus,
  .inquiry-form textarea:focus {
    outline: 2px solid var(--steel);
    outline-offset: 1px;
    border-color: var(--steel);
  }

  .inquiry-form button {
    align-self: flex-start;
    margin-top: var(--space-2);
  }

  .inquiry-form button:disabled {
    background: transparent;
    color: var(--fg-muted);
    border: 1.5px dashed var(--line-strong);
    cursor: not-allowed;
  }

  .inquiry-form button:disabled:hover {
    opacity: 1;
  }

  .audience-card {
    display: flex;
    flex-direction: column;
    scroll-margin-top: 88px;
  }

  .audience-card-cta {
    display: inline-block;
    margin-top: var(--space-3);
    font-weight: 700;
  }

  .form-unconfigured-note {
    font-size: 13px;
    color: var(--fg-muted);
    background: var(--card);
    border: 1.5px dashed var(--line-strong);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-5);
  }

  /* Web3Forms honeypot — invisible to people, catches bots that fill every
     field. Positioned off-screen rather than display:none, which some spam
     bots are smart enough to skip. */
  .botcheck {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  /* ---------- Partner layout (2026-11-25 consistency pass) ---------- */
  .partner-section {
    padding-block: clamp(var(--space-8), 8vw, 128px);
  }

  .partner-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .partner-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .partner-list li {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: 120px;
  }

  .partner-list li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .partner-list li:target {
    background: linear-gradient(90deg, rgba(245, 192, 46, 0.14), transparent);
  }

  .partner-n {
    flex: none;
    width: 2.4em;
    padding-top: 8px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--rust);
  }

  .partner-name {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(21px, 2vw, 26px);
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-2);
  }

  .partner-pitch {
    color: var(--fg-soft);
    margin: 0 0 var(--space-3);
  }

  .partner-cta {
    font-weight: 700;
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }

  .partner-form {
    position: sticky;
    top: 110px;
    padding: clamp(var(--space-5), 3vw, var(--space-7));
    background: var(--sage);
    border-radius: var(--radius-md);
    border-top: 4px solid var(--gold);
    scroll-margin-top: 110px;
  }

  @media (max-width: 900px) {
    .partner-grid {
      grid-template-columns: 1fr;
    }

    .partner-form {
      position: static;
    }
  }
</style>
