---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import StatTile from "../../components/StatTile.astro";
import StackedBar from "../../components/charts/StackedBar.astro";
import HBarList from "../../components/charts/HBarList.astro";
import StageStepper from "../../components/StageStepper.astro";
import NumberedSteps from "../../components/NumberedSteps.astro";
import QuickNav from "../../components/QuickNav.astro";
import SupportResources from "../../components/SupportResources.astro";
import { viz } from "../../lib/palette";

// Categorical hues: fixed order by identity, validated CVD-safe
// (dataviz skill default palette, checked against --card #F7F5EF).
// Text never carries these colors — only fills/swatches do.
const raceColor: Record<string, string> = {
  Hispanic: "#2a78d6",
  "Non-Hispanic Black": "#eb6834",
  "Non-Hispanic White": "#1baf7a",
  "Asian/Pacific Islander": "#eda100",
  "Non-Hispanic Asian": "#eda100",
  "American Indian/Alaska Native": "#e87ba4",
  "Other/Multiracial or unlisted": "#4a3aa7",
};

const population = [
  { label: "Hispanic", value: 55.4 },
  { label: "Non-Hispanic Black", value: 29.6 },
  { label: "Non-Hispanic White", value: 8.9 },
  { label: "Asian/Pacific Islander", value: 4.7 },
  { label: "American Indian/Alaska Native", value: 0.3 },
  { label: "Other/Multiracial or unlisted", value: 1.1 },
];
let cum = 0;
const populationStops = population
  .map((d) => {
    const start = cum;
    cum += d.value;
    return `${raceColor[d.label]} ${start}% ${cum}%`;
  })
  .join(", ");

const diabetes = [
  { label: "Hispanic", value: 348.9 },
  { label: "Non-Hispanic Black", value: 336.0 },
  { label: "Asian/Pacific Islander", value: 184.2 },
  { label: "Non-Hispanic White", value: 170.6 },
];
const diabetesMax = Math.max(...diabetes.map((d) => d.value));

const ckd = [
  { label: "Non-Hispanic Black", value: 22.0 },
  { label: "Non-Hispanic Asian", value: 16.4 },
  { label: "Non-Hispanic White", value: 13.1 },
  { label: "Hispanic", value: 12.1 },
];
const ckdMax = 25;

const diseases = [
  {
    slug: "fsgs",
    name: "FSGS",
    full: "Focal Segmental Glomerulosclerosis",
    blurb: "Scarring in the kidney's filtering units — the disease our founder lives with.",
  },
  {
    slug: "apol1",
    name: "APOL1-Mediated Kidney Disease",
    full: "APOL1 Gene Variants",
    blurb: "A genetic risk factor concentrated in Black and Brown communities.",
  },
];

const quickNavItems = [
  { label: "The Basics", href: "#basics" },
  { label: "Symptoms", href: "#symptoms" },
  { label: "Diagnosis", href: "#diagnosis" },
  { label: "Treatment", href: "#treatment" },
  { label: "Get Support", href: "#get-support" },
  { label: "The Data", href: "#the-data" },
];

// ---------- National "Understanding Kidney Disease" content ----------

const nationalOverview = [
  { value: "37M", label: "Americans are living with chronic kidney disease.", source: "CDC Chronic Kidney Disease Fact Sheet, March 2026." },
  { value: "87%", label: "of those with CKD don't know they have it yet.", source: "CDC Chronic Kidney Disease Fact Sheet, March 2026." },
  { value: "14%", label: "of all US adults are estimated to have CKD.", source: "CDC Chronic Kidney Disease Fact Sheet, March 2026." },
  { value: "131K", label: "new kidney-failure (ESKD) cases were diagnosed in 2023.", source: "CDC / USRDS Annual Data Report 2023." },
];

const disparity = [
  { label: "Non-Hispanic Black", value: 22, color: viz.orange, display: "22%" },
  { label: "Adults 65 and older", value: 34, color: viz.purple, display: "34%" },
  { label: "Non-Hispanic White", value: 13, color: viz.green, display: "13%" },
  { label: "Hispanic", value: 12, color: viz.blue, display: "12%" },
];

const eskdCauses = [
  { label: "Diabetes", value: 37, color: viz.orange },
  { label: "High blood pressure", value: 27, color: viz.blue },
  { label: "Glomerulonephritis", value: 14, color: viz.purple },
  { label: "Unknown", value: 7, color: viz.neutral },
  { label: "Other", value: 10, color: "#c3b696" },
  { label: "Cystic kidney disease", value: 5, color: viz.pink },
];

const eskdTreatment = [
  { label: "Dialysis", value: 67, color: viz.orange, note: "≈557,000 people, sessions 3×/week" },
  { label: "Transplant", value: 33, color: viz.green, note: "≈274,000 transplant recipients" },
];

const kidneyFunctions = [
  "Help control blood pressure",
  "Balance salt and minerals in your blood",
  "Help your body make red blood cells",
  "Keep your bones strong",
];

const diagnosisSteps = [
  { title: "High levels of waste in the blood", body: "A basic blood test (creatinine, eGFR) reveals how well your kidneys are filtering." },
  { title: "Protein in the urine", body: "Protein shouldn't normally pass into urine — its presence (proteinuria) is often the earliest sign." },
  { title: "Tiny amounts of blood in the urine", body: "Hematuria, sometimes invisible without a lab test, can point to kidney damage." },
];

const symptoms = [
  "Nausea and vomiting",
  "Loss of appetite",
  "Fatigue and weakness",
  "Sleep problems",
  "Decreased mental sharpness",
  "High blood pressure that's hard to manage",
  "Shortness of breath (if fluid builds up in the lungs)",
];

const treatmentHabits = [
  "Take your medications as prescribed",
  "Monitor your blood pressure regularly",
  "Get regular kidney function tests",
  "Follow dietary recommendations",
  "Work closely with your healthcare team",
];

const riskFactors = [
  "Long-standing high blood pressure",
  "Diabetes",
  "Autoimmune diseases such as lupus",
  "Family history of kidney disease",
  "APOL1 genetic variations",
];
---

<BaseLayout
  title="The Need"
  description="Kidney disease disparities are downstream of poverty, education access, incarceration, and chronic stress. Learn about FSGS and APOL1-mediated kidney disease."
>
  <PageHero
    eyebrow="The Need"
    heading="Rare kidney disease, plainly explained."
    lede="Kidney disease disparities are downstream of poverty, unequal access to education, incarceration, broken homes, and the chronic stress those conditions produce."
  />

  <!-- Lets someone who already knows what they're looking for skip the
       ~15-screen scroll instead of paging past everything to find it. -->
  <section class="on-light quick-nav-section">
    <div class="container">
      <QuickNav items={quickNavItems} />
    </div>
  </section>

  <section class="on-light section">
    <div class="container narrow">
      <p>
        These conditions take a measurable toll on the body, including the kidneys. The Jentosy
        Project treats health equity as inseparable from these upstream social conditions, not
        just a matter of medical access — which is why our education work starts with two
        specific, under-discussed diseases.
      </p>
    </div>

    <div class="container">
      <div class="grid disease-grid">
        {diseases.map((d, i) => (
          <a href={`/the-need/${d.slug}/`} class="disease-card reveal" style={`--reveal-delay:${i * 0.1}s`} data-tilt-card>
            <div class="disease-card-inner" data-tilt-inner>
              <span class="disease-card-mark" aria-hidden="true">{d.name.slice(0, 1)}</span>
              <div class="disease-card-content">
                <p class="disease-full">{d.full}</p>
                <h2 class="h3">{d.name}</h2>
                <p>{d.blurb}</p>
                <span class="read-more">Read more &rarr;</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ WHAT IS KIDNEY DISEASE ============
       Orientation comes before statistics: someone landing here to
       understand their own diagnosis shouldn't have to read the
       population-level equity case first. The "Understanding Kidney
       Disease" / disparity / cause-treatment sections that used to open
       the page now come after "The Bottom Line," as the evidence behind
       the mission — not as the first thing a scared reader hits. -->

  <section id="basics" class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container narrow">
      <p class="eyebrow">What Is Kidney Disease?</p>
      <h2 class="h3">A filtration system, damaged over time.</h2>
      <p>
        Chronic kidney disease (CKD) happens when the kidneys are damaged for more than a few
        months. Think of your kidneys as your body's filtration system — they clean the blood by
        removing waste and extra fluid, which then leaves the body as urine.
      </p>
      <p>But kidneys do much more than just filter waste. They also:</p>
      <ul class="check-list">
        {kidneyFunctions.map((f) => <li>{f}</li>)}
      </ul>
      <p>
        When kidneys are damaged, they can't do these jobs properly. Waste and fluid build up in
        your body, which can cause serious health problems.
      </p>

      <div class="card card-steel" style="margin-top:var(--space-5);">
        <p class="eyebrow" style="margin-bottom:8px;">Important</p>
        <p style="margin:0;">
          In the early stages of kidney disease, you might not feel sick or have any symptoms.
          You might not know that you have kidney disease until the condition is advanced. This
          is why regular check-ups matter, especially if you have risk factors like high blood
          pressure or diabetes.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ FIVE STAGES ============ -->

  <section id="stages" class="on-light section-tight" style="border-top:1px solid var(--line);" data-stage-section>
    <div class="container">
      <p class="eyebrow">The Five Stages of Kidney Disease</p>
      <h2 class="h2">From normal function to failure.</h2>
      <p class="section-dek">
        Your healthcare team determines your stage using a blood test called the estimated
        glomerular filtration rate (eGFR) — it measures how much blood your kidneys filter each
        minute. A low eGFR number means your kidneys are working less well.
      </p>

      <StageStepper />

      <p style="margin-top:var(--space-5); max-width:var(--reading-max);">
        When the kidneys no longer work at the level needed to keep a person alive, it's called
        end-stage kidney disease (ESKD) — an eGFR under 15. At this point, a person needs either a
        kidney transplant or dialysis, a treatment that does the job of the kidneys.
      </p>
    </div>
  </section>

  <!-- ============ DIAGNOSIS ============ -->

  <section id="diagnosis" class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container narrow">
      <p class="eyebrow">How Do Doctors Find Kidney Disease?</p>
      <h2 class="h3">Blood and urine tests, first.</h2>
      <p>Healthcare professionals can find kidney disease through blood and urine tests. These tests look for:</p>
      <NumberedSteps steps={diagnosisSteps} />
      <p style="margin-top:var(--space-5);">Doctors might also use imaging tests like:</p>
      <ul class="check-list">
        <li><strong>Ultrasound</strong> — creates pictures of your kidneys using sound waves.</li>
        <li><strong>CT scans</strong> — take detailed X-ray images to look at the kidneys in detail.</li>
      </ul>
    </div>
  </section>

  <!-- ============ SYMPTOMS ============ -->

  <section id="symptoms" class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container narrow">
      <p class="eyebrow">Symptoms of Kidney Disease</p>
      <h2 class="h3">Symptoms develop slowly — often too slowly to notice.</h2>
      <p>
        Chronic kidney disease symptoms tend to develop slowly over time. In the early stages,
        you might not notice anything at all. This is why many people don't realize they have
        kidney disease until it's advanced.
      </p>
      <p>
        <strong>Why symptoms develop:</strong> loss of kidney function causes a buildup of fluid
        or waste in your body. It also can cause acids, potassium, and phosphate to build up in
        the blood — all of which can cause symptoms.
      </p>
      <div class="grid" style="grid-template-columns:repeat(2,1fr); gap:var(--space-2) var(--space-5); margin-top:var(--space-5);">
        {symptoms.map((s) => <p class="symptom-item">{s}</p>)}
      </div>
    </div>
  </section>

  <!-- ============ TREATMENT ============ -->

  <section id="treatment" class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container narrow">
      <p class="eyebrow">Treatment for Kidney Disease</p>
      <h2 class="h3">Slowing the damage, not just managing symptoms.</h2>
      <p>
        The goal of treatment is to slow down damage to the kidneys. This is often done by
        managing the underlying cause of the damage — for example, controlling blood pressure or
        managing diabetes.
      </p>
      <p>
        However, even after a cause has been found and treated, kidney damage could still get
        worse. This is why it's important to:
      </p>
      <ul class="check-list">
        {treatmentHabits.map((t) => <li>{t}</li>)}
      </ul>

      <div class="card card-rust" style="margin-top:var(--space-6);">
        <p class="eyebrow" style="margin-bottom:8px;">If kidney disease progresses to end-stage</p>
        <p style="margin:0;">
          Chronic kidney disease can progress to end-stage kidney failure. This is fatal unless a
          person gets a kidney transplant or starts dialysis — a treatment that does the job of
          the kidneys. Of the 831,000 Americans currently living with ESKD, 67% are on dialysis
          and 33% have a transplant.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ WHEN TO SEE A DOCTOR ============ -->

  <section class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container narrow">
      <p class="eyebrow">When to See a Doctor</p>
      <h2 class="h3">Risk factors your doctor should know about.</h2>
      <p>
        If you have an ongoing health condition that raises your risk of kidney disease, your
        main healthcare professional may want to monitor the health of your kidneys. Risk factors
        include:
      </p>
      <ul class="check-list">
        {riskFactors.map((r) => <li>{r}</li>)}
      </ul>
      <p>
        You may see your main healthcare professional every 6 to 12 months for these tests. If
        test results show possible kidney problems, you may be referred to a nephrologist — a
        doctor who specializes in kidney diseases.
      </p>
    </div>
  </section>

  <!-- ============ TYPES ============ -->

  <section class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container narrow">
      <p class="eyebrow">Different Types of Kidney Disease</p>
      <h2 class="h3">The type you have shapes how it's treated.</h2>
      <p>
        Chronic kidney disease can result from many different causes. Two are the focus of our
        education work — read more on their dedicated pages above. Other types include diabetic
        kidney disease, lupus nephritis, polycystic kidney disease, and kidney disease caused by
        high blood pressure. Your doctor can explain which type you have and what it means for
        your treatment.
      </p>
    </div>
  </section>

  <!-- ============ BOTTOM LINE ============
       Closes the "what does this mean for me" arc before the page turns
       to the population-level evidence below. -->

  <section class="on-dark section-tight" style="border-top:1px solid var(--ink-line);">
    <div class="container narrow">
      <p class="eyebrow">The Bottom Line</p>
      <p class="lede reveal" style="max-width:64ch;">
        Kidney disease often has no symptoms in early stages, making regular check-ups essential
        if you have risk factors. The good news is that treatment can slow disease progression,
        especially when started early. Work with your healthcare team to monitor your kidney
        health and manage any underlying conditions.
      </p>
      <p class="disclaimer-dark">
        This page provides general, credibility-level education — not medical advice. Talk to
        your doctor about your own risk and testing schedule.
      </p>
    </div>
  </section>

  <!-- ============ GET SUPPORT ============ -->

  <section id="get-support" class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container narrow">
      <SupportResources />
    </div>
  </section>

  <!-- ============ UNDERSTANDING KIDNEY DISEASE — national primer ============
       The evidence behind the mission: who this affects, and how unequally
       — the case for why The Jentosy Project exists, for a reader who's
       past the "what does this mean for me" question above. -->

  <section id="the-data" class="on-dark section-tight" style="border-top:1px solid var(--ink-line);">
    <div class="container">
      <p class="eyebrow">Understanding Kidney Disease</p>
      <h2 class="h2 reveal">37 million Americans.</h2>
      <p class="lede reveal" style="--reveal-delay:0.08s; max-width:60ch;">
        Chronic kidney disease affects roughly 1 in 7 US adults — and most of them don't know it
        yet. That gap between how common CKD is and how invisible it feels is exactly why this
        organization exists.
      </p>

      <div class="grid stat-grid-4" style="margin-top:var(--space-6);">
        {nationalOverview.map((s, i) => (
          <div class="reveal" style={`--reveal-delay:${0.12 + i * 0.06}s`}>
            <StatTile value={s.value} label={s.label} source={s.source} accent="#e7dfc8" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container">
      <p class="eyebrow">CKD Prevalence by Race &amp; Ethnicity</p>
      <h2 class="h2">This disease does not strike equally.</h2>
      <p class="section-dek">
        These are not random numbers. They reflect decades of unequal access to care, housing,
        food, and economic stability — not genetic destiny.
      </p>

      <div class="viz-grid" style="align-items:start;">
        <div class="card viz-card card-rust">
          <p class="stat-value-inline">4&times;</p>
          <h3 class="viz-title">Higher rate of kidney failure</h3>
          <p>
            Non-Hispanic Black adults develop end-stage kidney disease at 4&times; the rate of
            non-Hispanic White adults. Hispanic adults develop ESKD at 2&times; the rate.
          </p>
          <p class="viz-source">CDC, March 2026 &middot; USRDS Annual Data Report 2023.</p>
        </div>

        <div class="card viz-card">
          <h3 class="viz-title">CKD prevalence among US adults</h3>
          <p class="viz-note">By race/ethnicity and age group — bar length proportional to prevalence rate.</p>
          <HBarList data={disparity} max={40} suffix="%" />
          <p class="viz-source">CDC Chronic Kidney Disease Fact Sheet, March 2026.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container">
      <p class="eyebrow">End-Stage Kidney Disease &middot; 2023</p>
      <h2 class="h2">831,000 Americans are living with kidney failure.</h2>

      <div class="viz-grid" style="margin-top:var(--space-5);">
        <div class="card viz-card">
          <h3 class="viz-title">What causes kidney failure</h3>
          <p class="viz-note">Among 131,564 new ESKD cases in 2023.</p>
          <StackedBar data={eskdCauses} suffix="%" />
          <p class="viz-source">USRDS / CDC 2026.</p>
        </div>

        <div class="card viz-card">
          <h3 class="viz-title">How patients are treated</h3>
          <p class="viz-note">67% depend on dialysis to survive — of the total prevalent ESKD population.</p>
          <StackedBar data={eskdTreatment} suffix="%" />
          <p class="viz-source">Total prevalent ESKD population, 2023 &middot; USRDS / CDC 2026.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ LOCAL & NATIONAL CONTEXT (Bronx) ============ -->

  <section class="on-light section-tight viz-root" style="border-top:1px solid var(--line);">
    <div class="container">
      <p class="eyebrow">Local &amp; National Context</p>
      <h2 class="h2">The Bronx, by the numbers.</h2>
      <p class="section-dek">
        Bronx-specific data where it exists; clearly labeled national estimates where it
        doesn't — because the size of that gap is itself part of the health-equity story.
      </p>

      <div class="viz-grid">
        <div class="card viz-card">
          <h3 class="viz-title">Who lives in the Bronx?</h3>
          <div class="donut-row">
            <div class="donut" style={`background: conic-gradient(${populationStops})`}>
              <div class="donut-hole"></div>
            </div>
            <ul class="legend">
              {population.map((d) => (
                <li>
                  <span class="swatch" style={`background:${raceColor[d.label]}`}></span>
                  <span class="legend-label">{d.label}</span>
                  <span class="legend-value">{d.value}%</span>
                </li>
              ))}
            </ul>
          </div>
          <p class="viz-source">New York State Department of Health, Bronx County Health Indicators by Race and Ethnicity (2024 population).</p>
        </div>

        <div class="card viz-card">
          <h3 class="viz-title">A major kidney-risk disparity in the Bronx</h3>
          <p class="viz-note">Diabetes hospitalizations, age-adjusted rate per 10,000 — a leading cause of chronic kidney disease.</p>
          <div class="bar-row">
            {diabetes.map((d, i) => (
              <div class="bar-col">
                <span class="bar-value">{d.value}</span>
                <div class="bar-track">
                  <div
                    class="bar-fill"
                    style={`height:${(d.value / diabetesMax) * 100}%; background:${raceColor[d.label]}; --reveal-delay:${i * 0.08}s`}
                  ></div>
                </div>
                <span class="bar-label">{d.label}</span>
              </div>
            ))}
          </div>
          <p class="viz-source">New York State Department of Health, Bronx County Health Indicators by Race and Ethnicity (2022–2024 any-diagnosis diabetes hospitalizations).</p>
        </div>
      </div>

      <div class="viz-grid" style="margin-top:var(--space-5);">
        <div class="card viz-card">
          <h3 class="viz-title">Chronic kidney disease is not distributed equally</h3>
          <p class="viz-note">National CKD prevalence estimates — comparable Bronx-specific data by race isn't publicly available.</p>
          <div class="dot-plot">
            {ckd.map((d) => (
              <div class="dot-row">
                <span class="dot-label">{d.label}</span>
                <div class="dot-track">
                  <div class="dot-marker" style={`left:${(d.value / ckdMax) * 100}%; background:${raceColor[d.label]}`}></div>
                </div>
                <span class="dot-value">{d.value}%</span>
              </div>
            ))}
          </div>
          <p class="viz-source">NIDDK Kidney Disease Statistics for the United States, citing CDC/NHANES estimates (Aug 2021–Aug 2023).</p>
        </div>

        <StatTile
          value="87%"
          label="of U.S. adults with chronic kidney disease may be unaware they have it — the clearest argument for why education can't wait."
          source="NIDDK Kidney Disease Statistics for the United States, citing CDC."
          accent="#2a78d6"
        />
      </div>

      <div class="card card-rust gap-card">
        <p class="eyebrow" style="margin-bottom:8px;">An honest gap, not a finding</p>
        <h3 class="viz-title">What about Hispanic communities, APOL1, and FSGS?</h3>
        <p>
          There is no reliable Bronx-specific prevalence estimate for APOL1-mediated kidney
          disease or FSGS among Hispanic residents. APOL1 risk is tied to recent African
          ancestry, which means it can also be relevant for some Hispanic and Afro-Latino
          communities, especially those with Caribbean ancestry — but the local data needed to
          show that clearly doesn't exist yet. That absence is itself part of the health-equity
          problem The Jentosy Project exists to address.
        </p>
        <p class="viz-source">Evidence-gap note based on NIDDK APOL1 educational materials and the absence of a verified Bronx-specific public estimate.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 700px;
  }

  .quick-nav-section {
    padding-block: var(--space-3) 0;
  }

  #basics,
  #stages,
  #diagnosis,
  #symptoms,
  #treatment,
  #get-support,
  #the-data {
    scroll-margin-top: 88px;
  }

  .disease-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    margin: var(--space-4) auto 0;
    max-width: 700px;
  }

  @media (max-width: 640px) {
    .disease-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- 3D tilt cards ---------- */

  .disease-card {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    perspective: 1200px;
    outline: none;
  }

  .disease-card::after {
    content: "";
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: -14px;
    height: 22px;
    background: radial-gradient(ellipse at center, rgba(38, 42, 33, 0.3), rgba(38, 42, 33, 0) 72%);
    filter: blur(6px);
    z-index: -1;
    transition: opacity var(--dur-med) var(--ease), transform var(--dur-med) var(--ease);
  }

  .disease-card:hover::after,
  .disease-card:focus-visible::after {
    opacity: 0.85;
    transform: translateY(6px) scale(1.06);
  }

  .disease-card-inner {
    position: relative;
    height: 100%;
    background: var(--card);
    border: 1.5px solid var(--line);
    border-top: 3px solid var(--steel);
    border-radius: var(--radius-sm);
    padding: var(--space-6) var(--space-5);
    overflow: hidden;
    transform-style: preserve-3d;
    box-shadow: 0 10px 22px rgba(38, 42, 33, 0.14);
    transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-med) var(--ease), border-top-color var(--dur-med) var(--ease);
  }

  .disease-card:hover .disease-card-inner,
  .disease-card:focus-visible .disease-card-inner {
    border-top-color: var(--rust);
    box-shadow: 0 26px 44px rgba(38, 42, 33, 0.22);
  }

  .disease-card:focus-visible .disease-card-inner {
    transform: translateY(-4px);
  }

  .disease-card-mark {
    position: absolute;
    top: var(--space-3);
    right: var(--space-4);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 72px;
    line-height: 1;
    color: var(--line-strong);
    opacity: 0.55;
    transform: translateZ(14px);
