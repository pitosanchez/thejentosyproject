---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import StageStepper from "../../components/StageStepper.astro";
import NumberedSteps from "../../components/NumberedSteps.astro";
import QuickNav from "../../components/QuickNav.astro";
import SupportResources from "../../components/SupportResources.astro";

const diseases = [
  {
    slug: "fsgs",
    name: "FSGS",
    full: "Focal Segmental Glomerulosclerosis",
    blurb: "Scarring in the kidney's filtering units — the disease our founder lives with.",
  },
  {
    slug: "apol1",
    name: "APOL1-Mediated Kidney Disease",
    full: "APOL1 Gene Variants",
    blurb: "A genetic risk factor concentrated in Black and Brown communities.",
  },
];

const quickNavItems = [
  { label: "The Basics", href: "#basics" },
  { label: "Symptoms", href: "#symptoms" },
  { label: "Diagnosis", href: "#diagnosis" },
  { label: "Treatment", href: "#treatment" },
  { label: "Get Support", href: "#get-support" },
  { label: "Bronx Data", href: "/the-need/data/" },
];

const kidneyFunctions = [
  "Help control blood pressure",
  "Balance salt and minerals in your blood",
  "Help your body make red blood cells",
  "Keep your bones strong",
];

const diagnosisSteps = [
  { title: "High levels of waste in the blood", body: "A basic blood test (creatinine, eGFR) reveals how well your kidneys are filtering." },
  { title: "Protein in the urine", body: "Protein shouldn't normally pass into urine — its presence (proteinuria) is often the earliest sign." },
  { title: "Tiny amounts of blood in the urine", body: "Hematuria, sometimes invisible without a lab test, can point to kidney damage." },
];

const symptoms = [
  "Nausea and vomiting",
  "Loss of appetite",
  "Fatigue and weakness",
  "Sleep problems",
  "Decreased mental sharpness",
  "High blood pressure that's hard to manage",
  "Shortness of breath (if fluid builds up in the lungs)",
];

const treatmentHabits = [
  "Take your medications as prescribed",
  "Monitor your blood pressure regularly",
  "Get regular kidney function tests",
  "Follow dietary recommendations",
  "Work closely with your healthcare team",
];

const riskFactors = [
  "Long-standing high blood pressure",
  "Diabetes",
  "Autoimmune diseases such as lupus",
  "Family history of kidney disease",
  "APOL1 genetic variations",
];
---

<BaseLayout
  title="Understanding Kidney Disease"
  description="Kidney disease disparities are downstream of poverty, education access, incarceration, and chronic stress. Learn about FSGS and APOL1-mediated kidney disease."
>
  <PageHero
    eyebrow="Understanding Kidney Disease"
    heading="Rare kidney disease, plainly explained."
    lede="Kidney disease disparities are downstream of poverty, unequal access to education, incarceration, broken homes, and the chronic stress those conditions produce."
    motif
  />

  <!-- Lets someone who already knows what they're looking for skip the
       ~15-screen scroll instead of paging past everything to find it. -->
  <section class="on-light quick-nav-section">
    <div class="container">
      <QuickNav items={quickNavItems} />
    </div>
  </section>

  <section class="on-light section">
    <div class="container narrow">
      <p>
        These conditions take a measurable toll on the body, including the kidneys. The Jentosy
        Project treats health equity as inseparable from these upstream social conditions, not
        just a matter of medical access — which is why our education work starts with two
        specific, under-discussed diseases.
      </p>
    </div>

    <div class="container">
      <div class="grid disease-grid">
        {diseases.map((d, i) => (
          <a href={`/the-need/${d.slug}/`} class="disease-card reveal" style={`--reveal-delay:${i * 0.1}s`} data-tilt-card>
            <div class="disease-card-inner" data-tilt-inner>
              <span class="disease-card-mark" aria-hidden="true">{d.name.slice(0, 1)}</span>
              <div class="disease-card-content">
                <p class="disease-full">{d.full}</p>
                <h2 class="h3">{d.name}</h2>
                <p>{d.blurb}</p>
                <span class="read-more">Read more &rarr;</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ WHAT IS KIDNEY DISEASE ============
       Orientation comes before statistics: someone landing here to
       understand their own diagnosis shouldn't have to read the
       population-level equity case first. The "Understanding Kidney
       Disease" / disparity / cause-treatment sections that used to open
       the page now come after "The Bottom Line," as the evidence behind
       the mission — not as the first thing a scared reader hits. -->

  <section id="basics" class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container narrow">
      <p class="eyebrow">What Is Kidney Disease?</p>
      <h2 class="h3">A filtration system, damaged over time.</h2>
      <p>
        Chronic kidney disease (CKD) happens when the kidneys are damaged for more than a few
        months. Think of your kidneys as your body's filtration system — they clean the blood by
        removing waste and extra fluid, which then leaves the body as urine.
      </p>
      <p>But kidneys do much more than just filter waste. They also:</p>
      <ul class="check-list">
        {kidneyFunctions.map((f) => <li>{f}</li>)}
      </ul>
      <p>
        When kidneys are damaged, they can't do these jobs properly. Waste and fluid build up in
        your body, which can cause serious health problems.
      </p>

      <div class="card card-steel" style="margin-top:var(--space-5);">
        <p class="eyebrow" style="margin-bottom:8px;">Important</p>
        <p style="margin:0;">
          In the early stages of kidney disease, you might not feel sick or have any symptoms.
          You might not know that you have kidney disease until the condition is advanced. This
          is why regular check-ups matter, especially if you have risk factors like high blood
          pressure or diabetes.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ FIVE STAGES ============ -->

  <section id="stages" class="on-light section-tight" style="border-top:1px solid var(--line);" data-stage-section>
    <div class="container">
      <p class="eyebrow">The Five Stages of Kidney Disease</p>
      <h2 class="h2">From normal function to failure.</h2>
      <p class="section-dek">
        Your healthcare team determines your stage using a blood test called the estimated
        glomerular filtration rate (eGFR) — it measures how much blood your kidneys filter each
        minute. A low eGFR number means your kidneys are working less well.
      </p>

      <StageStepper />

      <p style="margin-top:var(--space-5); max-width:var(--reading-max);">
        When the kidneys no longer work at the level needed to keep a person alive, it's called
        end-stage kidney disease (ESKD) — an eGFR under 15. At this point, a person needs either a
        kidney transplant or dialysis, a treatment that does the job of the kidneys.
      </p>
    </div>
  </section>

  <!-- ============ DIAGNOSIS ============ -->

  <section id="diagnosis" class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container narrow">
      <p class="eyebrow">How Do Doctors Find Kidney Disease?</p>
      <h2 class="h3">Blood and urine tests, first.</h2>
      <p>Healthcare professionals can find kidney disease through blood and urine tests. These tests look for:</p>
      <NumberedSteps steps={diagnosisSteps} />
      <p style="margin-top:var(--space-5);">Doctors might also use imaging tests like:</p>
      <ul class="check-list">
        <li><strong>Ultrasound</strong> — creates pictures of your kidneys using sound waves.</li>
        <li><strong>CT scans</strong> — take detailed X-ray images to look at the kidneys in detail.</li>
      </ul>
    </div>
  </section>

  <!-- ============ SYMPTOMS ============ -->

  <section id="symptoms" class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container narrow">
      <p class="eyebrow">Symptoms of Kidney Disease</p>
      <h2 class="h3">Symptoms develop slowly — often too slowly to notice.</h2>
      <p>
        Chronic kidney disease symptoms tend to develop slowly over time. In the early stages,
        you might not notice anything at all. This is why many people don't realize they have
        kidney disease until it's advanced.
      </p>
      <p>
        <strong>Why symptoms develop:</strong> loss of kidney function causes a buildup of fluid
        or waste in your body. It also can cause acids, potassium, and phosphate to build up in
        the blood — all of which can cause symptoms.
      </p>
      <div class="grid grid-2-col" style="gap:var(--space-2) var(--space-5); margin-top:var(--space-5);">
        {symptoms.map((s) => <p class="symptom-item">{s}</p>)}
      </div>
    </div>
  </section>

  <!-- ============ TREATMENT ============ -->

  <section id="treatment" class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container narrow">
      <p class="eyebrow">Treatment for Kidney Disease</p>
      <h2 class="h3">Slowing the damage, not just managing symptoms.</h2>
      <p>
        The goal of treatment is to slow down damage to the kidneys. This is often done by
        managing the underlying cause of the damage — for example, controlling blood pressure or
        managing diabetes.
      </p>
      <p>
        However, even after a cause has been found and treated, kidney damage could still get
        worse. This is why it's important to:
      </p>
      <ul class="check-list">
        {treatmentHabits.map((t) => <li>{t}</li>)}
      </ul>

      <div class="card card-rust" style="margin-top:var(--space-6);">
        <p class="eyebrow" style="margin-bottom:8px;">If kidney disease progresses to end-stage</p>
        <p style="margin:0;">
          Chronic kidney disease can progress to end-stage kidney failure. This is fatal unless a
          person gets a kidney transplant or starts dialysis — a treatment that does the job of
          the kidneys. Of the 831,000 Americans currently living with ESKD, 67% are on dialysis
          and 33% have a transplant.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ WHEN TO SEE A DOCTOR ============ -->

  <section class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container narrow">
      <p class="eyebrow">When to See a Doctor</p>
      <h2 class="h3">Risk factors your doctor should know about.</h2>
      <p>
        If you have an ongoing health condition that raises your risk of kidney disease, your
        main healthcare professional may want to monitor the health of your kidneys. Risk factors
        include:
      </p>
      <ul class="check-list">
        {riskFactors.map((r) => <li>{r}</li>)}
      </ul>
      <p>
        You may see your main healthcare professional every 6 to 12 months for these tests. If
        test results show possible kidney problems, you may be referred to a nephrologist — a
        doctor who specializes in kidney diseases.
      </p>
    </div>
  </section>

  <!-- ============ TYPES ============ -->

  <section class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container narrow">
      <p class="eyebrow">Different Types of Kidney Disease</p>
      <h2 class="h3">The type you have shapes how it's treated.</h2>
      <p>
        Chronic kidney disease can result from many different causes. Two are the focus of our
        education work — read more on their dedicated pages above. Other types include diabetic
        kidney disease, lupus nephritis, polycystic kidney disease, and kidney disease caused by
        high blood pressure. Your doctor can explain which type you have and what it means for
        your treatment.
      </p>
    </div>
  </section>

  <!-- ============ BOTTOM LINE ============
       Closes the "what does this mean for me" arc before the page turns
       to the population-level evidence below. -->

  <section class="on-dark section-tight" style="border-top:1px solid var(--ink-line);">
    <div class="container narrow">
      <p class="eyebrow">The Bottom Line</p>
      <p class="lede reveal" style="max-width:64ch;">
        Kidney disease often has no symptoms in early stages, making regular check-ups essential
        if you have risk factors. The good news is that treatment can slow disease progression,
        especially when started early. Work with your healthcare team to monitor your kidney
        health and manage any underlying conditions.
      </p>
      <p class="disclaimer-dark">
        This page provides general, credibility-level education — not medical advice — and has
        not yet completed a formal clinical-accuracy review. Talk to your doctor about your own
        risk, testing, and treatment.
      </p>
    </div>
  </section>

  <!-- ============ GET SUPPORT ============ -->

  <section id="get-support" class="on-light section-tight" style="border-top:1px solid var(--line);">
    <div class="container narrow">
      <SupportResources />
    </div>
  </section>

  <!-- ============ DATA TEASER ============
       The full national/Bronx equity-data case now lives on its own page
       (/the-need/data/) rather than appended to the bottom of an already
       long orientation page — this closes the loop with one headline
       stat pair and a clear link, instead of appending three more
       chart-heavy sections here. -->

  <section class="on-dark section-tight" style="border-top:1px solid var(--ink-line);">
    <div class="container">
      <p class="eyebrow">The Data Behind This</p>
      <h2 class="h2 reveal">The gap, quantified — nationally and in the Bronx.</h2>
      <p class="lede reveal" style="--reveal-delay:0.08s; max-width:60ch;">
        37 million Americans live with chronic kidney disease, and Black adults develop kidney
        failure at four times the rate of white adults — with an even sharper gap in the Bronx
        itself. The full national and Bronx-specific breakdown, including diabetes and CKD
        prevalence by race, lives on its own page.
      </p>
      <a href="/the-need/data/" class="btn btn-steel-outline" style="margin-top:var(--space-6);">See Bronx Data You Should Know &rarr;</a>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 700px;
  }

  .quick-nav-section {
    padding-block: var(--space-3) 0;
  }

  #basics,
  #stages,
  #diagnosis,
  #symptoms,
  #treatment,
  #get-support,
  #the-data {
    scroll-margin-top: 88px;
  }

  .disease-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    margin: var(--space-4) auto 0;
    max-width: 700px;
  }

  @media (max-width: 640px) {
    .disease-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- 3D tilt cards ---------- */

  .disease-card {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    perspective: 1200px;
    outline: none;
  }

  .disease-card::after {
    content: "";
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: -14px;
    height: 22px;
    background: radial-gradient(ellipse at center, rgba(38, 42, 33, 0.3), rgba(38, 42, 33, 0) 72%);
    filter: blur(6px);
    z-index: -1;
    transition: opacity var(--dur-med) var(--ease), transform var(--dur-med) var(--ease);
  }

  .disease-card:hover::after,
  .disease-card:focus-visible::after {
    opacity: 0.85;
    transform: translateY(6px) scale(1.06);
  }

  .disease-card-inner {
    position: relative;
    height: 100%;
    background: var(--card);
    border: 1.5px solid var(--line);
    border-top: 3px solid var(--steel);
    border-radius: var(--radius-sm);
    padding: var(--space-6) var(--space-5);
    overflow: hidden;
    transform-style: preserve-3d;
    box-shadow: 0 10px 22px rgba(38, 42, 33, 0.14);
    transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-med) var(--ease), border-top-color var(--dur-med) var(--ease);
  }

  .disease-card:hover .disease-card-inner,
  .disease-card:focus-visible .disease-card-inner {
    border-top-color: var(--rust);
    box-shadow: 0 26px 44px rgba(38, 42, 33, 0.22);
  }

  .disease-card:focus-visible .disease-card-inner {
    transform: translateY(-4px);
  }

  .disease-card-mark {
    position: absolute;
    top: var(--space-3);
    right: var(--space-4);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 72px;
    line-height: 1;
    color: var(--line-strong);
    opacity: 0.55;
    transform: translateZ(14px);
    pointer-events: none;
  }

  .disease-card-content {
    position: relative;
    transform: translateZ(34px);
  }

  .disease-full {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-muted);
    margin: 0 0 var(--space-2);
  }

  .read-more {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: 13px;
    font-weight: 700;
    color: var(--steel);
  }

  .symptom-item {
    margin: 0;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--line);
    font-size: 14.5px;
    color: var(--fg-soft);
    max-width: none;
  }

</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const stageSection = document.querySelector<HTMLElement>("[data-stage-section]");
  const stages = Array.from(document.querySelectorAll<HTMLElement>(".stage-stepper .stage"));

  // The five CKD stages animate in sequence as the reader scrolls past the
  // stepper — each stage "lights up" in turn, so the progression from
  // normal function to kidney failure is felt, not just read. Purely a
  // scroll-scrubbed opacity/scale ramp; layout never depends on it.
  if (stageSection && stages.length && !prefersReducedMotion) {
    // Scale + filter only — never opacity. If ScrollTrigger's scrub math
    // doesn't land exactly right (a stitched full-page screenshot capture,
    // a rare browser edge case), the stages must still read as fully
    // visible text, never stuck dim or blank — worst case a card is stuck
    // slightly small or slightly desaturated, never hidden.
    //
    // Each stage starts desaturated and un-scaled, then scales up to full
    // size *and* snaps into its real stage color in sequence — the color
    // arriving is the whole point of the animation, not just a static
    // label on an already-colored box.
    gsap.set(stages, { scale: 0.94, filter: "grayscale(1) saturate(0)" });
    const tl = gsap.timeline();
    stages.forEach((stage) => {
      tl.to(stage, { scale: 1, filter: "grayscale(0) saturate(1)", duration: 0.35, ease: "power1.out" }, "+=0.05");
    });

    ScrollTrigger.create({
      trigger: stageSection,
      start: "top 75%",
      end: "bottom 60%",
      scrub: 0.6,
      animation: tl,
    });
  }

  // FSGS/APOL1 cards tilt in 3D toward the pointer, with the disease-mark
  // letter and the text content sitting at different translateZ depths so
  // the tilt reads as real layered depth, not just a rotated flat card.
  const tiltCards = document.querySelectorAll<HTMLElement>("[data-tilt-card]");
  const maxTiltDeg = 9;

  if (!prefersReducedMotion) {
    tiltCards.forEach((card) => {
      const inner = card.querySelector<HTMLElement>("[data-tilt-inner]");
      if (!inner) return;

      const applyTilt = (clientX: number, clientY: number) => {
        const rect = card.getBoundingClientRect();
        const px = (clientX - rect.left) / rect.width - 0.5;
        const py = (clientY - rect.top) / rect.height - 0.5;
        inner.style.transform = `rotateX(${(-py * maxTiltDeg * 2).toFixed(2)}deg) rotateY(${(px * maxTiltDeg * 2).toFixed(2)}deg)`;
      };

      const resetTilt = () => {
        inner.style.transform = "rotateX(0deg) rotateY(0deg)";
      };

      card.addEventListener("pointermove", (e) => applyTilt(e.clientX, e.clientY));
      card.addEventListener("pointerleave", resetTilt);
      card.addEventListener("blur", resetTilt);
    });
  }
</script>
