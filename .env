# Committed on purpose — see .env.example for why. None of these values are
# secret: a Web3Forms access key is designed to be exposed client-side (its
# spam protection happens server-side), a GA4 Measurement ID and a Zeffy
# embed URL are always publicly visible once the page loads, and the
# contact email is meant to be public.

# Google Analytics 4 Measurement ID (e.g. G-ABC1234XYZ).
# Leave unset to keep GA4 out of the page entirely (no script tag at all).
PUBLIC_GA4_MEASUREMENT_ID=

# Web3Forms access key — from web3forms.com, shared by both the Contact
# and Partner With Us forms.
PUBLIC_WEB3FORMS_ACCESS_KEY=78f6b269-ac4e-4a1e-8d4c-3a79f3843f9f

# Real email address shown on /contact/ as a fallback if Web3Forms is ever
# unavailable, so the page never leaves a visitor with no way to reach a
# person.
PUBLIC_CONTACT_EMAIL=info@jentosy.org

# Full Zeffy embed URL for the donation form (e.g.
# https://www.zeffy.com/embed/donation-form/xxxxxxxx).
PUBLIC_ZEFFY_EMBED_URL=
